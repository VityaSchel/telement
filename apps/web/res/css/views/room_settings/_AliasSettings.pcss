/* Telement: a text button like Show advanced, in the accent and without an underline (_SettingsSubsection.pcss) */
.mx_AliasSettings_localAddresses {
    cursor: pointer;
    color: var(--cpd-color-text-action-accent);
    font-weight: var(--cpd-font-weight-semibold);
    text-decoration: none;
    list-style: none;
    width: fit-content;

    /* list-style doesn't do it for webkit */
    &::-webkit-details-marker {
        display: none;
    }
}

/* Telement: the publish toggle starts 12px under the main address field, measured on the toggle, which Compound
   centers on its label's line, 1.25px under the line's top, rather than 9px under it through the list's 8px gap */
.mx_SettingsFieldset_content > .mx_Field + .mx_RoomPublishSetting {
    margin-top: calc(
        var(--cpd-space-3x) - var(--cpd-space-2x) -
            (var(--cpd-font-size-body-md) * var(--cpd-font-line-height-regular) - var(--cpd-space-5x)) / 2
    );
}
