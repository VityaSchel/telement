.mx_PinnedMessagesCard {
    /* Telement: as tall as the composer beside it at its smallest, one line of text (--MessageComposer-oneLineHeight in
       _MessageComposer.pcss) under a 1px line */
    --unpin-height: calc(var(--cpd-border-width-1) + 2 * var(--cpd-space-4x) + $font-18px);

    position: relative;

    .mx_PinnedMessagesCard_wrapper {
        display: flex;
        flex-direction: column;
        /* The card's content edge, the card header's 12px inset */
        padding: var(--cpd-space-4x) var(--cpd-space-3x);
        gap: var(--cpd-space-6x);
        overflow-y: auto;

        .mx_PinnedMessagesCard_Separator {
            min-height: 1px;
            /* Override default compound value */
            margin-block: 0;
        }
    }

    .mx_PinnedMessagesCard_wrapper_unpin_all {
        /* Remove the unpin all button height and the top and bottom padding  */
        height: calc(100% - var(--unpin-height) - calc(var(--cpd-space-4x) * 2));
    }

    /* Telement: a row docked at the bottom of the card, which is all button, with the composer's line above it and the
       composer's inset. Its label is in the accent, as Telegram's bar to unpin all messages is. */
    .mx_PinnedMessagesCard_unpin {
        position: absolute;
        inset-block-end: 0;
        inset-inline-start: 0;
        box-sizing: border-box;
        width: 100%;
        height: var(--unpin-height);
        padding: 0 var(--cpd-space-2x);
        border: none;
        border-block-start: var(--cpd-border-width-1) solid var(--cpd-color-bg-subtle-primary);
        background: none;
        color: var(--cpd-color-text-action-accent);
        font: var(--cpd-font-body-md-semibold);
        letter-spacing: var(--cpd-font-letter-spacing-body-md);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;

        &:hover {
            background: var(--cpd-color-bg-action-secondary-hovered);
        }

        &:active {
            background: var(--cpd-color-bg-action-secondary-pressed);
        }

        &:focus-visible {
            outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
            outline-offset: calc(-1 * var(--cpd-border-width-2));
        }
    }

    .mx_EventTile_line {
        word-break: break-word;
    }
}
