.mx_ThreadPanel {
    height: 100px;
    overflow: visible;

    /* The card's second header (_BaseCard.pcss): the filter at its start, the button at its end */
    .mx_ThreadPanelHeader {
        justify-content: space-between;

        /* As big as the card header's buttons, with their 24px icon. Compound puts its class first;
           Headers.test.browser.ts fails when an upgrade renames it. */
        [class^="_icon-button_"] {
            padding: calc((var(--BaseCard_header-button-size) - var(--cpd-space-6x)) / 2);
        }
    }

    .mx_AutoHideScrollbar,
    .mx_RoomView_messagePanelSpinner {
        background-color: $background;
        border-radius: 8px;
        padding-inline-end: 0;
        overflow-y: scroll; /* set gap between the thread tile and the right border */
        height: 100%;
    }

    /* For style rules of EventTile in a thread, see _EventTile.pcss */
    &.mx_ThreadView {
        max-height: 100%;

        .mx_ThreadView_timelinePanelWrapper {
            position: relative;
            min-height: 0; /* don't displace the composer */
            flex-grow: 1;

            .mx_FileDropTarget {
                border-radius: 8px;
            }
        }

        .mx_MessageComposer_sendMessage {
            margin-right: 0;
        }

        /* Make use of the space above the composer buttons too */
        .mx_Autocomplete {
            width: calc(100% + 140px);
        }
        &.mx_ThreadView_narrow .mx_Autocomplete {
            width: calc(100% + 108px);
        }
    }

    .mx_RoomView_messagePanel {
        &.mx_RoomView_messageListWrapper {
            position: initial;
        }

        .mx_RoomView_messageListWrapper {
            width: calc(100% + 6px); /* 8px - 2px */
        }

        .mx_RoomView_empty {
            display: contents;
        }
    }

    .mx_RoomView_MessageList {
        padding-inline-start: var(--cpd-space-2x);
        padding-inline-end: var(--cpd-space-2x);
        content-visibility: visible;
    }

    /* In bubbles the thread's content sits 12px from the panel's sides, as the room's does (_EventBubbleTile.pcss), so
       that the avatars, the bubbles and your own bubbles' tails line up the same way in both. As in the room, the list
       doesn't stretch 6px under the scrollbar: where the scrollbar takes no room, as macOS draws it, it would bring the
       tails 6px closer to the panel's end than the room's are. */
    .mx_ThreadView_timelinePanelWrapper[data-layout="bubble"] {
        .mx_RoomView_messageListWrapper {
            width: auto;
        }

        .mx_RoomView_MessageList {
            padding-inline: var(--cpd-space-3x);
        }
    }

    /* The lists of threads and of notifications put a row's highlight 4px from the card's edges and its content 8px
       inside the highlight, as the other cards' rows do. The list doesn't stretch 6px under the scrollbar, which made
       up for the always shown 8px scrollbar of 2022: its end is 4px from the scrollbar where one takes room, and from
       the card's edge where the scrollbar overlays the list. The timelines of the thread view and the timeline card
       keep their spacing. */
    &:not(.mx_ThreadView, .mx_TimelineCard) {
        .mx_RoomView_messagePanel .mx_RoomView_messageListWrapper {
            width: auto;
        }

        .mx_RoomView_MessageList {
            padding-inline: var(--tl-inset-menu);
        }
    }

    .mx_GenericEventListSummary {
        /* Account for scrollbar when hovering */
        padding-top: 0;

        .mx_TimelineSeparator {
            display: none;
        }
    }

    /* Docked at the card's bottom as the room's composer is at the room's: its divider meets both edges of the card,
       and its row keeps the room's inset (_MessageComposer.pcss) */
    .mx_MessageComposer {
        background-color: $background;
        box-sizing: border-box;
    }

    .mx_BaseCard_footer {
        text-align: left;
        font-size: $font-12px;
        align-items: center;
        justify-content: flex-end;
        gap: 4px;
        position: relative;
        top: 2px;
        padding-right: 8px;

        .mx_AccessibleButton_kind_link_inline {
            color: $secondary-content;
        }
    }
}
