.mx_ThreadPanel {
    height: 100px;
    overflow: visible;

    .mx_ThreadPanelHeader {
        height: 64px;
        display: flex;
        box-sizing: border-box;
        /* The card header's inset (_BaseCard.pcss) */
        padding: 0 var(--cpd-space-3x);
        align-items: center;
        border-bottom: 1px solid var(--cpd-color-gray-400);

        .mx_AccessibleButton {
            font-size: 12px;
            color: $secondary-content;
        }

        /* As big as the card header's buttons, with a 20px icon: mark all as read draws to the edges of its box, so at
           20px it looks as big as the header's 24px icons. Compound puts its class first; Headers.test.browser.ts fails
           when an upgrade renames it. */
        [class^="_icon-button_"] {
            padding: calc((var(--BaseCard_header-button-size) - var(--cpd-space-5x)) / 2);
        }

        .mx_ThreadPanel_vertical_separator {
            height: 28px;
            margin-left: var(--cpd-space-3x);
            margin-right: var(--cpd-space-2x);
            border-left: 1px solid var(--cpd-color-gray-400);
        }

        /* A 36px pill like the button before it, with the chevron as far from its end as from its top and bottom. The
           label's line is as tall as the pill, which centers the label to the half pixel. */
        .mx_ThreadPanel_dropdown {
            display: flex;
            align-items: center;
            font: var(--cpd-font-body-sm-regular);
            padding-inline: var(--cpd-space-3x) var(--cpd-space-2x);
            border-radius: var(--tl-radius-control);
            line-height: var(--tl-control-size);
            user-select: none;

            &:hover,
            &[aria-expanded="true"] {
                background: $quinary-content;
            }

            svg {
                margin-inline-start: 2px;
                height: 20px;
                width: 20px;
            }
        }
    }

    .mx_AutoHideScrollbar,
    .mx_RoomView_messagePanelSpinner {
        background-color: $background;
        border-radius: 8px;
        padding-inline-end: 0;
        overflow-y: scroll; /* set gap between the thread tile and the right border */
        height: 100%;
    }

    /* For style rules of EventTile in a thread, see _EventTile.pcss */
    &.mx_ThreadView {
        max-height: 100%;

        .mx_ThreadView_timelinePanelWrapper {
            position: relative;
            min-height: 0; /* don't displace the composer */
            flex-grow: 1;

            .mx_FileDropTarget {
                border-radius: 8px;
            }
        }

        .mx_MessageComposer_sendMessage {
            margin-right: 0;
        }

        /* Make use of the space above the composer buttons too */
        .mx_Autocomplete {
            width: calc(100% + 140px);
        }
        &.mx_ThreadView_narrow .mx_Autocomplete {
            width: calc(100% + 108px);
        }
    }

    .mx_RoomView_messagePanel {
        &.mx_RoomView_messageListWrapper {
            position: initial;
        }

        .mx_RoomView_messageListWrapper {
            width: calc(100% + 6px); /* 8px - 2px */
        }

        .mx_RoomView_empty {
            display: contents;
        }
    }

    .mx_RoomView_MessageList {
        padding-inline-start: var(--cpd-space-2x);
        padding-inline-end: var(--cpd-space-2x);
        content-visibility: visible;
    }

    /* The lists of threads and of notifications put a row's highlight 4px from the card's edges and its content 8px
       inside the highlight, as the other cards' rows do. The list doesn't stretch 6px under the scrollbar, which made
       up for the always shown 8px scrollbar of 2022: its end is 4px from the scrollbar where one takes room, and from
       the card's edge where the scrollbar overlays the list. The timelines of the thread view and the timeline card
       keep their spacing. */
    &:not(.mx_ThreadView, .mx_TimelineCard) {
        .mx_RoomView_messagePanel .mx_RoomView_messageListWrapper {
            width: auto;
        }

        .mx_RoomView_MessageList {
            padding-inline: var(--tl-inset-menu);
        }
    }

    .mx_GenericEventListSummary {
        /* Account for scrollbar when hovering */
        padding-top: 0;

        .mx_TimelineSeparator {
            display: none;
        }
    }

    .mx_MessageComposer {
        background-color: $background;
        border-radius: 8px;
        margin-top: 8px;
        padding: 0 8px;
        box-sizing: border-box;
    }

    .mx_BaseCard_footer {
        text-align: left;
        font-size: $font-12px;
        align-items: center;
        justify-content: flex-end;
        gap: 4px;
        position: relative;
        top: 2px;
        padding-right: 8px;

        .mx_AccessibleButton_kind_link_inline {
            color: $secondary-content;
        }
    }
}

.mx_ContextualMenu_wrapper {
    /* The shared menu rows (TELEMENT.md, "Radius and spacing"): content 16px from the menu's edge, Compound's radio
       10px before the label, and the description in smaller secondary text under it */
    .mx_ThreadPanel_Header_FilterOptionItem {
        display: grid;
        grid-template-columns: auto 1fr;
        column-gap: var(--tl-menu-icon-gap);
        align-items: center;
        padding: var(--cpd-space-1x) var(--cpd-space-3x);
        border-radius: var(--tl-radius-row);

        /* Highlighted as in the other menus, also when focused with the keyboard */
        &:hover,
        &:focus-visible {
            background-color: var(--cpd-color-bg-action-secondary-hovered);
        }

        &:active {
            background-color: var(--cpd-color-bg-action-secondary-pressed);
        }

        /* Inside the highlight, so that the ring keeps clear of the menu's border, as far as the highlight does */
        &:focus-visible {
            outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
            outline-offset: calc(-1 * var(--cpd-border-width-2));
        }

        /* Centered on the label's line */
        .mx_ThreadPanel_Header_FilterOptionItem_selection {
            grid-row: 1 / span 2;
            align-self: start;
            margin-block-start: calc((1lh - 20px) / 2);
            pointer-events: none;
        }

        > span {
            grid-column: 2;
        }

        /* Puts the row on the 4px grid: 4 + 22.5 + 2 + 19.5 + 4 = 52 */
        > span:last-child {
            margin-block-start: 2px;
            font: var(--cpd-font-body-sm-regular);
            color: var(--cpd-color-text-secondary);
        }
    }
}
