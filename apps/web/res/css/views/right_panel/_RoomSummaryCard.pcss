.mx_RoomSummaryCard {
    /* The card's content edge, the card header's 12px inset */
    --cpd-separator-inset: var(--cpd-space-3x);
    --cpd-separator-spacing: var(--cpd-space-4x);

    .mx_RoomSummaryCard_container {
        text-align: center;
        margin: var(--cpd-space-5x) var(--cpd-space-3x) 0;
    }

    /* Inset rows, as in the room list: the highlight 4px from the panel's edge and what the row holds 8px inside it, as
       far as the icon is from its top and bottom, so it sits on the card's 12px content edge. A row focused with the
       keyboard is highlighted as on hover, with the focus ring inside the highlight. */
    [role^="menuitem"] {
        /* A button doesn't stretch to its container's width by itself */
        inline-size: calc(100% - 2 * var(--tl-inset-menu));
        margin-inline: var(--tl-inset-menu);
        padding-inline: var(--cpd-space-2x);
        border-radius: var(--tl-radius-row);

        &:focus-visible {
            outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
            outline-offset: calc(-1 * var(--cpd-border-width-2));
        }

        &[data-kind="primary"]:focus-visible {
            background: var(--cpd-color-bg-action-secondary-hovered);
        }

        &[data-kind="critical"]:focus-visible {
            background: var(--cpd-color-bg-critical-subtle);
        }
    }

    .mx_RoomSummaryCard_roomName,
    .mx_RoomSummaryCard_alias {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        white-space: pre-wrap;
        overflow: hidden;
    }

    .mx_RoomSummaryCard_alias {
        text-overflow: ellipsis;
    }

    .mx_RoomSummaryCard_topic {
        padding: 0;
        color: var(--cpd-color-text-secondary);

        .mx_RoomSummaryCard_topic_box {
            width: 100%;
        }

        .mx_RoomSummaryCard_topic_container {
            text-align: start;
            display: flex;
        }

        .mx_RoomSummaryCard_topic_edit {
            width: max-content;
            /* Compound pads a link by 0.25rem for its pressed pill; this puts the text under the topic's */
            margin-inline-start: -0.25rem;
        }

        /* "Add topic" and "Edit" stand on their own, so they are text buttons in the accent, without an underline */
        .mx_RoomSummaryCard_topic_link {
            color: var(--cpd-color-text-action-accent);
            text-decoration: none;
        }

        p {
            white-space: pre-wrap;
            width: 100%;
            min-width: 0;
            margin: 0;
        }

        a {
            cursor: pointer;
        }

        .mx_RoomSummaryCard_topic_chevron {
            transition: transform 0.3s;
        }

        &.mx_RoomSummaryCard_topic_collapsed {
            p {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: normal;
                display: -webkit-box;
                -webkit-box-orient: vertical;
                -webkit-line-clamp: 2;
            }

            .mx_RoomSummaryCard_topic_chevron {
                transform: rotate(-90deg);
            }
        }
    }

    .mx_AccessibleButton_kind_link {
        margin-top: 12px;
        margin-bottom: 12px;
        font-size: $font-13px;
        font-weight: var(--cpd-font-weight-semibold);
    }
}

.mx_RoomSummaryCard_badges {
    margin: var(--cpd-space-4x) 0;
}

.mx_RoomSummaryCard_roomName {
    margin: var(--cpd-space-3x) 0 var(--cpd-space-1x);
}

.mx_RoomSummaryCard_bottomOptions {
    margin: 0 0 var(--cpd-space-8x);
}
