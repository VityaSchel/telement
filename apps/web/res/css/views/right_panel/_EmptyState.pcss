/* Telement: the layout is the shared EmptyStateView's; the card adds its glow */
.mx_EmptyState {
    &::before {
        /* Bloom using magic numbers directly out of Figma. Telement: in the accent, at the strength of Element's green */
        content: "";
        position: absolute;
        z-index: -1;
        width: 642px;
        height: 775px;
        right: -253.77px;
        top: 0;
        background: radial-gradient(
            49.95% 49.95% at 50% 50%,
            color-mix(in srgb, var(--cpd-color-icon-accent-primary) 12%, transparent) 0%,
            transparent 100%
        );
        transform: rotate(-89.69deg);
        overflow: hidden;
    }
}
