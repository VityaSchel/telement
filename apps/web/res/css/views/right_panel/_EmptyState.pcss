.mx_EmptyState {
    height: 100%;
    box-sizing: border-box;
    /* The right panel card's content edge, the card header's 12px inset */
    padding: var(--cpd-space-4x) var(--cpd-space-3x);
    text-align: center;

    svg {
        width: 56px;
        height: 56px;
        box-sizing: border-box;
        border-radius: 8px;
        padding: var(--cpd-space-3x);
        background-color: $panel-actions;
    }

    &::before {
        /* Bloom using magic numbers directly out of Figma. Telement: in the accent, at the strength of Element's green */
        content: "";
        position: absolute;
        z-index: -1;
        width: 642px;
        height: 775px;
        right: -253.77px;
        top: 0;
        background: radial-gradient(
            49.95% 49.95% at 50% 50%,
            color-mix(in srgb, var(--cpd-color-icon-accent-primary) 12%, transparent) 0%,
            transparent 100%
        );
        transform: rotate(-89.69deg);
        overflow: hidden;
    }
}
