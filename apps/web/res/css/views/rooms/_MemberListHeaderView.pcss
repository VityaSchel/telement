/* The card's second header (_BaseCard.pcss). Without a search field the invite button spans it. */
.mx_MemberListHeaderView {
    .mx_MemberListHeaderView_inviteButton {
        flex: 1;
    }

    .mx_MemberListHeaderView_search {
        flex: 1;
        min-width: 0;
    }
}
