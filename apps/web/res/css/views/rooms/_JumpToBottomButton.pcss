.mx_JumpToBottomButton {
    z-index: 1000;
    position: absolute;
    /* 12 because height is 48 but button is only 36 = 12+(48-36) = 24 */
    bottom: 12px;
    right: 24px;
    width: var(--tl-control-size);
    /* give it a fixed height so the badge doesn't make */
    /* it taller and pop upwards when visible */
    height: calc(var(--tl-control-size) + var(--cpd-space-3x));
    text-align: center;
}

/*
 * Like the room list's unread counter: 20px tall at the default font size, with the digits trimmed to their cap height
 * and padded by a whole number of pixels on every side, so that they sit in its middle, one digit makes a circle and
 * more make a pill. Its middle is on the middle of the button's bottom edge.
 */
.mx_JumpToBottomButton_badge {
    --badge-inset: round(calc((1.25rem - 1cap) / 2), 1px);

    position: absolute;
    inset-block-start: var(--tl-control-size);
    inset-inline: 0;
    translate: 0 -50%;
    box-sizing: content-box;
    inline-size: fit-content;
    min-inline-size: 1cap;
    block-size: 1cap;
    margin-inline: auto;
    padding: var(--badge-inset);
    border-radius: var(--tl-radius-control);
    font: var(--cpd-font-body-xs-semibold);
    line-height: 1cap;
    text-box: trim-both cap alphabetic;
    text-align: center;
    /* Telement: the room list's accent counter, white on the accent; red is left for failed messages */
    color: var(--tl-color-on-accent);
    background-color: var(--cpd-color-bg-accent-rest);
}

/* Telement: the room list's gray counter while the room is muted, unless it has mentions */
.mx_JumpToBottomButton_muted:not(.mx_JumpToBottomButton_highlight) .mx_JumpToBottomButton_badge {
    color: var(--cpd-color-text-on-solid-primary);
    background-color: var(--cpd-color-icon-secondary);
}

.mx_JumpToBottomButton_scrollDown {
    position: relative;
    /* Centers the chevron inside the border, which a padded icon as large as the button can't */
    display: flex;
    align-items: center;
    justify-content: center;
    height: var(--tl-control-size);
    border-radius: 50%;
    box-sizing: border-box;
    background: $background;
    border: 1.3px solid var(--cpd-color-icon-tertiary);
    cursor: pointer;

    svg {
        height: 24px;
        width: 24px;
        color: var(--cpd-color-icon-tertiary);
    }

    /* Telement: filled inside its border when hovered, as Compound's secondary icon buttons are, and a step further
       when pressed. The arrow cursor shows on every control, so the fill is what shows it can be clicked. */
    &:hover {
        background: var(--cpd-color-bg-subtle-secondary);
    }

    &:active {
        background: var(--cpd-color-bg-subtle-primary);
    }
}
