.mx_RoomHeader {
    height: 64px;
    box-sizing: border-box;
    /* The avatar 12px from the start, as from the top and bottom; the last button 12px from the end */
    padding: 0 var(--cpd-space-3x);
    border-bottom: 1px solid $separator;
    background-color: $background;

    /* For enhanced visibility under contrast control. Only there, where a transparent outline is drawn: elsewhere it
       would take the place of the focus ring. */
    @media (forced-colors: active) {
        :is(button:has(svg.mx_RoomHeader_toggled), [class^="_icon-button_"][aria-expanded="true"]):not(:focus-visible) {
            outline: 1px solid transparent;
        }
    }

    /* 36px buttons around 24px icons, as in Telegram's chat header. Compound sets an icon button's size inline and
       draws the icon 3/4 of it, so the box and the icon's inset are set here; Headers.test.browser.ts fails when an
       upgrade renames Compound's class, which Compound puts first. */
    [class^="_icon-button_"] {
        inline-size: var(--tl-control-size);
        block-size: var(--tl-control-size);
        padding: calc((var(--tl-control-size) - var(--cpd-space-6x)) / 2);
    }
}

.mx_RoomHeader_infoWrapper {
    /* unset button styles */
    color: inherit;
    background: unset;
    border: unset;
    flex: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    cursor: pointer;
    gap: var(--cpd-space-3x);
    text-align: left;
    height: 100%;
    padding: 0;
    /* Without this, this flex item reports its unshrunk content width to
       mx_RoomHeader which breaks its max-width. */
    min-width: 0;

    /* Telement: the keyboard focus ring of the room's name, which opens room info, is a row's, inside the header: 8px
       from its top and bottom, 8px past the name's start and the button's end, and rounded like a row, rather than a
       ring round the header-high button that starts at the name's first letter */
    position: relative;

    &:focus-visible {
        outline: none;
    }

    &:focus-visible::after {
        content: "";
        position: absolute;
        inset: var(--cpd-space-2x) calc(-1 * var(--cpd-space-2x));
        border-radius: var(--tl-radius-row);
        outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
        outline-offset: calc(-1 * var(--cpd-border-width-2));
        pointer-events: none;
    }
}

.mx_RoomHeader_info {
    /* Telement: the name runs up to the header's 12px gap before the first button, as the header's other parts are
       spaced, rather than leaving Element's 64px there */
    /* See mx_RoomHeader_infoWrapper min-width comment above. */
    min-width: 0;
}

.mx_RoomHeader_truncated {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;

    overflow: hidden;
    word-break: break-all;
    text-overflow: ellipsis;
}

.mx_RoomHeader_heading {
    display: flex;
    gap: var(--cpd-space-1-5x);
    align-items: center;
    min-width: 0;
}

.mx_RoomHeader_userStatus {
    flex-shrink: 1;
    min-width: 0;
}

.mx_RoomHeader_icon {
    flex-shrink: 0;
}

.mx_RoomHeader .mx_FacePile {
    color: $secondary-content;
    background: $background;
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    border-radius: 9999px;
    /* As tall as the buttons beside it, its 20px avatars as far from the top and bottom as from the start */
    padding: var(--cpd-space-2x);
    cursor: pointer;
    user-select: none;
    font: var(--cpd-font-body-sm-medium);

    /* RoomAvatar doesn't pass classes down to avatar
    So set style here
    using div because compound classes are not stable */
    > div {
        flex-shrink: 0;
    }

    &:hover {
        color: $primary-content;
        background: var(--cpd-color-bg-subtle-primary);
    }

    /* While the member list is open, its count is in the accent with no fill, as the glyphs of the buttons beside it
       are while their panel or menu is open */
    &.mx_FacePile_toggled {
        color: var(--cpd-color-text-action-accent);
        font: var(--cpd-font-body-sm-semibold);

        /* For enhanced visibility under contrast control, where a transparent outline is drawn */
        @media (forced-colors: active) {
            &:not(:focus-visible) {
                outline: 1px solid transparent;
            }
        }
    }
}

.mx_RoomHeader .mx_BaseAvatar {
    flex-shrink: 0;
}

.mx_RoomHeader_videoCallOption {
    /* Workaround for https://github.com/element-hq/compound/issues/331 */
    min-width: 240px;
}

/* A button whose right panel card, call or menu is open draws its glyph in the accent, with no fill of its own. Hovered,
   it gets the gray hover fill and keeps the accent glyph. */
.mx_RoomHeader .mx_RoomHeader_toggled,
.mx_RoomHeader [class^="_icon-button_"][aria-expanded="true"] svg {
    fill: var(--cpd-color-icon-accent-primary);
}
