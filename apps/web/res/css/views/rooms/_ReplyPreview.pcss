/* A flat bar at the top of the composer, as in Telegram. The quote line lines up with the attach button's icon and the
   cancel icon with the icons on the right: all of them sit 16px in from the composer's sides. */
.mx_ReplyPreview {
    max-height: 50vh;
    overflow: auto;
    padding: var(--cpd-space-2x) var(--cpd-space-1x) 0 var(--cpd-space-2x);

    /* The spacing of the reply quote inside messages (mx_ReplyChain), with its line in the sender's color, which the
       mx_Username_color class sets as the text color. */
    .mx_ReplyPreview_section {
        position: relative;
        padding-inline-start: var(--cpd-space-3x);

        /* The line is drawn on its own, as a border on the section's side would round only its outer edge. It stays a
           border rather than a background, which forced colors would paint over. */
        &::before {
            content: "";
            position: absolute;
            inset-block: 0;
            inset-inline-start: 0;
            inline-size: 0;
            border-inline-start: 2px solid currentcolor;
            border-radius: var(--tl-radius-control);
        }

        /* Spaced like the quote's sender row, 2px below the line's top. */
        .mx_ReplyPreview_header {
            display: flex;
            align-items: center;
            column-gap: var(--cpd-space-2x);
            padding-block-start: var(--cpd-space-0-5x);

            .mx_ReplyPreview_title {
                flex: 1;
                min-width: 0;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
                font: var(--cpd-font-body-md-semibold);

                .mx_ReplyPreview_mxid {
                    font: var(--cpd-font-body-sm-regular);
                    color: var(--cpd-color-text-secondary);
                }
            }

            .mx_ReplyPreview_header_cancel {
                flex-shrink: 0;
                display: flex;
                padding: var(--cpd-space-1x);
                /* A 28px target that leaves the row as high as the title's line, so the icon sits on its centre line. */
                margin-block: -3px;
                border-radius: var(--tl-radius-control);
                color: var(--cpd-color-icon-secondary);

                svg {
                    width: 20px;
                    height: 20px;
                }

                &:hover,
                &:focus-visible {
                    color: var(--cpd-color-icon-primary);
                    background-color: var(--cpd-color-bg-subtle-primary);
                }
            }
        }
    }

    /* Maps get the 44px-high thumbnail of pictures and videos, in the timeline map's 3:2 shape, without the controls,
       status and full-size marker that don't fit it. They are set here, as the shared reply view's styles sit in a
       lower cascade layer than the app's map styles. */
    .mx_MLocationBody .mx_MLocationBody_map,
    .mx_MBeaconBody {
        width: 66px;
        height: 44px;
    }

    .maplibregl-control-container,
    .mx_MBeaconBody_chin {
        display: none;
    }

    .mx_Marker_border {
        transform: scale(0.5);
        transform-origin: bottom;
    }
}
