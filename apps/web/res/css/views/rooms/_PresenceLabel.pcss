.mx_PresenceLabel {
    font-size: $font-11px;
    opacity: 0.5;
}

/* Telegram writes "online" in its accent, the color of the presence dots on avatars too */
.mx_PresenceLabel_online {
    color: var(--cpd-color-text-action-accent);
}
