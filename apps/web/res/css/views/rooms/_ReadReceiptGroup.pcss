.mx_ReadReceiptGroup {
    position: relative;
    inset-inline-end: var(--event-tile-read-receipt-inset-inline-end, auto);
    display: inline-block;
    user-select: none;
    z-index: 1;

    .mx_ReadReceiptGroup_button {
        display: inline-flex;
        flex-direction: row;
        height: 16px;
        padding: 4px;
        border-radius: var(--tl-radius-control);

        &.mx_AccessibleButton {
            &:hover {
                background: $event-selected-color;
            }
        }
    }

    .mx_ReadReceiptGroup_remainder {
        color: $secondary-content;
        font-size: $font-11px;
        line-height: $font-16px;
        margin-right: 4px;
    }

    .mx_ReadReceiptGroup_container {
        position: relative;
        display: block;
        height: 100%;

        svg {
            display: inline-block;
            width: 16px;
            height: 16px;
            color: var(--cpd-color-icon-tertiary);
        }

        .mx_BaseAvatar {
            /* Compound uses a border on default avatars but no border on actual images, we want a border in all cases */
            box-sizing: content-box;
            border: 1px solid $background !important;
            /* Reset the line height as we are no longer box-sizing border-box. 14px because avatar is set at 14px in component */
            line-height: 14px;
            position: absolute;
            will-change: left, top;
            transition:
                left var(--transition-short) ease-out,
                top var(--transition-standard) ease-out;
        }
    }
}

/* Telement: the shared menu surface (TELEMENT.md, "Radius and spacing") holding a dense list: a Compound-style title, then
   40px rows inset 4px from the menu's edge, the avatar 16px in and the name 12px after it, with the time at the end */
.mx_ReadReceiptGroup_popup {
    max-height: 300px;
    width: 280px;
    display: flex;
    flex-direction: column;
    text-align: start;
    font: var(--cpd-font-body-md-regular);

    right: 0;

    &.mx_ContextualMenu_top {
        top: 8px;
    }

    &.mx_ContextualMenu_bottom {
        bottom: 8px;
    }

    .mx_ReadReceiptGroup_title {
        margin: 0 0 var(--tl-inset-menu);
        padding: var(--cpd-space-2x) var(--cpd-space-3x) calc(var(--cpd-space-2x) - var(--cpd-border-width-1));
        border-block-end: var(--cpd-border-width-1) solid var(--cpd-color-gray-400);
        font: var(--cpd-font-body-sm-semibold);
        color: var(--cpd-color-text-secondary);
        /* shouldn’t be actually focusable */
        outline: none;
    }

    .mx_AutoHideScrollbar {
        padding: calc(var(--tl-inset-menu) - var(--cpd-border-width-1));

        .mx_ReadReceiptGroup_person {
            display: flex;
            align-items: center;
            gap: var(--cpd-space-3x);
            box-sizing: border-box;
            min-block-size: var(--cpd-space-10x);
            padding: var(--cpd-space-2x) var(--cpd-space-3x);
            border-radius: var(--tl-radius-row);

            &:hover,
            &:focus-visible {
                background-color: var(--cpd-color-bg-action-secondary-hovered);
            }

            &:active {
                background-color: var(--cpd-color-bg-action-secondary-pressed);
            }

            /* Inside the highlight, as in the other menus */
            &:focus-visible {
                outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
                outline-offset: calc(-1 * var(--cpd-border-width-2));
            }

            .mx_BaseAvatar {
                flex-shrink: 0; /* Long names should not shrink the picture */
            }

            .mx_ReadReceiptGroup_name {
                display: flex;
                align-items: baseline;
                gap: var(--cpd-space-2x);
                flex-grow: 1;
                min-inline-size: 0;

                p {
                    margin: 0;
                    text-overflow: ellipsis;
                    overflow: hidden;
                    white-space: nowrap;
                }

                p:first-child {
                    flex-grow: 1;
                }

                .mx_ReadReceiptGroup_secondary {
                    flex-shrink: 0;
                    font: var(--cpd-font-body-sm-regular);
                    color: var(--cpd-color-text-secondary);
                }
            }
        }
    }
}

.mx_ReadReceiptGroup_person--tooltip {
    overflow-y: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
