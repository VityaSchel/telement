.mx_WhoIsTypingTile {
    margin-left: -18px; /* offset padding from mx_RoomView_MessageList to center avatars */
    padding-top: 18px;
    display: flex;
    align-items: center;
}

/* position the indicator in the same place horizontally as the event-tile avatar slot. */
.mx_WhoIsTypingTile_avatars {
    flex: 0 0 82px; /* 18 (padding on message list) + 64 (padding on event lines) */
    text-align: center;
}

.mx_WhoIsTypingTile_avatars > :not(:first-child) {
    margin-left: -12px;
}

.mx_WhoIsTypingTile_avatars .mx_BaseAvatar {
    border: 1px solid $background;
    border-radius: 40px;
}

.mx_WhoIsTypingTile_remainingAvatarPlaceholder {
    position: relative;
    display: inline-block;
    color: $primary-content;
    background-color: $quinary-content;
    border: 1px solid $background;
    border-radius: 40px;
    width: 24px;
    height: 24px;
    line-height: $font-24px;
    font-size: 0.8em;
    vertical-align: top;
    text-align: center;
}

.mx_WhoIsTypingTile_label {
    flex: 1;
    font: var(--cpd-font-body-md-semibold);
    color: $roomtopic-color;
}

.mx_WhoIsTypingTile_label > span {
    background-image: url("/res/img/typing-indicator-2x.gif");
    background-size: 25px;
    background-position: left bottom;
    background-repeat: no-repeat;
    padding-bottom: 15px;
    display: block;
}

.mx_MatrixChat_useCompactLayout {
    .mx_WhoIsTypingTile {
        padding-top: 4px;
    }
}

/* In bubbles the label starts where the text in a bubble does, as the intro does (see _NewRoomIntro.pcss). The last
   avatar is centered on the message avatars, which end 8px before the bubbles: the row's 49px margin, less the bubble's
   9px outset, the 8px and half their 32px. More avatars stack towards the start. */
.mx_RoomView_body[data-layout="bubble"] {
    .mx_WhoIsTypingTile {
        margin-left: 0;
    }

    .mx_WhoIsTypingTile_avatars {
        --WhoIsTypingTile_bubble-label-inset: calc(49px - 9px + var(--cpd-space-3x) + 1px);
        --WhoIsTypingTile_bubble-avatar-center: calc(49px - 9px - var(--cpd-space-2x) - 32px / 2);

        box-sizing: border-box;
        flex-basis: var(--WhoIsTypingTile_bubble-label-inset);
        padding-inline-end: calc(
            var(--WhoIsTypingTile_bubble-label-inset) - var(--WhoIsTypingTile_bubble-avatar-center) - 24px / 2
        );
        text-align: end;
    }
}

/* In IRC the label starts where a message's text does, and the avatars where its sender's name does. */
.mx_IRCLayout {
    .mx_WhoIsTypingTile_avatars {
        box-sizing: border-box;
        flex-basis: calc(
            var(--RoomView_MessageList-padding) + var(--MessageTimestamp-width) + var(--icon-width) +
                var(--name-width) + 2 * var(--right-padding)
        );
        padding-inline-start: calc(
            var(--RoomView_MessageList-padding) + var(--MessageTimestamp-width) + var(--icon-width) + 2 *
                var(--right-padding)
        );
        text-align: start;
    }
}
