.mx_SendMessageComposer {
    flex: 1;
    display: flex;
    flex-direction: column;
    font: var(--cpd-font-body-md-regular);
    /* fixed line height to prevent emoji from being taller than text */
    line-height: $font-18px;
    justify-content: center;
    margin-inline-end: var(--cpd-space-1x);
    /* don't grow wider than available space */
    min-width: 0;

    .mx_BasicMessageComposer {
        flex: 1;
        display: flex;
        flex-direction: column;

        .mx_BasicMessageComposer_input {
            /* The same space above and below one line or many, so the text keeps its distance from the */
            /* composer's top border as it grows. One line is still taller than the voice message recording */
            /* widget, so starting a recording doesn't make the composer jump. */
            padding: var(--cpd-space-4x) 0;
            /* Once long text scrolls, it fades out in that space instead of running into the border, and the */
            /* caret is kept out of it. */
            scroll-padding-block: var(--cpd-space-4x);
            mask-image: linear-gradient(
                transparent,
                black var(--cpd-space-4x),
                black calc(100% - var(--cpd-space-4x)),
                transparent
            );
            /* max-height at this level so autocomplete doesn't get scrolled too */
            max-height: 140px;
            overflow-y: auto;
        }
    }
}
