$left-gutter: 64px;

.mx_EventTile {
    /* Pass the application/theme-specific highlight colour to the shared
       EventTileView interaction styles. */
    --event-tile-state-highlight-background: $event-highlight-bg-color;
    --event-tile-state-hover-background: $event-selected-color;
    --event-tile-bubble-other-background: $eventbubble-others-bg;
    --event-tile-bubble-self-background: $eventbubble-self-bg;
    --event-tile-preview-hover-background: $panels;
    --event-tile-preview-separator-color: $quinary-content;
    --EventTile_group_line-spacing-block-start: 1px;
    --EventTile_group_line-spacing-block-end: 3px;
    --EventTile_group_line-spacing-inline-start: $left-gutter;
    --EventTile_group_line-line-height: $font-22px;
    --EventTile_ThreadSummary-line-height: calc(2 * $font-12px);

    flex-shrink: 0;
    max-width: 100%;
    clear: both; /* TODO: check if this is necessary */
    position: relative;

    /* Retained for legacy error/fallback markup that does not use EventTileView. */
    &.mx_EventTile_info {
        font-size: var(--cpd-font-size-body-sm);
        color: $secondary-content;
    }

    .mx_EventTile_content {
        &.mx_EditMessageComposer,
        &.mx_EditWysiwygComposer {
            /* Make sure the formatting bar is visible */
            overflow: visible;
        }
    }

    .mx_EditMessageComposerWrapper {
        /* This keeps the autocomplete / format bar visible above the edit composer. */
        overflow: visible;
    }

    /* An accent fill with white text, as the other accent fills: the dark themes' deeper fill keeps it readable */
    .mx_EventTile_searchHighlight {
        background-color: var(--cpd-color-bg-accent-rest);
        color: var(--tl-color-on-accent);
        border-radius: var(--tl-radius-inline);
        padding-inline: 2px;

        a {
            background-color: var(--cpd-color-bg-accent-rest);
            color: var(--tl-color-on-accent);
        }
    }

    .mx_EventTileBubble {
        margin-block: var(--EventTileBubble_margin-block);
        min-width: 100px;
    }

    .mx_ImageBody {
        .mx_ImageBody_container {
            display: flex;
            align-items: center; /* on every layout */
        }
    }

    .mx_ReactionsRow {
        display: flex;
        flex-flow: wrap;
        align-items: center;
        gap: var(--cpd-space-1x);
    }

    .mx_ReplyChain--expanded {
        .mx_EventTile_content .mx_EventTile_body {
            /* !important needed to override the reply-tile content clamp. */
            display: block !important;
            overflow-y: scroll;
        }

        .mx_EventTile_collapsedCodeBlock {
            /* !important needed due to .mx_ReplyTile .mx_EventTile_content .mx_EventTile_pre_container > pre */
            display: block !important;
        }
    }
}

/* Theads do not set a background on mentioned events as they use an indicator dot */
.mx_ThreadPanel .mx_EventTile {
    --event-tile-preview-highlight-background: none;
}

.mx_GenericEventListSummary {
    &[data-layout="irc"],
    &[data-layout="group"] {
        .mx_EventTile_line .mx_RedactedBody {
            line-height: 1; /* remove spacing between lines */
        }
    }

    &[data-layout="irc"] {
        /* Apply only collapsed events block */
        > .mx_EventTile_line {
            /* add --right-padding value of MessageTimestamp and avatar only */
            /* stylelint-disable-next-line declaration-colon-space-after */
            padding-left: calc(
                var(--name-width) + var(--icon-width) + var(--MessageTimestamp-width) + 2 * var(--right-padding)
            );
        }
    }

    &[data-layout="group"] {
        /* The collapsed summary has a legacy line outside EventTileView. */
        > .mx_EventTile_line {
            padding-inline-start: $left-gutter;
        }
    }
}

.mx_EventTile_content {
    /*
    all the overflow-y: hidden; are to trap Zalgos -
    but they introduce an implicit overflow-x: auto.
    so make that explicitly hidden too to avoid random
    horizontal scrollbars occasionally appearing, like in
    https://github.com/vector-im/vector-web/issues/1154
    */
    overflow-y: hidden;
    overflow-x: hidden;
    .markdown-body {
        font: var(--cpd-font-body-md-regular) !important;
        letter-spacing: var(--cpd-font-letter-spacing-body-md);
        font-family: inherit !important;
        white-space: normal !important;
        line-height: inherit !important;
        background-color: inherit;
        color: inherit; /* inherit the colour from the dark or light theme by default (but not for code blocks) */
        flex: 1;
        /* Telement: github-markdown-css rings a focused link in its own variable, which nothing defines, so the ring
           was dropped; it takes the focus color, which your own bubbles make white */
        --borderColor-accent-emphasis: var(--cpd-color-border-focused);

        pre,
        code {
            font-family: $monospace-font-family !important;
        }

        code:not(pre *) {
            background-color: $inlinecode-background-color;
            border: 1px solid $inlinecode-border-color;
            border-radius: var(--tl-radius-inline);
            /* The font's ascent and descent already leave as much room above and below the text as this leaves at
               its sides. */
            padding: 0 var(--cpd-space-1x);
            /* The chip, the font's height plus the border, fits inside the line with 1px to spare above and below, so
               chips on consecutive lines don't touch. */
            line-height: $font-24px;
            /* Avoid the border to be glued to the other words */
            margin-right: var(--cpd-space-0-5x);
        }

        code {
            white-space: pre-wrap; /* don't collapse spaces in inline code blocks */
        }

        pre {
            /* have to use overlay rather than auto otherwise Linux and Windows */
            /* Chrome gets very confused about vertical spacing: */
            /* https://github.com/vector-im/vector-web/issues/754 */
            overflow-x: overlay;
            overflow-y: visible;

            &::-webkit-scrollbar-corner {
                background: transparent;
            }

            /* One gray step over whatever is behind it, in both themes: a bubble of either color, the timeline, or a
               selected or highlighted row. The border is transparent, keeping the inset below, and shows in forced
               colors mode. */
            background-color: var(--cpd-color-alpha-gray-300);
            border: 1px solid transparent;
            border-radius: var(--tl-radius-inline);
            /* The text, the line numbers and the buttons' icons sit 12px inside the block's edge, border included. */
            padding: calc(var(--cpd-space-3x) - 1px);

            code {
                /* The block's fill is translucent, so the code paints none of its own over it */
                background-color: transparent;
                white-space: pre; /* we want code blocks to be scrollable and not wrap */

                > * {
                    display: inline;
                }
            }
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            font-family: inherit !important;
            color: inherit;
        }

        /* Make h1 and h2 the same size as h3. */
        h1,
        h2 {
            font-size: 1.5em;
            border-bottom: none !important; /* override GFM */
        }

        a {
            color: $accent-alt;
        }

        blockquote {
            @mixin quoteLine;
            color: $secondary-content;
        }

        /*
        // actually, removing the Italic TTF provides
        // better results seemingly

        // compensate for Nunito italics being terrible
        // https://github.com/google/fonts/issues/1726
        em {
            transform: skewX(-14deg);
            display: inline-block;
        }
        */

        /* Support arbitrarily large marker numbers */
        ol {
            list-style-position: inside;
            padding-inline-start: 0.5em;
        }

        /* Override nested lists being lower-roman */
        ol ol,
        ul ol {
            list-style-type: revert;
        }

        /* Make list type disc to match rich text editor */
        ul {
            list-style-type: disc;
        }

        /* override styles from the base markdown CSS that put markdown content on its own line,
           as this isn't what we want for richtext emote content.
         */
        &::before {
            display: none;
        }

        &::after {
            display: none;
        }
    }
}

/* Spoiler stuff */
.mx_EventTile_spoiler {
    cursor: pointer;

    /* clear button styles */
    appearance: none;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font-size: inherit;
    font-family: inherit;
    line-height: inherit;
    text-align: inherit;
    color: inherit;

    .mx_EventTile_spoiler_reason {
        color: $event-timestamp-color;
        font-size: $font-11px;
    }

    .mx_EventTile_spoiler_content {
        filter: blur(5px) saturate(0.1) sepia(1);
        transition-duration: 0.5s;
        pointer-events: none;
    }

    &.visible > .mx_EventTile_spoiler_content {
        filter: none;
        user-select: auto;
        pointer-events: auto;
    }
}

.mx_EventTile_bigEmoji {
    font-size: 48px;
    line-height: 57px;

    .mx_Emoji {
        font-size: inherit !important;
    }
}

.mx_EventTile_body {
    /* selector wrongly applies to pill avatars but those have explicit width/height passed at a higher specificity */
    &.markdown-body img {
        object-fit: contain;
        object-position: left top;

        /* Override the default colors of the 'github-markdown-css' library
        (#fff for light theme, #000 for dark theme) to match the inherited theme */
        background-color: inherit !important;
    }

    .mx_EventTile_pre_container {
        /* Emoji are enlarged in prose, but a code block's line numbers are one fixed-height block
           per line and cannot follow a line that an enlarged emoji has made taller. */
        .mx_Emoji {
            font-size: inherit;
        }

        .mx_EventTile_collapsedCodeBlock {
            max-height: 30vh;
        }

        /* Telement: the block's fill and corners are the container's, so that its header line and its code share them.
           A reply's quote shows only the code, in a fill of its own. */
        &:not(:is(.mx_ReplyChain, .mx_ReplyPreview) *) {
            background-color: var(--cpd-color-alpha-gray-300);
            border-radius: var(--tl-radius-inline);

            > pre {
                --EventTile_codeBlock-fade-direction: to right;
                --EventTile_codeBlock-fade-start: 0px;
                --EventTile_codeBlock-fade-end: 0px;

                background-color: transparent;
                border-radius: 0;

                /* Code cut off at the block's edge fades out over its last 24px on each side that has more to show, while
                   the block can scroll there (useScrollEdges), so that a line clearly goes on. The fill is the
                   container's, so it stays. The block's start is on the right in right-to-left text. */
                &:dir(rtl) {
                    --EventTile_codeBlock-fade-direction: to left;
                }

                &.mx_EventTile_codeBlock_hiddenAtStart {
                    --EventTile_codeBlock-fade-start: var(--cpd-space-6x);
                }

                &.mx_EventTile_codeBlock_hiddenAtEnd {
                    --EventTile_codeBlock-fade-end: var(--cpd-space-6x);
                }

                &:is(.mx_EventTile_codeBlock_hiddenAtStart, .mx_EventTile_codeBlock_hiddenAtEnd) {
                    mask-image: linear-gradient(
                        var(--EventTile_codeBlock-fade-direction),
                        transparent,
                        #000 var(--EventTile_codeBlock-fade-start),
                        #000 calc(100% - var(--EventTile_codeBlock-fade-end)),
                        transparent
                    );
                }
            }
        }
    }

    /* Telement: a 28px line at the block's top, as in Telegram, names the code's language in 13px secondary text on the
       code's 12px edge and holds the expand and copy buttons at its end, always shown, so that they never cover the
       code. A line sets it apart from the code. It is the block's end that holds them, its left in right-to-left text,
       where the code ends. */
    .mx_EventTile_codeBlockHeader {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: var(--cpd-space-1x);
        block-size: var(--cpd-space-7x);
        padding-inline: var(--cpd-space-3x) var(--cpd-space-1x);
        border-block-end: 1px solid var(--cpd-color-alpha-gray-400);
        font: var(--cpd-font-body-sm-regular);
        letter-spacing: var(--cpd-font-letter-spacing-body-sm);
        /* A whole pixel line, so that the text sits as far from the line's top as from its bottom */
        line-height: var(--cpd-space-5x);
        color: var(--cpd-color-text-secondary);
        user-select: none;

        :is(.mx_ReplyChain, .mx_ReplyPreview) & {
            display: none;
        }

        .mx_EventTile_button {
            flex-shrink: 0;
        }
    }

    /* The language as the fence names it, drawn as typed, as code is */
    .mx_EventTile_codeBlockLanguage {
        min-inline-size: 0;
        margin-inline-end: auto;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-feature-settings: var(--tl-font-feature-settings-identifier);
    }
}

.mx_EventTile_lineNumbers {
    /* The numbers start at the block's padding, like its text */
    margin-inline-end: var(--cpd-space-2x);
    color: var(--cpd-color-text-secondary);

    & span {
        text-align: right;
        display: block;
    }
}

/* The numbers and the code sit side by side, so a block that shrinks to fit, as in a bubble, makes room for the numbers
   on every line and not only the first, and a block that scrolls keeps its padding after its longest line. A reply's
   quote clamps the code to its first lines, which this would stop, and shows no numbers. */
pre:not(:is(.mx_ReplyChain, .mx_ReplyPreview) *):has(> .mx_EventTile_lineNumbers) {
    display: flex;
}

/* The block's padding would show the top of the first line the quote leaves out. */
:is(.mx_ReplyChain:not(.mx_ReplyChain--expanded), .mx_ReplyPreview) .mx_EventTile_content .markdown-body pre {
    overflow: clip;
    overflow-clip-margin: content-box;
}

/* The reply tile's 4px below a quoted block, which github-markdown-css's 16px would override from this later layer */
:is(.mx_ReplyChain, .mx_ReplyPreview) .mx_EventTile_content .markdown-body pre {
    margin-block-end: var(--cpd-space-1x);
}

.mx_EventTile_button {
    display: inline-block;
    cursor: pointer;
}

.mx_EventTile_tileError {
    color: red;
    text-align: center;

    /* Remove some of the default tile padding so that the error is centered */
    margin-right: 0;

    .mx_EventTile_line {
        padding-left: 0;
        margin-right: 0;

        span {
            padding: var(--cpd-space-1x) var(--cpd-space-2x);
        }
    }

    a {
        margin-left: 1em;
    }
}

/* Telement: in the thread list only for keyboard focus, as the thread's right-click menu has its actions. The edit
   history dialog, which shares the class, has no such menu and keeps it on hover. */
.mx_EventTile:hover .mx_HistoryActionBar,
[data-whatinput="keyboard"] .mx_EventTile:focus-within .mx_ThreadActionBar,
.mx_EventTile:focus-visible:focus-within .mx_ThreadActionBar {
    visibility: visible;
}

/* Thread-list reply summaries retain the legacy application styling while
   remaining independent of the EventTileView root DOM contract. */
.mx_EventTile .mx_ThreadPanel_replies {
    margin-top: var(--cpd-space-2x);
    display: flex;
    align-items: center;
    position: relative;
    font: var(--cpd-font-body-sm-regular);

    > svg {
        @mixin ThreadSummaryIcon;
    }

    .mx_ThreadPanel_replies_amount {
        @mixin ThreadRepliesAmount;
    }
}

.mx_ThreadSummary_icon {
    display: inline-block;
    margin-top: var(--cpd-space-2x);
    margin-bottom: var(--cpd-space-2x);

    > svg {
        @mixin ThreadSummaryIcon;
        vertical-align: middle;
        margin-inline-end: var(--cpd-space-2x);
        margin-top: -2px;
    }

    a& {
        color: $secondary-content;
    }
}

/* For style rules of ThreadView, see _ThreadPanel.pcss */
.mx_ThreadView {
    --ThreadView_group_spacing-start: 56px; /* 56px: 64px - 8px (padding) */
    --ThreadView_group_spacing-end: 8px; /* same as padding */

    .mx_GenericEventListSummary {
        &[data-layout="irc"],
        &[data-layout="group"] {
            > .mx_EventTile_line {
                padding-inline-start: var(--ThreadView_group_spacing-start); /* align summary text with message text */
                padding-inline-end: var(--ThreadView_group_spacing-end); /* align summary text with message text */
            }
        }
    }

    /* ViewSourceEvent explicitly uses Compound's 11px body-xs token. Legacy
       thread info tiles applied their 12px size directly to event content;
       keep that override on the body component after its slot boundary. */
    .mx_EventTile .mx_EventTile_line .mx_ViewSourceEvent {
        font-size: $font-12px;
    }
}

/* Body-only compact markdown spacing remains application-owned. */
.mx_MatrixChat_useCompactLayout {
    .mx_EventTile {
        .mx_EventTile_content .markdown-body {
            p,
            ul,
            ol,
            dl,
            blockquote,
            pre,
            table {
                margin-bottom: var(--cpd-space-1x); /* 1/4 of the non-compact margin-bottom */
            }
        }
    }
}

/* Media query for mobile UI */
@media only screen and (max-width: 480px) {
    .mx_EventTile_content {
        margin-right: 0;
    }
}
