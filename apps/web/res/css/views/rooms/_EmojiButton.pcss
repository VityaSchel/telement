/* While its drawer is open, the emoji button draws its glyph in the accent with no fill of its own, as the room header's
   buttons do while their panel is open. Hovered, it gets the gray hover fill and keeps the accent glyph. */
.mx_MessageComposer .mx_MessageComposer_button.mx_EmojiButton_highlight {
    svg,
    &:hover svg {
        color: var(--cpd-color-icon-accent-primary);
    }
}
