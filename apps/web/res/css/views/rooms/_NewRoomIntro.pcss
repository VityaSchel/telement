.mx_NewRoomIntro {
    margin: 40px 0 48px 64px;

    .mx_MiniAvatarUploader_hasAvatar:not(.mx_MiniAvatarUploader_busy):not(:hover) {
        .mx_MiniAvatarUploader_indicator {
            display: none;
        }
    }

    .mx_NewRoomIntro_buttons {
        margin-top: 28px;
        display: flex;
        flex-flow: wrap;
        gap: var(--cpd-space-3x);

        .mx_AccessibleButton {
            line-height: $font-24px;
            display: inline-block;

            svg {
                display: inline-block;
                color: $button-fg-color;
                width: 20px;
                height: 20px;
                margin-right: var(--cpd-space-2x);
                vertical-align: text-bottom;
            }
        }
    }

    > h2 {
        margin: var(--cpd-space-6x) 0 var(--cpd-space-4x);
        font: var(--cpd-font-heading-md-semibold);
    }

    > p {
        margin: 0;
        font-size: $font-15px;
        color: $secondary-content;
    }
}

/* The intro starts where the text of a message does. In bubbles that is the row's 49px margin, less the bubble's 9px
   overhang, plus its 12px padding and the body's 1px. Its warning card rounds like the cards in the bubbles. */
.mx_RoomView_body[data-layout="bubble"] .mx_NewRoomIntro {
    --MBody-border-radius: var(--tl-radius-bubble);

    margin-inline-start: calc(49px - 9px + var(--cpd-space-3x) + 1px);
}

.mx_IRCLayout .mx_NewRoomIntro {
    margin-inline-start: calc(
        var(--MessageTimestamp-width) + var(--icon-width) + var(--name-width) + 2 * var(--right-padding)
    );
}
