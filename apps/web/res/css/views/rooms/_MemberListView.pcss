.mx_MemberListView {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;

    /* The line between the people in the room and those who are invited, over the edge of the first one's tile: the tiles
       stay as tall as the list takes them to be */
    .mx_MemberListView_separated {
        position: relative;

        &::before {
            content: "";
            position: absolute;
            inset-inline: 0;
            inset-block-start: calc(-1 * var(--cpd-border-width-1));
            border-block-start: var(--cpd-border-width-2) solid var(--cpd-color-bg-subtle-primary);
            pointer-events: none;
        }
    }

    .mx_MemberListView_noMatches {
        padding: var(--cpd-space-4x) var(--cpd-space-3x);
        text-align: center;
        color: var(--cpd-color-text-secondary);
    }
}
