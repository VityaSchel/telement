.mx_MemberListView {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;

    .mx_MemberListView_separator {
        margin: 0;
        border: none;
        border-top: 2px solid var(--cpd-color-bg-subtle-primary);
    }

    .mx_MemberListView_noMatches {
        padding: var(--cpd-space-4x) var(--cpd-space-3x);
        text-align: center;
        color: var(--cpd-color-text-secondary);
    }
}
