/* Telement: the search bar the room header's search button opens over the timeline: the search field with the arrows that
   step through the results and the close button, and what the search found under them */
.mx_RoomSearchAuxPanel {
    padding: var(--cpd-space-3x);
    box-sizing: border-box;
    border-block-end: var(--cpd-border-width-1) solid $separator;

    .mx_RoomSearchAuxPanel_bar,
    .mx_RoomSearchAuxPanel_steps {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-3x);
    }

    .mx_RoomSearchAuxPanel_steps {
        flex-shrink: 0;
    }

    .mx_RoomSearchAuxPanel_field {
        flex: 1;
        min-width: 0;
    }

    .mx_RoomSearchAuxPanel_details {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--cpd-space-3x);
        margin-block-start: var(--cpd-space-2x);
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
    }

    .mx_RoomSearchAuxPanel_summary_text {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow-wrap: anywhere;
    }

    .mx_SearchWarning {
        display: contents;
        font: inherit;
        color: inherit;
    }

    /* "Search all rooms" stands on its own, so it is a text button in the accent, without a link's underline */
    .mx_RoomSearchAuxPanel_scopeButton {
        flex-shrink: 0;
        /* Compound pads a link by 0.25rem for its pressed pill; this ends the text on the bar's edge, under the close
           button */
        margin-inline-end: -0.25rem;
        font: inherit;
        color: var(--cpd-color-text-action-accent);
        text-decoration: none;
    }

    /* Telement: the place of the result the timeline shows, before the arrows that step through the results */
    .mx_RoomSearchAuxPanel_position {
        font: var(--cpd-font-body-md-regular);
        font-variant-numeric: tabular-nums;
        color: var(--cpd-color-text-secondary);
        white-space: nowrap;
    }
}
