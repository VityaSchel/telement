/* Telement: the link previews' bar 8px above the field, their boxes on the bubble's padding as a control's box is on its
   container's edge, without the 1px a bubble's text keeps around it for tall glyphs (EventTileView.module.css) */
.mx_EditMessageComposerWrapper {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    padding: 0;
}

.mx_EditMessageComposer {
    display: flex;
    flex-direction: column;
    max-width: 100%; /* disable overflow */
    width: auto;
    /* Telement: the field and the buttons 8px apart on the bubble's own padding, with none of their own, so the field
       starts and ends where the bubble's text does */
    gap: var(--cpd-space-2x);
    padding: 0;

    /* Telement: the field spec (TELEMENT.md, "Colors, type and components"): a 1px border with 8px corners, one line
       36px tall with its text 12px inside, a darker border on hover and the accent when focused. In your own bubble the
       bubble points these colors at its translucent whites (EventTileView.module.css) */
    .mx_BasicMessageComposer_input {
        border-radius: var(--tl-radius-row);
        border: solid var(--cpd-border-width-1) var(--cpd-color-border-interactive-secondary);
        background-color: $background;
        max-height: 200px;
        padding: calc((var(--tl-control-size) - 2 * var(--cpd-border-width-1) - 1lh) / 2) var(--cpd-space-3x);

        &:hover {
            border-color: var(--cpd-color-border-interactive-hovered);
        }

        &:focus {
            border-color: var(--cpd-color-border-focused);
        }
    }

    .mx_EditMessageComposer_buttons {
        display: flex;
        flex-flow: row wrap-reverse; /* display "Save" over "Cancel" */
        justify-content: flex-end;
        gap: var(--cpd-space-2x);
        margin-inline-start: auto;

        .mx_AccessibleButton {
            flex: 1;
            box-sizing: border-box;
            min-width: 100px; /* magic number to align the edge of the button with the input area */
        }
    }
}
