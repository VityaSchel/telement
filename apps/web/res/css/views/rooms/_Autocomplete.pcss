/* Telement: a floating menu (TELEMENT.md, "Radius and spacing") 8px above the line over the composer's text, which
   is either the composer's top border or the rich text field's, holding the dense list: 32px rows inset 4px from its
   edge, an avatar or emoji 16px in and the name 10px after it */
.mx_Autocomplete {
    position: absolute;
    bottom: calc(var(--cpd-space-2x) + var(--cpd-border-width-1));
    z-index: 1001;
    width: 100%;
    box-sizing: border-box;
    padding: calc(var(--tl-inset-menu) - var(--cpd-border-width-1));
    border: var(--cpd-border-width-1) solid var(--cpd-color-border-interactive-secondary);
    border-radius: var(--tl-radius-menu);
    background: var(--cpd-color-bg-canvas-default);
    overflow: clip;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 24px rgb(0 0 0 / 10%);
}

.mx_Autocomplete_ProviderSection {
    width: 100%;

    /* Separated as a menu's groups are, the rows kept 2px clear of the line */
    & + & {
        margin-block-start: var(--tl-menu-separator-spacing);
        padding-block-start: var(--tl-menu-separator-spacing);
        border-block-start: var(--cpd-border-width-1) solid var(--cpd-color-gray-400);
    }
}

/* Both kinds of completion are rows of the dense list; a "block" one, a command, may wrap its description */
.mx_Autocomplete_Completion_block,
.mx_Autocomplete_Completion_pill {
    box-sizing: border-box;
    min-height: var(--tl-menu-row-size);
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-1x) var(--cpd-space-3x);
    border-radius: var(--tl-radius-row);
    user-select: none;
    cursor: pointer;
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-primary);
}

.mx_Autocomplete_Completion_block {
    flex-wrap: wrap;
}

/* The avatar or emoji before the name, as far from it as a menu's icons from their labels */
.mx_Autocomplete_Completion_pill > :first-child:not(.mx_Autocomplete_Completion_title) {
    flex-shrink: 0;
    margin-inline-end: calc(var(--tl-menu-icon-gap) - var(--cpd-space-2x));
}

/* styling for common completion elements */
.mx_Autocomplete_Completion_subtitle {
    flex: 1;
}

.mx_Autocomplete_Completion_subtitle,
.mx_Autocomplete_Completion_description {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_Autocomplete_Completion_description {
    min-width: 150px;
}

.mx_Autocomplete_Completion_container_pill {
    height: 100%;
    overflow-y: auto;
}

@container roomview (height >= 0px) {
    .mx_Autocomplete_Completion_container_pill {
        max-height: 40cqh;
    }
}

.mx_Autocomplete_Completion_container_truncate {
    .mx_Autocomplete_Completion_title,
    .mx_Autocomplete_Completion_subtitle,
    .mx_Autocomplete_Completion_description {
        /* Ellipsis for long names/subtitles/descriptions */
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
}

/* The menus' hover fill; the row chosen with the arrow keys, and a pressed one, take the pressed fill */
.mx_Autocomplete_Completion:hover {
    background: var(--cpd-color-bg-action-secondary-hovered);
}

.mx_Autocomplete_Completion.selected,
.mx_Autocomplete_Completion:active {
    background: var(--cpd-color-bg-action-secondary-pressed);
    outline: none;
}

/* A group's title, as in the room directory's server picker, its text where the rows' content starts */
.mx_Autocomplete_provider_name {
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    font: var(--cpd-font-body-sm-semibold);
    color: var(--cpd-color-text-secondary);
}
