.mx_SpaceChildrenPicker {
    margin: 16px 0;

    /* Telement: radios one under another are 12px apart, as Compound's radios in a list are in settings */
    .mx_StyledRadioButton + .mx_StyledRadioButton {
        margin-top: var(--cpd-space-3x);
    }

    .mx_SearchBox {
        /* To match the space around the title */
        margin: 0 0 15px 0;
        flex-grow: 0;
    }

    .mx_SpaceChildrenPicker_noResults {
        display: block;
        margin-top: 24px;
    }
}
