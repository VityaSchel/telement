.mx_NonUrgentEchoFailureToast {
    /* The text wraps beside the icon rather than under it */
    display: flex;
    align-items: flex-start;

    svg {
        flex-shrink: 0;
        width: $font-18px;
        height: $font-18px;
        color: #fff; /* we know that non-urgent toasts are always styled the same */
        margin-right: 8px;
        /* Centered on the first line of text */
        margin-block: calc((1lh - $font-18px) / 2);
    }
}
