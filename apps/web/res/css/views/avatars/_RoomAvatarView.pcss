.mx_RoomAvatarView {
    --room-avatar-size: 48px;
    /* The decorations are centered on the avatar's circle at its bottom right, at 45°, like Telegram's online dot,
       and the masks cut them out with a 2px gap */
    --room-avatar-decoration-center: 41px;

    position: relative;

    /* Keep the container to the same size than the avatar */
    inline-size: var(--room-avatar-size);
    block-size: var(--room-avatar-size);

    .mx_RoomAvatarView_RoomAvatar {
        mask-position: center;
        mask-size: contain;
        mask-repeat: no-repeat;
        pointer-events: none;
    }

    .mx_RoomAvatarView_RoomAvatar_icon {
        mask-image: url("/res/img/element-icons/roomlist/room-avatar-view-icon-mask.svg");
    }

    .mx_RoomAvatarView_RoomAvatar_presence {
        mask-image: url("/res/img/element-icons/roomlist/room-avatar-view-presence-mask.svg");
    }

    .mx_RoomAvatarView_icon {
        position: absolute;

        /* Decoration center - (icon size (16px) / 2) */
        left: calc(var(--room-avatar-decoration-center) - 8px);
        top: calc(var(--room-avatar-decoration-center) - 8px);
    }

    .mx_RoomAvatarView_PresenceDecoration {
        position: absolute;

        /* Decoration center - (icon size (8px) / 2) */
        left: calc(var(--room-avatar-decoration-center) - 4px);
        top: calc(var(--room-avatar-decoration-center) - 4px);
    }
}
