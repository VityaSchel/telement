/* A context menu that largely fits the | [icon]    [label] | format. */
.mx_IconizedContextMenu {
    min-width: 146px;
    width: max-content;
    /* override default ul styles */
    margin: 0;
    /* Inset the items by 4px from the menu's edge, counting its 1px border: the menu's radius (_ContextualMenu.pcss) is
       an item highlight's radius plus this inset, so the corners are concentric */
    padding: calc(var(--tl-inset-menu) - var(--cpd-border-width-1));

    .mx_IconizedContextMenu_optionList {
        /* Less the inset, so that the content sits 16px from the menu's edge, as in the room menus and Compound's */
        & > * {
            padding-left: var(--cpd-space-3x);
            padding-right: var(--cpd-space-3x);
        }

        .mx_IconizedContextMenu_optionList_label {
            font-size: $font-15px;
            font-weight: var(--cpd-font-weight-semibold);
        }

        /* the notFirst class is for cases where the optionList might be under a header of sorts. */
        &:nth-child(n + 2),
        .mx_IconizedContextMenu_optionList_notFirst {
            border-top: var(--cpd-border-width-1) solid var(--cpd-color-gray-400);
            /* Keep the item highlights the menu padding away from the separator, as from the menu's edge */
            margin-top: var(--tl-inset-menu);
            padding-top: var(--tl-inset-menu);
        }

        .mx_IconizedContextMenu_item {
            /* pad the inside of the button so that the hover background is padded too */
            padding-top: 12px;
            padding-bottom: 12px;
            border-radius: var(--tl-radius-row);
            /* Compact items are 40px rows, as in the room menus and Compound's, with their content centered */
            box-sizing: border-box;
            min-height: var(--cpd-space-10x);
            text-decoration: none;
            color: $primary-content;
            font: var(--cpd-font-body-md-regular);

            /* Create a flexbox to more easily define the list items */
            display: flex;
            align-items: center;

            &:hover,
            &:focus-visible {
                background-color: var(--cpd-color-bg-action-secondary-hovered);
            }

            /* Inside the highlight, so that the ring keeps clear of the menu's border, as far as the highlight does */
            &:focus-visible {
                outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
                outline-offset: calc(-1 * var(--cpd-border-width-2));
            }

            &.mx_AccessibleButton_disabled {
                opacity: 0.5;
                cursor: not-allowed;
            }

            span.mx_IconizedContextMenu_label {
                /* labels */
                width: 100%;
                flex: 1;

                /* Ellipsize any text overflow */
                text-overflow: ellipsis;
                overflow: hidden;
                white-space: nowrap;
            }

            svg {
                width: 16px;
                height: 16px;
                display: block;
                flex-shrink: 0;

                & + .mx_IconizedContextMenu_label {
                    padding-left: var(--cpd-space-3x);
                }
            }

            .mx_BetaCard_betaPill {
                margin-left: 16px;
            }
        }
    }

    .mx_IconizedContextMenu_optionList_red {
        .mx_IconizedContextMenu_item {
            color: $alert !important;
        }

        svg {
            color: var(--cpd-color-icon-critical-primary);
        }
    }

    .mx_IconizedContextMenu_option_red {
        color: $alert !important;

        svg {
            color: $alert;
        }
    }

    .mx_IconizedContextMenu_active {
        &.mx_IconizedContextMenu_item,
        .mx_IconizedContextMenu_item {
            color: $accent !important;

            svg {
                color: $accent;
            }
        }
    }

    &.mx_IconizedContextMenu_compact {
        .mx_IconizedContextMenu_optionList > * {
            padding: var(--cpd-space-2x) var(--cpd-space-3x);
        }
    }

    /* The check is drawn 4.275 of its 24 units inside its box: pulled out by them, it ends where the content of the
       item ends, 16px from the menu's edge */
    svg.mx_IconizedContextMenu_checked {
        margin-inline-start: 16px;
        margin-inline-end: calc(-16px * 4.275 / 24);
    }

    .mx_IconizedContextMenu_sublabel {
        margin-left: 20px;
        color: $tertiary-content;
    }
}

.mx_IconizedContextMenu_item.mx_IconizedContextMenu_itemDestructive {
    color: $alert !important;
}
