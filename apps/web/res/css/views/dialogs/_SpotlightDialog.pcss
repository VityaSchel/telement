.mx_SpotlightDialog_wrapper {
    .mx_Dialog_border {
        /* Disable the glass border as this dialog wasn't designed with it in mind */
        display: contents;
    }

    .mx_Dialog {
        /* !important because it's overriding compound  */
        width: fit-content !important;
        /* Concentric corners: the options' radius plus the padding around them */
        border-radius: var(--tl-radius-surface) !important;
        height: 60% !important;
        overflow-y: initial;
        position: relative;
        padding: 0;
        contain: unset; /* needed for #mx_SpotlightDialog_keyboardPrompt to not be culled */
        clip-path: none; /* likewise */

        #mx_SpotlightDialog_keyboardPrompt {
            position: absolute;
            /* Centres the words and the keys on one line, whatever the font's metrics */
            display: flex;
            align-items: center;
            gap: var(--cpd-space-1-5x);
            padding: var(--cpd-space-2x);
            /* A pill: half its line plus the padding around it */
            border-radius: calc(0.5lh + var(--cpd-space-2x));
            background-color: $background;
            top: -60px; /* relative to the top of the modal */
            left: 50%;
            transform: translateX(-50%);
            font-size: $font-12px;
            /* Whole pixels at every font size, so that the keys and their icons below stay on whole pixels too */
            line-height: round($font-15px, 1px);
            color: $secondary-content;

            kbd {
                /* Square keys as tall as the line and 2px above and below it, with the arrow's icon in the middle.
                   The 2px stay outside the line, so that the keys don't make the box taller */
                display: inline-flex;
                align-items: center;
                justify-content: center;
                vertical-align: top;
                box-sizing: border-box;
                inline-size: calc(1lh + 2 * var(--cpd-space-0-5x));
                block-size: calc(1lh + 2 * var(--cpd-space-0-5x));
                margin-block: calc(-1 * var(--cpd-space-0-5x));
                border-radius: var(--tl-radius-inline);
                background-color: $quinary-content;
                color: $tertiary-content;
                /* To avoid any styling inherent with <kbd> elements */
                font-family: inherit;
                font-weight: inherit;
                font-size: inherit;

                & + kbd {
                    margin-inline-start: var(--cpd-space-0-5x);
                }

                /* As tall as the line, so it sits a whole 2px inside the key on every side. Browsers round an icon
                   that is half a pixel in to a whole pixel, which pushed the arrows right and down */
                > svg {
                    inline-size: 1lh;
                    block-size: 1lh;
                }

                /* The arrow as text, only for the search field's description */
                > span {
                    position: absolute;
                    inline-size: 1px;
                    block-size: 1px;
                    overflow: hidden;
                    clip-path: inset(50%);
                    white-space: nowrap;
                }
            }
        }
    }
}

.mx_SpotlightDialog {
    height: 100%;
    display: flex;
    flex-direction: column;

    .mx_Dialog_header {
        display: none;
    }

    .mx_SpotlightDialog_searchBox {
        margin: 0;
        border: none;
        border-radius: var(--tl-radius-surface) var(--tl-radius-surface) 0 0;
        padding: var(--cpd-space-3x) var(--tl-inset-surface);
        border-bottom: 1px solid $system;

        > .mx_SpotlightDialog_filter {
            display: flex;
            align-content: center;
            align-items: center;
            /* A pill, as chips are, inset from the dialog's edge as the options' highlights are, with its icon where
               their content starts */
            border-radius: var(--tl-radius-control);
            background-color: $quinary-content;
            vertical-align: middle;
            color: $primary-content;
            position: relative;
            /* As tall as the input's line, so that it sits 16px from the dialog's top edge, as from its side */
            padding: 0 var(--cpd-space-2x) 0 37px;
            line-height: $font-24px;

            > svg {
                color: $secondary-content;
                width: 18px;
                height: 18px;
                position: absolute;
                left: var(--cpd-space-2x);
                top: 50%;
                transform: translateY(-50%);
            }

            .mx_SpotlightDialog_filter--close {
                display: inline-block;
                width: 14px;
                height: 14px;
                padding: 1px;
                background: $system;
                border-radius: 8px;
                margin-left: var(--cpd-space-2x);
                text-align: center;
                line-height: 16px;
                color: $secondary-content;

                svg {
                    color: $secondary-content;
                    width: inherit;
                    height: inherit;
                }
            }
        }

        > input {
            display: block;
            box-sizing: border-box;
            background-color: transparent;
            width: 100%;
            height: 32px;
            /* The text starts where the options' content does, 8px inside the edge of their highlights */
            padding: 0 var(--cpd-space-2x);
            color: $tertiary-content;
            font-weight: normal;
            font-size: $font-15px;
            line-height: $font-24px;
        }

        > .mx_Spinner {
            flex-grow: 0;
            width: unset;
            height: unset;
            margin-left: var(--cpd-space-4x);
        }

        &:not(:focus-within) + #mx_SpotlightDialog_content {
            /* Inhibit the styling if focus is not within the input which handles keyboard accessibility */
            --mx_SpotlightDialog_option_selectedBgColor: transparent;

            /* Hide the enter prompt as in this state pressing enter would not actuate that option */
            .mx_SpotlightDialog_enterPrompt {
                visibility: hidden;
            }
        }
    }

    #mx_SpotlightDialog_content {
        height: 100%;
        overflow-y: auto;
        padding: var(--tl-inset-surface);
        /* Clips the scrolled options and the scroll bar to the dialog's corners */
        border-radius: 0 0 var(--tl-radius-surface) var(--tl-radius-surface);
        /* Always-on scroll bars ignore border-radius */
        clip-path: border-box;

        ul {
            padding: 0;
            margin: 0;
        }

        .mx_SpotlightDialog_section {
            > h4,
            > .mx_SpotlightDialog_sectionHeader > h4 {
                font-weight: var(--cpd-font-weight-semibold);
                font-size: $font-12px;
                line-height: $font-15px;
                color: $secondary-content;
                margin: 0;
            }

            /* Headers and hints line up with the options' content, as the search text does */
            > h4,
            .mx_SpotlightDialog_otherSearches_messageSearchText {
                padding-inline: var(--cpd-space-2x);
            }

            > h4 {
                margin-bottom: var(--cpd-space-2x);
            }

            .mx_SpotlightDialog_sectionHeader {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding-inline: var(--cpd-space-2x);
                margin-bottom: var(--cpd-space-2x);

                .mx_SpotlightDialog_options {
                    display: flex;
                    gap: var(--cpd-space-1x);
                }
            }

            & + .mx_SpotlightDialog_section {
                margin-top: var(--cpd-space-6x);
            }
        }

        .mx_SpotlightDialog_option {
            border-radius: var(--tl-radius-row);
            overflow: hidden;
            text-overflow: ellipsis;

            &:hover,
            &[aria-selected="true"] {
                background-color: var(--mx_SpotlightDialog_option_selectedBgColor, $quinary-content);
            }
        }

        .mx_SpotlightDialog_recentlyViewed {
            > div {
                display: flex;
                white-space: nowrap;
                overflow-x: hidden;
                margin-right: 1px; /* occlude the 1px visible of the very next tile to prevent it looking broken */
            }

            /* The avatar 8px from the tile's top, as in the other options, and the name 8px from its bottom */
            .mx_SpotlightDialog_option {
                padding: var(--cpd-space-2x) var(--cpd-space-1x);
                color: $primary-content;
                font-size: $font-12px;
                line-height: $font-15px;
                display: inline-block;
                width: 58px;
                height: auto;
                min-width: 58px;
                box-sizing: border-box;
                text-align: center;

                .mx_DecoratedRoomAvatar {
                    margin: 0 9px var(--cpd-space-1x); /* maintain centering */
                }

                & + .mx_SpotlightDialog_option {
                    margin-left: var(--cpd-space-4x);
                }
            }
        }

        .mx_SpotlightDialog_results,
        .mx_SpotlightDialog_recentSearches,
        .mx_SpotlightDialog_otherSearches,
        .mx_SpotlightDialog_hiddenResults {
            .mx_SpotlightDialog_option {
                --mx_SpotlightDialog_option_selectedBgColor: $system;

                /* As far from the sides as a 24px avatar is from the top and bottom of the 40px row */
                padding: var(--cpd-space-2x);
                font-size: $font-15px;
                line-height: $font-24px;
                color: $primary-content;
                position: relative;
                display: flex;
                align-items: center;
                white-space: nowrap;

                .mx_SpotlightDialog_option--endAdornment {
                    display: inline-flex;
                    flex-direction: row;
                    margin-left: auto;
                    align-items: flex-start;
                }

                &.mx_SpotlightDialog_result_multiline {
                    align-items: flex-start;

                    .mx_AccessibleButton {
                        padding: var(--cpd-space-1x) var(--cpd-space-5x);
                        /* Ends where the other options' last key or button does, at the option's padding */
                        margin: 2px 0 2px var(--cpd-space-1x);
                    }

                    .mx_SpotlightDialog_enterPrompt {
                        margin-top: 9px;
                        margin-right: var(--cpd-space-2x);
                    }
                }

                .mx_SpotlightDialog_result_name {
                    min-width: 0;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                > .mx_SpotlightDialog_metaspaceResult,
                > .mx_DecoratedRoomAvatar,
                > .mx_BaseAvatar {
                    margin-right: var(--cpd-space-2x);
                    width: 24px;
                    height: 24px;
                    flex-shrink: 0;

                    .mx_BaseAvatar {
                        width: inherit;
                        height: inherit;
                    }
                }

                .mx_SpotlightDialog_result_publicRoomDetails {
                    display: flex;
                    flex-direction: column;
                    flex-grow: 1;
                    min-width: 0;

                    .mx_SpotlightDialog_result_publicRoomHeader {
                        display: flex;
                        flex-direction: row;
                        line-height: $font-24px;
                        margin-right: var(--cpd-space-2x);

                        .mx_SpotlightDialog_result_publicRoomName {
                            color: $primary-content;
                            font-size: $font-15px;
                            overflow: hidden;
                            text-overflow: ellipsis;
                        }
                        .mx_SpotlightDialog_result_publicRoomAlias {
                            /* $secondary-content, not $tertiary-content: at 12px this has to meet WCAG AA
                               (4.5:1) against the dialog background, and tertiary is 3.5:1 in the light
                               and dark themes. */
                            color: $secondary-content;
                            font-size: $font-12px;
                            margin-left: var(--cpd-space-2x);
                            overflow: hidden;
                            text-overflow: ellipsis;
                        }
                    }
                    .mx_SpotlightDialog_result_publicRoomDescription {
                        color: $secondary-content;
                        font-size: $font-12px;
                        white-space: normal;
                        word-wrap: break-word;
                        line-height: $font-20px;
                        display: -webkit-box;
                        -webkit-box-orient: vertical;
                        -webkit-line-clamp: 3;
                        overflow: hidden;
                    }
                }

                .mx_SpotlightDialog_notificationBadge {
                    margin-left: var(--cpd-space-2x);
                }

                .mx_SpotlightDialog_option--menu {
                    width: 16px;
                    height: 16px;
                    padding: var(--cpd-space-0-5x);
                    flex-shrink: 0;
                    margin-top: auto;
                    margin-bottom: auto;
                    position: relative;
                    display: none;

                    svg {
                        width: inherit;
                        height: inherit;
                        display: block;
                        color: $tertiary-content;
                    }

                    &:hover svg,
                    &:focus-visible svg {
                        color: $secondary-content;
                    }

                    /* The open menu stays with its button when the pointer leaves the result */
                    &[aria-expanded="true"] {
                        display: block;
                    }
                }

                &:hover,
                &[aria-selected="true"] {
                    .mx_SpotlightDialog_option--menu {
                        display: block;
                    }

                    /* $secondary-content is legible at rest but only 4.2:1 against the hover
                       background ($quinary-content), so step up to $primary-content to keep WCAG AA. */
                    .mx_SpotlightDialog_result_publicRoomDetails {
                        .mx_SpotlightDialog_result_publicRoomHeader .mx_SpotlightDialog_result_publicRoomAlias,
                        .mx_SpotlightDialog_result_publicRoomDescription {
                            color: $primary-content;
                        }
                    }
                }

                &[aria-selected="true"] .mx_SpotlightDialog_enterPrompt {
                    display: inline-block;
                }
            }
        }

        .mx_SpotlightDialog_inviteLink,
        .mx_SpotlightDialog_createRoom {
            margin-top: var(--cpd-space-2x);

            .mx_AccessibleButton {
                position: relative;
                margin: 0;
                padding: 3px var(--cpd-space-2x) 3px var(--cpd-space-7x);

                svg {
                    display: block;
                    position: absolute;
                    left: var(--cpd-space-2x);
                    width: 16px;
                    height: 16px;
                    color: var(--cpd-color-icon-primary);
                }
            }
        }

        .mx_SpotlightDialog_otherSearches {
            .mx_SpotlightDialog_option {
                /* The icon where the other options' avatars are, with as much space after it */
                padding-left: var(--cpd-space-10x);
                position: relative;

                svg {
                    color: $secondary-content;
                    width: 24px;
                    height: 24px;
                    position: absolute;
                    left: var(--cpd-space-2x);
                    top: 50%;
                    transform: translateY(-50%);
                }
            }

            .mx_SpotlightDialog_otherSearches_messageSearchText {
                font-size: $font-15px;
                line-height: $font-24px;
            }
        }

        .mx_SpotlightDialog_result_details {
            margin-left: var(--cpd-space-2x);
            margin-right: var(--cpd-space-2x);
            /* See .mx_SpotlightDialog_result_publicRoomAlias: 12px text needs 4.5:1 at rest too. */
            color: $secondary-content;
            font-size: $font-12px;
            line-height: $font-15px;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .mx_SpotlightDialog_recentSearches > h4 > .mx_AccessibleButton_kind_link {
            float: right;
            font-size: $font-12px;
            line-height: $font-15px;
            color: $secondary-content;
        }

        .mx_SpotlightDialog_enterPrompt {
            padding: 2px var(--cpd-space-1x);
            /* To avoid any styling inherent with <kbd> elements */
            font-family: inherit;
            font-weight: inherit;
            font-size: $font-12px;
            line-height: $font-15px;
            color: $tertiary-content;
            border-radius: var(--tl-radius-inline);
            background-color: $quinary-content;
            margin-right: var(--cpd-space-1x);
            display: none;

            /* Without buttons after it, it ends at the option's padding, as they do */
            &:last-child {
                margin-right: 0;
            }
        }

        .mx_SpotlightDialog_metaspaceResult svg {
            color: $secondary-content;
            width: inherit;
            height: inherit;
        }
    }
}
