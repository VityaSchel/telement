.mx_UnpinAllDialog {
    /* Telement: a 400px confirmation, with the dialog's 24px padding (TELEMENT.md, "Colors, type and components") */
    width: calc(400px - 2 * var(--cpd-space-6x));

    /* Telement: every dialog title is heading-sm now (_common.pcss), on the close button's line */
    .mx_UnpinAllDialog_title {
        margin-bottom: var(--cpd-space-3x);
    }
}
