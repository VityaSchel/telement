.mx_UnpinAllDialog {
    /* 396 is coming from figma and we remove the left and right paddings of the dialog */
    width: calc(396px - (var(--cpd-space-6x) * 2));

    /* Telement: every dialog title is heading-sm now (_common.pcss), on the close button's line */
    .mx_UnpinAllDialog_title {
        margin-bottom: var(--cpd-space-3x);
    }
}
