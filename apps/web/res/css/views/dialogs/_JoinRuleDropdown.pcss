.mx_JoinRuleDropdown {
    margin-bottom: 8px;
    font: var(--cpd-font-body-md-regular);
    color: $primary-content;

    .mx_Dropdown_option {
        font: var(--cpd-font-body-md-regular);
        line-height: $font-32px;
        height: 32px;
        min-height: 32px;

        > div {
            svg {
                width: 16px;
                height: 16px;
                color: $secondary-content;
                /* Centered on the line, in the option's text inset with the label 8px after it */
                vertical-align: top;
                margin-block: calc((1lh - 16px) / 2);
                margin-inline-end: var(--cpd-space-2x);
            }

            &.mx_JoinRuleDropdown_knock::before {
                content: normal;
            }
        }
    }

    .mx_JoinRuleDropdown_icon {
        color: $secondary-content;
        position: absolute;
        left: 6px;
        top: 8px;
    }
}
