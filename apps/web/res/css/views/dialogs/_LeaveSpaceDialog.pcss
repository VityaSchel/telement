.mx_LeaveSpaceDialog_wrapper {
    .mx_Dialog {
        display: flex;
        flex-direction: column;

        /* Telement: a 480px form on the dialog's 24px edge (TELEMENT.md, "Colors, type and components"), as tall as
           its content. A long list of rooms to leave scrolls between the title and the footer */
        .mx_LeaveSpaceDialog {
            width: calc(480px - 2 * var(--cpd-space-6x));
            max-width: 100%;
            min-height: 0;
            display: flex;
            flex-direction: column;
            flex-wrap: nowrap;

            .mx_Dialog_content {
                flex-grow: 1;
                /* 16px under the title together with the header's 8px margin, which this column doesn't collapse
                   into its own, and the footer's own 24px above the buttons */
                margin: var(--cpd-space-2x) 0 0;
                overflow-y: auto;

                /* The content scrolls, so the margins of its first and last lines would add to the space around it */
                > :first-child {
                    margin-top: 0;
                }

                > :last-child {
                    margin-bottom: 0;
                }

                /* Telement: a 13px note with the icon on its first line and the lines after it indented past it */
                .mx_LeaveSpaceDialog_section_warning {
                    display: flex;
                    gap: var(--cpd-space-1x);
                    border-radius: 8px;
                    margin: 12px 0 0;
                    padding: var(--cpd-space-3x);
                    background-color: $header-panel-bg-color;

                    font: var(--cpd-font-body-sm-regular);
                    color: $secondary-content;

                    svg {
                        flex-shrink: 0;
                        height: 16px;
                        width: 16px;
                        color: $secondary-content;
                        margin-block-start: calc((1lh - 16px) / 2);
                    }
                }

                > p {
                    color: $primary-content;
                }
            }
        }
    }
}
