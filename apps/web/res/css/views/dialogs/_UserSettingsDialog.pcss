.mx_SettingsDialog_toastContainer {
    position: absolute;
    bottom: var(--cpd-space-10x);
    width: 100%;
    display: flex;
    justify-content: center;
}

/* Telement: the dialog title's size and line (_common.pcss), with only the tab's name in regular weight */
.mx_Dialog_header > .mx_UserSettingsDialog_title {
    font-weight: var(--cpd-font-weight-regular);

    .mx_UserSettingsDialog_title_strong {
        font-weight: var(--cpd-font-weight-semibold);
    }
}
