/* Not actually a component but things shared by settings components */
.mx_UserSettingsDialog,
.mx_RoomSettingsDialog,
.mx_SpaceSettingsDialog,
.mx_SpacePreferencesDialog {
    width: 90vw;
    /* Telement: 980px with the dialog's 24px padding (TELEMENT.md, "Colors, type and components") */
    max-width: calc(980px - 2 * var(--cpd-space-6x));
    /* set the height too since tabbed view scrolls itself. */
    height: 80vh;

    /* Telement: the tabs and their panel start 16px under the title's line at every font size, as a dialog's content
       does (_common.pcss), their 8px top margin included. The tabs' icons sit 8px inside their pills, on the title's
       24px edge */
    .mx_TabbedView {
        top: calc(var(--cpd-space-4x) + var(--dialog-title-line-height) + var(--cpd-space-4x) - var(--cpd-space-2x));
        padding-inline-start: calc(var(--cpd-space-6x) - var(--cpd-space-2x));
    }

    /* Telement: the tab's content sits on Telegram's gray settings pane (_common.pcss), which runs from the tabs' top to
       the dialog's end and bottom edges. It starts 16px before the content's edge, so that the cards start on that edge
       and their content 16px in, and its corner by the tabs is rounded like the cards */
    .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabPanel {
        margin-inline-start: calc(280px - var(--cpd-space-4x));
        background-color: var(--tl-color-bg-settings-pane);
        border-start-start-radius: var(--tl-radius-bubble);
        overflow: hidden;
    }

    .mx_TabbedView .mx_SettingsTab {
        box-sizing: border-box;
        min-width: 580px;
        /* Telement: the content ends on the dialog's 24px edges, at its end and bottom, and starts 16px inside the pane.
           The pane runs to the dialog's bottom edge, so upstream's 100px under the content isn't needed to keep it off
           that edge, and only made tabs that fit scroll */
        padding-block: var(--cpd-space-4x) var(--cpd-space-6x);
        padding-inline: var(--cpd-space-4x) var(--cpd-space-6x);
        display: flex;
        flex-direction: column;
    }

    /* Telement: the tab's 24px bottom edge is the only space under the content */
    .mx_TabbedView .mx_SettingsTab_sections {
        padding-block-end: 0;
    }

    .mx_SettingsDialog_tabLabelsAlert::after {
        display: inline-block;
        content: "";
        width: 8px;
        height: 8px;
        background-color: var(--cpd-color-icon-critical-primary);
        clip-path: circle(4px);
        position: absolute;
        right: var(--cpd-space-4x);
    }

    /* Red would hardly stand out on the selected tab's plate, so the dot is white there, as the room list's badges are
       on the selected room */
    .mx_TabbedView_tabLabel_active.mx_SettingsDialog_tabLabelsAlert::after {
        background-color: var(--tl-color-on-selection);
    }
}

/* On narrow viewports, the tab labels are hidden, so we need to shift the indicator so it isn't over the tab icon. */
@media (max-width: 1024px) {
    .mx_UserSettingsDialog,
    .mx_RoomSettingsDialog,
    .mx_SpaceSettingsDialog,
    .mx_SpacePreferencesDialog {
        .mx_SettingsDialog_tabLabelsAlert::after {
            right: var(--cpd-space-1x);
            top: var(--cpd-space-1x);
        }

        /* Telement: the pane keeps 16px before the content when the tabs are only their icons (_TabbedView.pcss) */
        .mx_TabbedView_tabsOnLeft.mx_TabbedView_responsive .mx_TabbedView_tabPanel {
            margin-inline-start: calc(var(--tl-control-size) + var(--cpd-space-8x) - var(--cpd-space-4x));
        }
    }
}
