.mx_LogoutDialog {
    /* Telement: a 400px confirmation, with the dialog's 24px padding (TELEMENT.md, "Colors, type and components") */
    width: calc(400px - 2 * var(--cpd-space-6x));

    .mx_EncryptionCard {
        gap: 0;
        h2 {
            text-align: center;
            color: var(--cpd-color-text-primary);
        }
        .mx_EncryptionCard_emphasisedContent {
            text-align: center;
            margin-top: var(--cpd-space-2x);
            /* Telement: the footer (.mx_Dialog_buttons) keeps its labels 24px under the text, as in every dialog */
            margin-bottom: 0;
            p {
                margin: 0;
            }
        }
    }
}
