.mx_CreateRoomDialog_details {
    margin-top: 15px;

    /* Telement: a disclosure button, in the accent and without the underline, as standalone text buttons are
       (TELEMENT.md, "Radius and spacing"), its chevron after the label turning up while the details are open */
    .mx_CreateRoomDialog_details_summary {
        list-style: none;
        display: flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        font-weight: var(--cpd-font-weight-semibold);
        cursor: pointer;
        color: var(--cpd-color-text-action-accent);
        width: fit-content;

        /* list-style doesn't do it for webkit */
        &::-webkit-details-marker {
            display: none;
        }

        &:not(:focus-visible) {
            outline: none;
        }
    }

    .mx_CreateRoomDialog_details_chevron {
        flex-shrink: 0;
        inline-size: 20px;
        block-size: 20px;
        transition: transform 0.1s linear;
    }

    &[open] .mx_CreateRoomDialog_details_chevron {
        transform: rotate(180deg);
    }

    > div {
        display: flex;
        align-items: flex-start;
        margin: 5px 0;

        input[type="checkbox"] {
            margin-right: 10px;
        }
    }
}

.mx_CreateRoomDialog_label {
    text-align: left;
    padding-bottom: 12px;
}

.mx_CreateRoomDialog_input_container {
    padding-right: 20px;
}

.mx_CreateRoomDialog_input {
    font-size: $font-15px;
    border-radius: 3px;
    border: 1px solid $input-border-color;
    padding: 9px;
    color: $primary-content;
    background-color: $background;
    width: 100%;
}

.mx_CreateRoomDialog {
    /* Telement: a form dialog, 480px with the dialog's 24px padding (TELEMENT.md, "Colors, type and components"). The
       footer keeps the 24px every dialog has above its buttons (_common.pcss) */
    &.mx_Dialog_fixedWidth {
        width: calc(480px - 2 * var(--cpd-space-6x));
    }

    /* Telement: the one secondary text color, rather than the legacy blue-gray */
    p,
    .mx_Field_input label {
        color: var(--cpd-color-text-secondary);
    }

    .mx_SettingsFlag {
        display: flex;
    }

    .mx_SettingsFlag_label {
        flex: 1 1 0;
        min-width: 0;
        font-weight: var(--cpd-font-weight-semibold);
    }

    .mx_ToggleSwitch {
        flex: 0 0 auto;
        margin-left: 30px;
    }

    .mx_Dialog_content > .mx_SettingsFlag {
        margin-top: 24px;
    }

    .mx_Field {
        margin: 0;
    }

    form {
        gap: var(--cpd-space-4x);
    }

    /* Telement: help text across the fields' width, in the size of a toggle's description */
    p {
        margin: 0;
        font: var(--cpd-font-body-sm-regular);
    }
}

.mx_CreateRoomDialog_labelledCheckbox {
    color: $muted-fg-color;
    margin-top: var(--cpd-space-6x);
}
