/* The flag starts where the option's text would, and the code or the name follows it on the 4px grid */
.mx_CountryDropdown .mx_Dropdown_option .mx_Dropdown_option_emoji {
    margin-inline: 0 var(--cpd-space-2x);
}

.mx_CountryDropdown_shortOption {
    display: inline-flex;
    align-items: center;
    height: 100%;
}

.mx_CountryDropdown_option {
    display: flex;
    align-items: center;
}
