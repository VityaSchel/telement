.mx_FontScalingPanel_preview {
    --FontScalingPanel_preview-padding-block: 9px;

    /* Telement: outlined in Compound's separator, which a dark theme's raised dialogs (_common.pcss) move a step further,
       as they do the dialog's other lines, and rounded like the layout cards and theme chips above it */
    border: 1px solid var(--cpd-color-separator-primary);
    border-radius: var(--tl-radius-row);
    padding: 0 var(--cpd-space-4x) var(--FontScalingPanel_preview-padding-block) var(--cpd-space-4x);
    pointer-events: none;
    display: flow-root;

    /* Telement: a bubble sits as far from the card's top and bottom as its tail does from the card's end */
    &:has([data-event-layout="bubble"]) {
        padding-block: var(--cpd-space-4x);
    }

    &.mx_IRCLayout {
        padding-top: 9px;
    }

    .mx_ReadReceiptGroup {
        display: none;
    }

    /* Telement: the message is the last of its run, for a bubble's rounded corners, but the space under it is the
       card's padding, not the gap the timeline leaves after a run */
    .mx_EventTile {
        margin-block-end: 0;
    }

    /* Telement: your own bubble sits at the card's end, as your messages do in the timeline, with its tail ending at
       the card's padding. The timeline's column for read receipts has no place here, and the space above the bubble is
       the card's padding, not the gap between runs. The fallback, the tail's width, is for stylelint, which doesn't
       read the tile's own variables. */
    .mx_EventTile:has([data-event-layout="bubble"]) {
        margin-block-start: 0;
        margin-inline-end: 0;

        .mx_EventTile_line {
            margin-inline-end: var(--event-tile-bubble-tail-width, var(--cpd-space-1-5x));
        }
    }
}
