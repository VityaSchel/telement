.mx_FontScalingPanel_preview {
    @mixin settingsGroupBox;
    @mixin settingsMessagePreview;
    /* Telement: outlined in Compound's separator, which a dark theme's raised dialogs (_common.pcss) move a step further,
       as they do the dialog's other lines, rounded like the layout cards above it and padded as their previews are, so
       that the messages line up */
    border: 1px solid var(--cpd-color-separator-primary);
    border-radius: var(--tl-radius-row);
    padding: var(--cpd-space-3x);
    display: flow-root;
}
