.mx_LayoutSwitcher_LayoutSelector {
    @mixin settingsGroupBox;
    display: flex;
    flex-direction: column;
    /**
     * The settings form has a default gap of 10px
     * We want to have a bigger gap between the layout options
     */
    gap: var(--cpd-space-4x) !important;

    .mxLayoutSwitcher_LayoutSelector_LayoutRadio {
        @mixin choiceCard;
        /* Telement: Compound's outline gray, as on the theme chips, 3:1 or more against the card in every theme, and
           the accent ring around the selected layout */
        border: 1px solid var(--cpd-color-border-interactive-primary);
        border-radius: var(--tl-radius-row);

        &:has(input:checked) {
            @mixin selectedChoiceRing;
        }

        .mxLayoutSwitcher_LayoutSelector_LayoutRadio_inline {
            display: flex;
            /* Telement: the label 12px after the radio, as on the theme chips and every other radio */
            gap: var(--cpd-space-3x);
            align-items: center;
            /* Telement: a 44px header like the theme chips (_ThemeChoicePanel.pcss), its 1px separator included, with
               the radio 12px from the card's top and start, its 1px border included. The row is as tall as the radio,
               so the label's taller line doesn't push it down */
            margin: calc(var(--cpd-space-3x) - 1px);
            block-size: 20px;
        }

        .mxLayoutSwitcher_LayoutSelector_LayoutRadio_EventTilePreview {
            @mixin settingsMessagePreview;
            margin: var(--cpd-space-3x);
        }

        .mxLayoutSwitcher_LayoutSelector_LayoutRadio_separator {
            border-top: 0;
            border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);
        }
    }
}
