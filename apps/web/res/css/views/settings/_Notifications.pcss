/* Telement: the grid spans its card's content, on its 16px edges (_common.pcss), rather than reaching 12px past the end
   to line up with toggles that are no longer at the end of their rows */
.mx_UserNotifSettings_grid {
    width: 100%;
    display: grid;
    grid-template-columns: auto repeat(3, 62px);
    place-items: center center;
    gap: 8px;

    /* Override StyledRadioButton default styles */
    .mx_StyledRadioButton {
        justify-content: center;

        .mx_StyledRadioButton_content {
            display: none;
        }

        .mx_StyledRadioButton_spacer {
            display: none;
        }
    }
}

.mx_UserNotifSettings_gridRowContainer {
    display: contents;
}

/* Telement: a toggle that only applies while the one above it is on sits 24px in under it, as Show all rooms sits
   under Home in the Sidebar tab */
.mx_UserNotifSettings_dependentToggle {
    margin-inline-start: var(--cpd-space-6x);
}

.mx_UserNotifSettings_gridRow {
    display: contents;
}

.mx_UserNotifSettings_gridRowLabel {
    padding-inline: unset; /* Remove default legend padding */
    justify-self: start;
    /* <legend> does not accept */
    /* display: inline | inline-block */
    /* force it inline using float */
    float: left;
}

.mx_UserNotifSettings_gridColumnLabel {
    color: $secondary-content;
    font: var(--cpd-font-body-sm-semibold);

    /* Telement: the section's name is its group's label above the card, so the column names start the card's first
       row over their columns */
    &:first-child {
        grid-column-start: 2;
    }
}
.mx_UserNotifSettings_gridRowError {
    /* occupy full row */
    grid-column: 1/-1;
    justify-self: start;
    padding-right: 30%;
    /* collapse half of the grid-gap */
    margin-top: calc(-1 * var(--cpd-space-1x));
}

.mx_UserNotifSettings_floatingSection {
    margin-top: 40px;

    & > div:first-child {
        /* section header */
        font-size: $font-18px;
        font-weight: var(--cpd-font-weight-semibold);
    }

    > table {
        border-collapse: collapse;
        border-spacing: 0;
        margin-top: 8px;

        tr > td:first-child {
            /* Just for a bit of spacing */
            padding-right: 8px;
        }
    }
}

.mx_TagComposer {
    margin-top: 35px; /* lots of distance from the last line of the table */

    /* Telement: on the Mentions and keywords card, the card's 16px gap alone separates the keyword field from the table */
    .mx_UserNotifSettings_grid + & {
        margin-top: 0;
    }
}

.mx_AccessibleButton.mx_NotificationSound_browse {
    margin-right: 10px;
}
