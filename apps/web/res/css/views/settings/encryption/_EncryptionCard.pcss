.mx_EncryptionCard {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-8x);
    padding: var(--cpd-space-10x);
    border-radius: var(--cpd-space-4x);
    /* From figma */
    box-shadow: 0 1.2px 2.4px 0 rgb(27, 29, 34, 0.15);
    border: 1px solid var(--cpd-color-gray-400);

    .mx_EncryptionCard_header {
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-4x);
        align-items: center;

        > h2 {
            margin: 0;
        }

        > span {
            color: var(--cpd-color-text-secondary);
            text-align: center;
        }
    }

    /* extra class for specifying that we don't need a border */
    &.mx_EncryptionCard_noBorder {
        border: 0px none;
        box-shadow: none;
        padding: 0px;
    }

    /* Telement: the auth dialog's cross-signing step starts 16px under the dialog's title, as a dialog's content does */
    .mx_InteractiveAuthDialog & {
        margin-block-start: var(--cpd-space-4x);
    }

    /* Telement: in the Encryption settings tab, the card is one of the tab's cards on its gray pane (_common.pcss), with
       their fill and 12px corners, rather than a bordered and shadowed card of its own that the pane showed through. It
       holds a hero card's content and footer rather than rows, so it keeps them on the 24px edges a dialog does */
    .mx_EncryptionUserSettingsTab &:not(.mx_EncryptionCard_noBorder) {
        @mixin settingsGroupCard;
        border: none;
        box-shadow: none;
        padding: var(--cpd-space-6x);
    }
}

/* Telement: the shared dialog footer (DialogFooterView), which lays out its own buttons. Its labels are 24px under the
   content, less the gap of the card, or of the form in it, which is as wide */
.mx_EncryptionCard_buttons {
    margin-block-start: calc(var(--cpd-space-6x) - var(--cpd-space-8x));
}
