.mx_EncryptionDetails,
.mx_OtherSettings {
    display: flex;
    flex-direction: column;
    /* !important override compound form */
    gap: var(--cpd-space-6x) !important;
    width: 100%;
    align-items: start;

    /* Telement: a label inside the Advanced card, like a fieldset's in a settings group (_SettingsFieldset.pcss), with
       no line under it */
    .mx_EncryptionDetails_session_title,
    .mx_OtherSettings_title {
        @mixin settingsGroupLabel;
        margin: 0;
        padding: 0;
        width: 100%;
    }
}

.mx_EncryptionDetails {
    /* Telement: the session's ID and key are a table of rows drawn as a menu's rows are: each row reaches 4px from the
       card's edge, rounded concentrically with it, and pads its text back onto the card's 16px content edge, 8px above
       and below. Every other row is filled with the card's subtle gray, which upstream's gray 200 hardly differed from */
    .mx_EncryptionDetails_session {
        display: flex;
        flex-direction: column;
        width: 100%;

        > .mx_EncryptionDetails_session_title {
            margin-block-end: var(--cpd-space-2x);
        }

        > div {
            display: flex;
            margin-inline: calc(var(--tl-inset-menu) - var(--cpd-space-4x));
            padding: var(--cpd-space-2x) calc(var(--cpd-space-4x) - var(--tl-inset-menu));
            border-radius: var(--tl-radius-row);

            > span {
                width: 50%;
                word-wrap: break-word;
            }
        }

        > div:nth-child(odd) {
            background-color: var(--cpd-color-bg-subtle-secondary);
        }
    }

    .mx_EncryptionDetails_buttons {
        display: flex;
        gap: var(--cpd-space-4x);
    }
}
