.mx_SettingsFieldset {
    /* Reset the browser default <fieldset> styling */
    display: inline-block;
    margin-inline: unset;
    padding-block: unset;
    padding-inline: unset;
    min-inline-size: unset;
    border: none;
    box-sizing: content-box;
}

/* Telement: a fieldset is a group of settings like a subsection: its legend a label above its card and its description
   help under it (_common.pcss). Inside another group's card it keeps the label and the help, without a card of its own */
.mx_SettingsFieldset_legend {
    @mixin settingsGroupLabel;
    /* Reset the browser default <legend> styling */
    border: none;
    display: block;
}

.mx_SettingsFieldset_description {
    @mixin settingsGroupHelp;
    display: block;

    p {
        margin-top: var(--cpd-space-2x);
        margin-bottom: 0;

        &:first-child {
            margin: 0;
        }
    }
}

.mx_SettingsFieldset_content {
    @mixin settingsGroupCard;
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);

    /* Fields one under another, such as the power level selectors, are 16px apart, as elsewhere (_Field.pcss), so a
       floated label keeps clear of the field above. The Roles tab wraps each selector twice, and its user search is
       a field of its own */
    > :is(.mx_Field, :has(.mx_Field), .mx_AutocompleteInput) + :is(.mx_Field, :has(.mx_Field)) {
        margin-top: calc(var(--cpd-space-4x) - var(--cpd-space-2x));
    }

    /* Radios one under another, such as who can read the history, are 12px apart, as Compound's radios are in a list
       (Show media in timeline) */
    > .mx_StyledRadioButton + .mx_StyledRadioButton {
        margin-top: calc(var(--cpd-space-3x) - var(--cpd-space-2x));
    }
}

:is(.mx_SettingsSubsection_content, .mx_SettingsFieldset_content) .mx_SettingsFieldset_content {
    background-color: transparent;
    border-radius: 0;
    padding: 0;
    outline: none;
}
