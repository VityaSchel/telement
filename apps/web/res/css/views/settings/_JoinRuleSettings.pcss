.mx_JoinRuleSettings_upgradeRequired {
    margin-left: 16px;
    padding: 4px 16px;
    border: 1px solid $accent;
    border-radius: 8px;
    color: $accent;
    font-size: $font-12px;
    line-height: $font-15px;
}

.mx_JoinRuleSettings_spacesWithAccess {
    > h4 {
        color: $secondary-content;
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-12px;
        line-height: $font-15px;
        text-transform: uppercase;
    }

    > span {
        font: var(--cpd-font-body-md-medium);
        line-height: 32px; /* matches height of avatar for v-align */
        color: $secondary-content;
        display: inline-block;

        .mx_BaseAvatar {
            margin-right: 8px;
        }

        & + span {
            margin-left: 16px;
        }
    }
}

/* Telement: each option is a row 16px above its label and below its description, the label 12px after the 20px
   radio and the description under the label, 4px below it in the size and color of a toggle's description. The rows
   space themselves, so a fieldset's gap between its items (_SettingsFieldset.pcss) doesn't come between a label and its
   description, or under a description before the separator */
.mx_SettingsFieldset_content:has(> .mx_JoinRuleSettings_radioButton) {
    gap: 0;
}

.mx_JoinRuleSettings_radioButton {
    padding-top: 16px;

    .mx_StyledRadioButton_content {
        margin-inline-start: var(--cpd-space-3x);
        font: var(--cpd-font-body-md-semibold);
        color: $primary-content;
        display: block;
    }

    &.mx_StyledRadioButton_disabled {
        opacity: 0.5;
    }

    &.mx_StyledRadioButton_disabled + span {
        opacity: 0.5;
    }

    & + span {
        display: block;
        margin-inline-start: calc(20px + var(--cpd-space-3x));
        margin-top: var(--cpd-space-1x);
        padding-bottom: var(--cpd-space-4x);
        font: var(--cpd-font-body-sm-regular);
        color: $secondary-content;

        & + .mx_StyledRadioButton {
            /* Telement: Compound's separator rather than a fixed gray, so that a dark theme's raised dialogs
               (_common.pcss) move it a step further, as they do their other separators */
            border-top: 1px solid var(--cpd-color-separator-primary);
        }
    }
}

.mx_JoinRuleSettings_labelledCheckbox {
    font: var(--cpd-font-body-md-regular);
    margin-top: var(--cpd-space-2x);
}

.mx_JoinRuleSettings_recommended {
    color: $accent-1000;
}
