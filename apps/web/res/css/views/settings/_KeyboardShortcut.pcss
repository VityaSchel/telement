/* Telement: flat keys like the search dialog's (_SpotlightDialog.pcss), in the app's font rather than the browser's
   monospace: 24px tiles rounded as inline elements, in the subtle fill that raised dialogs move a step further
   (_common.pcss) */
.mx_KeyboardShortcut {
    kbd {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        min-inline-size: var(--cpd-space-6x);
        block-size: var(--cpd-space-6x);
        padding: 0 var(--cpd-space-2x);
        border-radius: var(--tl-radius-inline);
        background-color: var(--cpd-color-bg-subtle-primary);
        color: $secondary-content;
        font: var(--cpd-font-body-sm-medium);
        text-transform: capitalize;

        /* An arrow key is a square 24px tile around Compound's 16px arrow, as a one-letter key is */
        &:has(> svg) {
            padding: 0;
            inline-size: var(--cpd-space-6x);
        }
    }
}

/* The arrow as text, for screen readers and copying only (KeyboardShortcut.tsx) */
.mx_KeyboardKey_text {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
}
