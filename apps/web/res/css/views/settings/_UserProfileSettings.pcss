/* Telement: on its section's card (_SettingsSection.pcss), with no line under it and its rows 16px apart, as a
   subsection's are */
.mx_UserProfileSettings {
    h2 {
        margin: var(--cpd-space-4x) 0;
    }

    .mx_UserProfileSettings_profile {
        display: flex;
        margin-top: var(--cpd-space-4x);
        gap: 16px;

        .mx_UserProfileSettings_profile_displayName {
            flex-grow: 0;
            width: 100%;
            gap: 0;
        }
        .mx_UserProfileSettings_profile_nameAndStatus {
            width: 100%;
            /* Override the default of min-width: auto to allow max-width: 100% to bound correctly */
            min-width: 0;
            gap: 16px;
        }
    }

    .mx_UserProfileSettings_profile_controls {
        flex-grow: 1;
    }

    /* Telement: a copy field with its label floated on the border (_CopyableText.pcss), 16px under the profile as
       fields are under each other */
    .mx_UserProfileSettings_profile_controls_userId {
        width: 100%;
        margin-top: var(--cpd-space-4x);
        .mx_CopyableText {
            width: 100%;
            box-sizing: border-box;
        }
    }

    .mx_UserProfileSettings_profile_buttons {
        margin-top: var(--cpd-space-4x);
    }

    .mx_UserProfileSettings_accountmanageIcon {
        margin-right: var(--cpd-space-2x);
    }

    /* Telement: the red Remove this device row (ActionRowView) ends the card, 16px under what is above it as the
       card's other rows are; its hover fill reaches 4px from the card's bottom edge, as at its sides */
    .mx_UserProfileSettings_signOut {
        margin-block: var(--cpd-space-4x) calc(var(--tl-inset-menu) - var(--cpd-space-3x));
    }
}

@media (max-width: 768px) {
    .mx_UserProfileSettings_profile {
        flex-direction: column;
        align-items: center;
        gap: 30px;
    }
}
