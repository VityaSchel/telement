/* Telement: on its section's card (_SettingsSection.pcss), with no line under it and its rows 16px apart, as a
   subsection's are */
.mx_UserProfileSettings {
    h2 {
        margin: var(--cpd-space-4x) 0;
    }

    .mx_UserProfileSettings_profile {
        @mixin settingsProfile;

        .mx_UserProfileSettings_profile_displayName {
            flex-grow: 0;
            width: 100%;
            gap: 0;
        }
        .mx_UserProfileSettings_profile_nameAndStatus {
            gap: var(--cpd-space-4x);
        }
    }

    /* Telement: the Matrix ID is the display name's second line, as Telegram puts a username under a name: 13px
       secondary text 4px under the field, which starts on its edge, then its copy button. A long ID breaks rather than
       running past the card. */
    .mx_UserProfileSettings_username {
        margin-block-start: calc(var(--cpd-space-1x) - var(--cpd-space-4x));
        font: var(--cpd-font-body-sm-regular);
        letter-spacing: var(--cpd-font-letter-spacing-body-sm);
        color: var(--cpd-color-text-secondary);
        overflow-wrap: anywhere;

        /* Taller than the line, the button takes no height, so that what follows is as far from the text as fields
           are from each other */
        .mx_CopyableText_copyButton {
            margin-block: calc(-1 * var(--cpd-space-7x) / 2);
        }
    }

    .mx_UserProfileSettings_profile_buttons {
        margin-top: var(--cpd-space-4x);
    }

    .mx_UserProfileSettings_accountmanageIcon {
        margin-right: var(--cpd-space-2x);
    }

    /* Telement: the red Sign out row (ActionRowView) ends the card, 16px under what is above it as the card's other rows
       are; its hover fill reaches 4px from the card's bottom edge, as at its sides */
    .mx_UserProfileSettings_signOut {
        margin-block: var(--cpd-space-4x) calc(var(--tl-inset-menu) - var(--cpd-space-3x));
    }
}
