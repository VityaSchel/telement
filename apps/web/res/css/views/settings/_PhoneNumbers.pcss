.mx_GeneralUserSettingsTab_section--discovery_existing_verification {
    display: inline-flex;
    align-items: center;

    .mx_Field {
        margin: 0 0 0 1em;
    }
}

.mx_PhoneNumbers_input {
    display: flex;
    align-items: center;
}

.mx_PhoneNumbers_input > .mx_Field {
    flex-grow: 1;
}

.mx_PhoneNumbers_country {
    width: 80px;
}

/* Telement: the country code is a prefix inside the one field, as the room address's "#" is (_RoomAliasField.pcss),
   with no line between it and the number, so that the floated label names the whole field */
.mx_Field_prefix:has(> .mx_PhoneNumbers_country) {
    border-inline: none;
}
