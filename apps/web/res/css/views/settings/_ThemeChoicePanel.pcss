.mx_ThemeChoicePanel_ThemeSelectors {
    display: flex;
    flex-wrap: wrap;
    /* Override form default style */
    flex-direction: row !important;
    gap: var(--cpd-space-4x) !important;

    .mx_ThemeChoicePanel_themeSelector {
        border: 1px solid var(--cpd-color-border-interactive-secondary);
        /* Telement: a pill, as chips are, concentric with the radio: its 10px radius and the 12px around it */
        border-radius: var(--tl-radius-control);
        /* 44px tall, with the radio 12px from the chip's top, bottom and start, the 1px border included, and the label
           as far from its end */
        box-sizing: border-box;
        min-block-size: var(--cpd-space-11x);
        align-items: center;
        padding: 0 calc(var(--cpd-space-3x) - 1px);
        gap: var(--cpd-space-2x);
        background-color: var(--cpd-color-bg-canvas-default);

        /* Each chip resolves the accent in the theme it shows */
        &.mx_ThemeChoicePanel_themeSelector_enabled {
            @mixin selectedChoiceRing;
        }

        &.mx_ThemeChoicePanel_themeSelector_disabled {
            border-color: var(--cpd-color-border-disabled);

            .mx_ThemeChoicePanel_themeSelector_Label {
                color: var(--cpd-color-text-disabled);
                cursor: not-allowed;
            }
        }

        &:not(.mx_ThemeChoicePanel_themeSelector_disabled) {
            .mx_ThemeChoicePanel_themeSelector_Label {
                color: var(--cpd-color-text-primary);
            }
        }
    }
}
