/* Telement: on its section's card (_SettingsSection.pcss), with no line under it */
.mx_RoomProfileSettings {
    .mx_RoomProfileSettings_profile {
        display: flex;

        .mx_RoomProfileSettings_profile_controls {
            flex-grow: 1;
            margin-inline-end: 54px;

            .mx_Field {
                margin-top: var(--cpd-space-2x);
            }

            .mx_RoomProfileSettings_profile_controls_topic {
                /* 16px under the name, as fields are elsewhere (_Field.pcss), so the floated label keeps clear of it */
                margin-top: var(--cpd-space-4x);

                & > textarea {
                    font-family: inherit;
                    resize: vertical;
                }

                &.mx_RoomProfileSettings_profile_controls_topic--room textarea {
                    min-height: 4em;
                }
            }

            .mx_RoomProfileSettings_profile_controls_userId {
                margin-inline-end: var(--cpd-space-5x);
            }
        }
    }

    /* Telement: a dialog footer's gap between the buttons, and 16px under the topic, the form's 12px gap included */
    .mx_RoomProfileSettings_buttons {
        display: flex;
        gap: var(--buttons-dialog-gap-column);
        margin-top: calc(var(--cpd-space-4x) - var(--cpd-space-3x));
    }
}
