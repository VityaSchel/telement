/* Telement: Show all rooms belongs to Home, so it is indented under Home's toggle */
.mx_SidebarUserSettingsTab_homeAllRoomsToggle {
    margin-inline-start: var(--cpd-space-6x);
}

.mx_SidebarUserSettingsTab_icon {
    margin-right: var(--cpd-space-2x);
    margin-top: auto;
    margin-bottom: auto;
}

.mx_SidebarUserSettingsTab_toggle label {
    display: flex;
}
