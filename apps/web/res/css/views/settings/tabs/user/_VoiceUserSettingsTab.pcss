/* A toggle that only applies while legacy calls are on sits 24px in under their toggle, as in the Notifications and
   Sidebar tabs */
.mx_VoiceUserSettingsTab_dependentToggle {
    margin-inline-start: var(--cpd-space-6x);
}

/* Without a gap of its own when the setting it holds can't be set here */
.mx_VoiceUserSettingsTab_dependentToggle:empty {
    display: none;
}
