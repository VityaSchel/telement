/* Telement: the list starts right under its heading, as other subsections' content does, with the bullets in a 20px
   indent rather than the browser's 40px */
.mx_HelpUserSettingsTab_credits {
    margin: 0;
    padding-inline-start: var(--cpd-space-5x);
}

/* Telement: what the access token's row shows under it: the warning 8px over the token, which spans the card and wraps,
   4px under the row and 12px over the next one */
.mx_HelpUserSettingsTab_accessToken {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    padding-block: var(--cpd-space-1x) var(--cpd-space-3x);

    .mx_CopyableText {
        box-sizing: border-box;
        width: 100%;
        overflow-wrap: anywhere;
    }
}
