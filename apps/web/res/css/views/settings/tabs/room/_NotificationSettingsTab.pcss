/* Telement: the options are rows on a card (_common.pcss), drawn like the Security tab's join rules
   (_JoinRuleSettings.pcss): the radio at the start, the label 12px after it in semibold, its description under it in
   a toggle's description size and color, and each row 16px above its label's line and below its description, between
   separators */
.mx_NotificationSettingsTab_notificationsSection {
    @mixin settingsGroupCard;
    padding-block: 0;

    .mx_StyledRadioButton {
        padding-block: var(--cpd-space-4x);

        & + .mx_StyledRadioButton {
            border-top: 1px solid var(--cpd-color-separator-primary);
        }

        .mx_StyledRadioButton_content {
            display: block;
            margin-inline: var(--cpd-space-3x) 0;
            font: var(--cpd-font-body-md-semibold);
            color: $primary-content;
        }
    }

    .mx_NotificationSettingsTab_microCopy {
        margin-top: var(--cpd-space-1x);
        font: var(--cpd-font-body-sm-regular);
        color: $secondary-content;
    }
}

input[type="file"].mx_NotificationSound_soundUpload {
    display: none;
}
