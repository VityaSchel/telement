/* Telement: two equal cards 16px apart across the settings card, drawn as the message layouts' (_LayoutSwitcher.pcss): a
   44px header with the radio 12px from the card's top and start and the label 12px after it, a separator, and the
   drawing, scaled to the card and flush with its edges, in place of drawings with a radio under them, which lined up
   with nothing */
.mx_ImageSizePanel_choices {
    @mixin settingsGroupBox;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--cpd-space-4x);
}

.mx_ImageSizePanel_choice {
    @mixin choiceCard;
    display: flex;
    flex-direction: column;
    /* Compound's outline gray, as on the theme chips, 3:1 or more against the card, or the accent ring when its size is
       selected */
    border: 1px solid var(--cpd-color-border-interactive-primary);
    border-radius: var(--tl-radius-row);

    &:has(input:checked) {
        @mixin selectedChoiceRing;
    }
}

.mx_ImageSizePanel_header {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    block-size: 20px;
    padding: calc(var(--cpd-space-3x) - 1px);
    border-block-end: 1px solid var(--cpd-color-border-interactive-secondary);
    font: var(--cpd-font-body-md-medium);
    letter-spacing: var(--cpd-font-letter-spacing-body-md);
}

.mx_ImageSizePanel_size {
    display: block;
    /* The drawing's lines in Compound's separator, which a dark theme's raised dialogs (_common.pcss) move a step further,
       as they do their other lines */
    color: var(--cpd-color-separator-primary);
    width: 100%;
    height: auto;
    border-end-start-radius: calc(var(--tl-radius-row) - 1px);
    border-end-end-radius: calc(var(--tl-radius-row) - 1px);
}
