.mx_ImageSizePanel_radios {
    display: flex;
    flex-direction: row;
    gap: var(--cpd-space-4x);

    > label {
        margin-right: 68px; /* keep the boxes separate */
        cursor: pointer;
    }

    .mx_ImageSizePanel_size {
        display: block;
        /* Telement: the drawing's lines in Compound's separator, which a dark theme's raised dialogs (_common.pcss)
           move a step further, as they do their other lines */
        color: var(--cpd-color-separator-primary);
        width: 221px;
        height: 148px;
        margin-bottom: 14px; /* move radio button away from bottom edge a bit */
        /* Telement: the drawing's own 1px edge is covered by Compound's outline gray, as on the theme chips, 3:1 or
           more against the card, or by the accent ring when its size is selected. The outline follows the drawing's
           8px corners. */
        border-radius: var(--tl-radius-row);
        outline: 1px solid var(--cpd-color-border-interactive-primary);
        outline-offset: -1px;
    }

    > label:has(input:checked) > .mx_ImageSizePanel_size {
        @mixin selectedChoiceRing;
    }
}
