.mx_AvatarSetting_avatar {
    width: 120px;
    min-width: 120px; /* so it doesn't get crushed by the flexbox in languages with longer words */
    height: 120px;
    position: relative;

    &.mx_AvatarSetting_avatarDisplay:hover .mx_AvatarSetting_hover {
        opacity: 1;
    }

    /* Telement: the focus ring follows the avatar's shape, round or a space's rounded square, outside it, rather than
       the square box of the button around it */
    .mx_AvatarSetting_avatarDisplay:focus-visible {
        outline: none;

        > .mx_BaseAvatar {
            outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
            outline-offset: var(--cpd-space-0-5x);
        }
    }

    & > * {
        box-sizing: border-box;
    }

    .mx_AccessibleButton.mx_AccessibleButton_kind_primary {
        margin-top: 8px;
    }

    .mx_AccessibleButton.mx_AccessibleButton_kind_link_sm {
        width: 100%;
    }

    & > img {
        display: block;
        height: 120px;
        width: inherit;
        border-radius: 120px;
        cursor: pointer;
        object-fit: cover;
    }

    /* Telement: setting the photo is an action, so its badge is an accent circle with a white camera in its middle, as
       Telegram's set-photo control is. A 2px ring in the dialog's color keeps it apart from the photo. The transparent
       border keeps the circle's edge in forced colors, which drop the ring and the fill. */
    .mx_AvatarSetting_uploadButton {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border: 1px solid transparent;
        border-radius: 50%;
        background-color: var(--cpd-color-bg-accent-rest);
        box-shadow: 0 0 0 2px var(--cpd-color-bg-canvas-default);
        color: var(--tl-color-on-accent);

        position: absolute;
        inset-block-end: 0;
        inset-inline-end: 0;
        cursor: pointer;

        /* Outside the dialog-colored ring, as the browser's own ring would vanish against the accent */
        &:focus-visible {
            outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
            outline-offset: var(--cpd-space-0-5x);
        }
    }

    /* Hovered and while its menu is open, the badge takes the hover fill. In dark themes the hover and pressed fills are
       lighter than the rest fill, and the white camera on the pressed one would be 2.3:1. */
    .mx_AvatarSetting_uploadButton:hover,
    .mx_AvatarSetting_uploadButton_active {
        background-color: var(--cpd-color-bg-accent-hovered);
    }
}

.mx_AvatarSetting_removeMenuItem svg,
.mx_AvatarSetting_removeMenuItem span {
    color: var(--cpd-color-text-critical-primary) !important;
}
