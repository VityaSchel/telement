$poll-max-width: 550px;

.mx_MPollBody {
    margin-top: var(--cpd-space-2x);
    min-width: 0; /* Override fieldset default min-width: min-content */
    width: 100%; /* Ensure fieldset takes full available width */
    border: none; /* Remove default fieldset border */
    padding: 0; /* Remove default fieldset padding */
    margin-inline: unset; /* Remove default fieldset margin */
    display: inline-block; /* Preserve the fieldset display value we used to set globally */

    legend {
        padding-inline: unset; /* Remove default legend padding */
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-15px;
        line-height: $font-24px;
        margin-top: 0;
        margin-bottom: var(--cpd-space-2x);
        letter-spacing: var(--cpd-font-letter-spacing-heading-lg);
        display: flex;
        /* The icon is centered on the question's first line, so it stays beside it when the question wraps */
        align-items: start;
        gap: var(--cpd-space-3x);

        svg {
            flex-shrink: 0;
            margin-block: calc((1lh - 20px) / 2);
            color: var(--cpd-color-icon-primary);
        }

        .mx_MPollBody_edited {
            color: $secondary-content;
            font-size: $font-12px;
        }
    }

    .mx_MPollBody_totalVotes {
        display: flex;
        flex-direction: inline;
        justify-content: start;
        color: $secondary-content;
        font-size: $font-12px;

        .mx_Spinner {
            flex: 0;
            margin-left: var(--cpd-space-2x);
        }
    }

    /* The poll is drawn in a bubble, as in Telegram: the question starts at the bubble's padding, and the bubble is
       the options' card */
    &.mx_MPollBody_bubble {
        width: 550px; /* to prevent timestamp overlapping summary text */
        max-width: 100%; /* prevent overflowing a reply tile */
        margin-top: 0;

        /* The question's icon draws 2px inside its 20px box: pulled out by that, what it draws starts on the bubble's
           text edge, with the radios and the bars */
        legend svg {
            margin-inline-start: -2px;
        }

        .mx_PollOption {
            padding: 0;
            border: none;
            background-color: transparent;
        }

        /* Translucent, so the bars' track shows on the other's and the own bubble's color alike */
        .mx_PollOption_popularityBackground {
            background-color: var(--cpd-color-alpha-gray-400);
        }

        /* The summary is the bubble's last line, with the timestamp at its end, as on a text bubble */
        .mx_MPollBody_totalVotes {
            padding-block: 0;
        }
    }
}

.mx_MPollBody_allOptions {
    display: grid;
    gap: var(--cpd-space-4x);
    margin-bottom: var(--cpd-space-2x);
    max-width: $poll-max-width;
}
