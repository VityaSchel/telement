.mx_TagComposer {
    .mx_TagComposer_input {
        display: flex;
        flex-direction: row;

        .mx_AccessibleButton {
            min-width: 70px;
            align-self: center;
        }
    }

    .mx_TagComposer_tags {
        display: flex;
        flex-wrap: wrap;
        margin-top: 12px; /* this plus 12px from the tags makes 24px from the input */

        /* Telement: without tags it takes no room, so that a card ends 12px under the input, as under other content */
        &:empty {
            margin-top: 0;
        }
    }

    .mx_Tag {
        margin-right: 12px;
        margin-top: 12px;

        /* Settings tabs put buttons at the top of their row; the remove button stays centered in the chip */
        .mx_Tag_delete {
            align-self: center;
        }
    }
}

.mx_Tag {
    font-size: $font-15px;

    display: inline-flex;
    align-items: center;

    /* A 36px chip; the 16px remove button sits as far from its end as from its top and bottom */
    box-sizing: border-box;
    min-block-size: var(--tl-control-size);
    gap: 8px;
    padding-block: 0;
    padding-inline: var(--cpd-space-3x) calc((var(--tl-control-size) - 16px) / 2);
    border-radius: var(--tl-radius-control);

    color: $primary-content;
    background: $quinary-content;

    > svg:first-child {
        width: 1em;
        color: $secondary-content;
        transform: scale(1.25);
        transform-origin: center;
    }

    .mx_Tag_delete {
        border-radius: 50%;
        text-align: center;
        width: 1.066666em; /* 16px; */
        height: 1.066666em;
        line-height: 1em;
        color: $secondary-content;
        background: $system;
        position: relative;

        svg {
            width: 16px;
            height: 16px;
        }
    }
}
