/**
* This component expects the parent to specify a positive padding and
* width
*/

.mx_StyledRadioButton {
    $radio-circle-color: var(--cpd-color-border-interactive-primary);
    /* Telement: Compound's radio (TELEMENT.md, "Colors, type and components": selected options keep Compound's
       radios), so these look like the theme and layout choices beside them: a 20px ring, filled with the accent when
       checked, its dot white on the fill (telement/tokens.css) */
    $radio-size: 20px;
    position: relative;

    display: flex;
    align-items: baseline;
    flex-grow: 1;

    > .mx_StyledRadioButton_content {
        flex-grow: 1;

        display: flex;
        flex-direction: column;

        /* Telement: the label starts 12px after the radio, as on Compound's radios (InlineField), in settings, dialogs
           and polls alike */
        margin-inline: var(--cpd-space-3x) var(--cpd-space-2x);
    }

    .mx_StyledRadioButton_spacer {
        flex-shrink: 0;
        flex-grow: 0;

        /* Only as wide as the radio: a height would move the label's baseline, and with it the label, down */
        height: 0;
        width: $radio-size;
    }

    input[type="radio"] {
        /* Remove the OS's representation */
        margin: 0;
        padding: 0;
        appearance: none;

        + div {
            flex-shrink: 0;
            flex-grow: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            box-sizing: border-box;
            height: $radio-size;
            width: $radio-size;

            border: 1px solid $radio-circle-color;
            border-radius: 50%;

            > div {
                box-sizing: border-box;

                height: 8px;
                width: 8px;

                border-radius: 50%;
            }
        }

        /* Compound's focus ring around the radio, which leaves the ring itself on the content's edge */
        &:focus-visible {
            & + div {
                outline: 2px solid var(--cpd-color-border-focused);
                outline-offset: 1px;
            }
        }

        &:checked {
            & + div {
                /* Telement: a ring of its own where Telement gives it one (telement/tokens.css) */
                border-color: var(--tl-color-border-radio-checked, var(--cpd-color-bg-accent-rest));
                background-color: var(--cpd-color-bg-accent-rest);

                & > div {
                    background: var(--tl-color-on-accent);
                    /* For enhanced visibility under contrast control */
                    outline: 1px solid transparent;
                }
            }
        }

        &:disabled {
            & + div + span {
                opacity: 0.5;
                cursor: not-allowed;
            }

            /* Compound's disabled colors show it, without fading it as well */
            & + div {
                cursor: not-allowed;
                border-color: var(--cpd-color-border-disabled);
                background-color: var(--cpd-color-bg-canvas-disabled);
            }
        }

        &:checked:disabled {
            & + div {
                border-color: var(--cpd-color-bg-action-primary-disabled);
                background-color: var(--cpd-color-bg-action-primary-disabled);
            }
        }
    }

    /* Compound's hover: the ring takes the accent, with a gray dot, and a checked radio's fill deepens */
    @media (hover) {
        &.mx_StyledRadioButton_enabled:hover input[type="radio"] {
            &:not(:checked) + div {
                border-color: var(--cpd-color-bg-accent-hovered);
                box-shadow: 0 1.2px 2.4px 0 rgb(0 0 0 / 15%);

                > div {
                    background: var(--cpd-color-icon-quaternary);
                }
            }

            &:checked + div {
                border-color: var(--tl-color-border-radio-checked, var(--cpd-color-bg-accent-hovered));
                background-color: var(--cpd-color-bg-accent-hovered);
            }
        }
    }

    .mx_StyledRadioButton_innerLabel {
        display: flex;
        position: relative;
        top: 4px;
    }
}

.mx_StyledRadioButton_outlined {
    border: 1px solid $input-darker-bg-color;
    border-radius: 8px;
}

.mx_StyledRadioButton_checked {
    /* Telement: an outlined option's border is a line, so it takes the accent rather than the deeper fill dark themes
       put white on */
    border-color: var(--cpd-color-border-accent-primary);
}
