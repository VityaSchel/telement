.mx_ExternalLink {
    color: $links;
}

/* Telement: underlined like every link in a sentence (_AccessibleButton.pcss), its icon telling it leaves the app. As
   specific as the theme's rule that drops the underline of links (_mods.pcss), which comes before the components. */
a.mx_ExternalLink:any-link {
    text-decoration: underline;
}

/* Telement: browsers may wrap before an icon even after a word joiner, unless the two are in an element that doesn't
   wrap, so the icon stays with the link's last word (ExternalLink.tsx) */
.mx_ExternalLink_iconWrapper {
    white-space: nowrap;
}

.mx_ExternalLink_icon {
    display: inline-block;
    width: $font-11px;
    height: $font-11px;
    margin-left: 0.3rem;
    vertical-align: middle;
}
