.mx_MiniAvatarUploader {
    position: relative;
    width: min-content;

    /* Telement: the settings avatar's edit badge (_AvatarSetting.pcss), at this size: an accent circle with a white
       camera, kept apart from the photo by a 2px ring in the page's color. The transparent border keeps the circle's
       edge in forced colors, which drop the ring and the fill. */
    .mx_MiniAvatarUploader_indicator {
        position: absolute;

        height: 16px;
        width: 16px;
        padding: 4px;
        border: 1px solid transparent;

        right: -6px;
        bottom: -6px;

        background-color: var(--cpd-color-bg-accent-rest);
        box-shadow: 0 0 0 2px var(--cpd-color-bg-canvas-default);
        color: var(--tl-color-on-accent);
        border-radius: 50%;

        line-height: 0;

        .mx_MiniAvatarUploader_cameraIcon {
            height: inherit;
            width: inherit;
        }
    }
}

.mx_MiniAvatarUploader_input {
    display: none;
}
