.mx_SettingsDropdown {
    width: 100%;

    /* Telement: the label is a line of its own, 8px above the dropdown, as the Sounds block's label is above its
       button. As an inline label, its margins didn't apply and the dropdown touched its text */
    .mx_SettingsDropdown_label {
        display: block;
        color: $primary-content;
        margin: 0 0 var(--cpd-space-2x);
    }

    /* Telement: across the card, as every field in the settings is */
    .mx_Dropdown_input {
        box-sizing: border-box;
        width: 100%;
    }
}
