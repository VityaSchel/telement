/* TODO: Consider unifying with general input styles in _light.pcss */

.mx_Field {
    display: flex;
    flex: 1;
    min-width: 0;
    position: relative;
    /* Fields one under another are 16px apart in any font size, which leaves a floated label room above its field */
    margin: var(--cpd-space-4x) 0;
    border-radius: 8px;
    transition: border-color 0.25s;
    border: 1px solid var(--cpd-color-border-interactive-secondary);
}

.mx_Field_prefix {
    border-right: 1px solid var(--cpd-color-border-interactive-secondary);
}

.mx_Field_postfix {
    border-left: 1px solid var(--cpd-color-border-interactive-secondary);
}

.mx_Field input,
.mx_Field select,
.mx_Field textarea {
    font: var(--cpd-font-body-md-regular);
    border: none;
    /* Even without a border here, we still need this avoid overlapping the rounded */
    /* corners on the field above. */
    border-radius: 8px;
    /* One line fills a 36px field */
    padding: calc((var(--tl-control-size) - 2 * var(--cpd-border-width-1) - 1lh) / 2) var(--cpd-space-3x);
    color: $primary-content;
    background-color: $background;
    flex: 1;
    min-width: 0;
}

.mx_Field input[type="password"] {
    background-color: transparent;
    color: $primary-content;
    &:focus {
        outline: none;
        box-shadow: none;
    }
}

.mx_Field select {
    -moz-appearance: none;
    -webkit-appearance: none;
    text-overflow: ellipsis;
}

.mx_Field_select_chevron {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    right: 4px;
    width: 18px;
    height: 18px;
    color: $primary-content;
    z-index: 1;
    pointer-events: none;
}

/* Telement: the field spec's states (TELEMENT.md, "Colors, type and components"), as Compound's text fields have them:
   a darker border on hover, Compound's focus blue when focused */
.mx_Field:hover {
    border-color: var(--cpd-color-border-interactive-hovered);
}

.mx_Field:focus-within {
    border-color: var(--cpd-color-border-focused);
}

.mx_Field input:focus,
.mx_Field select:focus,
.mx_Field textarea:focus {
    outline: 0;
}

.mx_Field input::placeholder,
.mx_Field textarea::placeholder {
    transition: color 0.25s ease-in 0s;
    color: transparent;
}

.mx_Field input:placeholder-shown:focus::placeholder,
.mx_Field textarea:placeholder-shown:focus::placeholder,
.mx_Field.mx_Field_placeholderIsHint input::placeholder {
    transition: color 0.25s ease-in 0.1s;
    color: $info-plinth-fg-color;
}

.mx_Field label {
    transition:
        font-size 0.25s ease-out 0.1s,
        color 0.25s ease-out 0.1s,
        transform 0.25s ease-out 0.1s,
        background-color 0.25s ease-out 0.1s;
    background-color: transparent;
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-secondary);
    transform: translateY(0);
    position: absolute;
    left: 0px;
    /* Centered on the input's first line, its text where the input's starts. Floated, its smaller line is still
       centered there before the transform moves it */
    margin: calc((var(--tl-control-size) - 2 * var(--cpd-border-width-1) - 1lh) / 2)
        calc(var(--cpd-space-3x) - var(--cpd-space-0-5x));
    padding: 0 var(--cpd-space-0-5x);
    pointer-events: none; /* Allow clicks to fall through to the input */
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    max-width: calc(100% - 2 * var(--cpd-space-3x)); /* 100% of parent minus margin and padding */
}

.mx_Field_labelAlwaysTopLeft label,
.mx_Field select + label /* Always show a select's label on top to not collide with the value */,
.mx_Field input:focus + label,
.mx_Field input:not(:placeholder-shown) + label,
.mx_Field textarea:focus + label,
.mx_Field textarea:not(:placeholder-shown) + label {
    transition:
        font-size 0.25s ease-out 0s,
        color 0.25s ease-out 0s,
        transform 0.25s ease-out 0s,
        background-color 0.25s ease-out 0s;
    /* Compound's smallest size */
    font-size: var(--cpd-font-size-body-xs);
    /* From the middle of the field's one line to the middle of its top border */
    transform: translateY(calc(var(--cpd-border-width-1) / 2 - var(--tl-control-size) / 2));
    padding: 0 2px;
    background-color: $background;
    pointer-events: initial;
}

/* Telement: the focus blue of the border the label sits on, rather than the link color: the accent is under 4.5:1 on
   white */
.mx_Field input:focus + label,
.mx_Field select:focus + label,
.mx_Field textarea:focus + label {
    color: var(--cpd-color-border-focused);
}

/* Compound's disabled field: a gray fill and border, and disabled text. The label keeps the background it floats on */
.mx_Field:has(> :is(input, select, textarea):disabled) {
    border-color: var(--cpd-color-border-disabled);
    background-color: var(--cpd-color-bg-canvas-disabled);
}

.mx_Field select:disabled,
.mx_Field input:disabled,
.mx_Field textarea:disabled {
    background-color: var(--cpd-color-bg-canvas-disabled);
    color: var(--cpd-color-text-disabled);
}

.mx_Field select:disabled + label,
.mx_Field input:disabled + label,
.mx_Field textarea:disabled + label {
    color: var(--cpd-color-text-disabled);
}

.mx_Field_valid {
    &.mx_Field,
    &.mx_Field:focus-within {
        border-color: $accent;
    }

    &.mx_Field label,
    &.mx_Field:focus-within label {
        color: $accent;
    }
}

.mx_Field_invalid {
    &.mx_Field,
    &.mx_Field:focus-within {
        border-color: var(--cpd-color-border-critical-primary);
    }

    &.mx_Field label,
    &.mx_Field:focus-within label {
        color: var(--cpd-color-text-critical-primary);
    }
}

/* Customise other components when placed inside a Field */

.mx_Field .mx_Dropdown_input {
    border: initial;
    border-radius: initial;
}

.mx_Field .mx_CountryDropdown {
    width: fit-content;
}
