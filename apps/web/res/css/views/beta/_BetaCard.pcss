.mx_BetaCard {
    /* Telement: a card of the Labs tab's settings (_common.pcss), on its gray pane, with the cards' 12 × 16 padding, so
       that its text starts on the content edge of the cards around it */
    @mixin settingsGroupCard;
    color: $secondary-content;

    .mx_BetaCard_columns {
        display: flex;
        flex-flow: wrap;
        gap: var(--cpd-space-5x);
        justify-content: center;

        .mx_BetaCard_columns_description {
            flex: 1;

            /* Telement: Compound's sizes (TELEMENT.md, "Colors, type and components"): 18px becomes heading-sm, the
               caption body text and the reload warning and FAQ the 13px of help text in the settings, with semibold
               rather than bold questions. 14px of space becomes 12 */
            .mx_BetaCard_title {
                font: var(--cpd-font-heading-sm-semibold);
                letter-spacing: var(--cpd-font-letter-spacing-heading-sm);
                color: $primary-content;
                margin: 0 0 var(--cpd-space-3x);

                display: flex;
                align-items: center;
                column-gap: var(--cpd-space-3x);
            }

            .mx_BetaCard_caption {
                font: var(--cpd-font-body-md-regular);
            }

            .mx_BetaCard_buttons {
                display: flex;
                flex-wrap: wrap-reverse;
                gap: var(--cpd-space-3x);
                margin: var(--cpd-space-5x) auto 0;

                .mx_AccessibleButton {
                    width: auto;
                    flex: 1;
                    white-space: nowrap; /* text might overflow */

                    &:nth-child(1) {
                        order: 2; /* Place feedback button top and right */
                    }
                }
            }

            .mx_BetaCard_refreshWarning {
                margin-top: var(--cpd-space-2x);
                font: var(--cpd-font-body-sm-regular);
                text-align: center;
            }

            .mx_BetaCard_faq {
                margin-top: var(--cpd-space-5x);
                font: var(--cpd-font-body-sm-regular);

                > h4 {
                    margin: var(--cpd-space-3x) 0 0;
                    font-weight: var(--cpd-font-weight-semibold);
                }

                > p {
                    margin: 0;
                }
            }
        }

        .mx_BetaCard_columns_image_wrapper {
            margin: auto 0;

            .mx_BetaCard_columns_image {
                width: 100%;
                max-width: 300px;
                object-fit: contain;
                height: 100%;
                border-radius: 4px;
            }

            /* Telement: a beta's dark illustration (BetaCard.tsx) replaces the light one in dark themes, where the light
               one would be the brightest thing in the dialog. Hidden, it isn't loaded. */
            .mx_BetaCard_columns_image_dark {
                display: none;
            }

            :is(.cpd-theme-dark, .cpd-theme-dark-hc) & {
                .mx_BetaCard_columns_image:has(+ .mx_BetaCard_columns_image_dark) {
                    display: none;
                }

                .mx_BetaCard_columns_image_dark {
                    display: inline;
                }
            }
        }
    }

    .mx_BetaCard_relatedSettings {
        .mx_SettingsFlag {
            margin: var(--cpd-space-4x) 0 0;
            font-size: $font-15px;
            line-height: $font-24px;
            color: $primary-content;

            .mx_SettingsFlag_microcopy {
                margin-top: var(--cpd-space-1x);
                font: var(--cpd-font-body-sm-regular);
            }
        }
    }
}

/* Telement: an accent badge, white on the accent fill, which dark themes deepen for it (telement/tokens.css), with
   badge text (11px semibold) trimmed to its capitals, so they sit in the middle of the 24px pill */
.mx_BetaCard_betaPill {
    box-sizing: border-box;
    background-color: var(--cpd-color-bg-accent-rest);
    block-size: var(--cpd-space-6x);
    padding: 0 var(--cpd-space-2x);
    border-radius: var(--tl-radius-control);
    text-transform: uppercase;
    font: var(--cpd-font-body-xs-semibold);
    line-height: 1cap;
    text-box: trim-both cap alphabetic;
    color: var(--tl-color-on-accent);
    display: inline-flex;
    align-items: center;
    vertical-align: text-bottom;
    word-break: keep-all; /* avoid multiple lines on CJK language */

    &.mx_AccessibleButton {
        cursor: pointer;
    }
}
