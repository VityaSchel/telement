.mx_SuccessDialog {
    text-align: center;

    .mx_Icon {
        margin-bottom: var(--cpd-space-4x);
    }

    .mx_Dialog_header {
        margin: 0 0 var(--cpd-space-4x);
        padding: 0;
    }

    .mx_Dialog_title {
        margin: 0;
    }

    .mx_Dialog_content {
        color: $secondary-content;
        /* Telement: the footer's labels 24px under the text, as in every dialog */
        margin: 0 0 var(--cpd-space-6x);
    }
}
