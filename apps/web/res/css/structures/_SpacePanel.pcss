.mx_SpacePanel {
    --gutterSize: 14px;
    --height-nested: 24px;
    --height-topLevel: 32px;

    background-color: var(--cpd-color-bg-canvas-default);
    border-right: 1px solid var(--cpd-color-bg-subtle-primary);
    flex: 0 0 auto;
    padding: 0;
    margin: 0;
    position: relative;
    /* Fix for the blurred avatar-background */
    z-index: 1;

    /* For enhanced visibility under contrast control */
    outline: 1px solid transparent;

    /* Create another flexbox so the Panel fills the container */
    display: flex;
    flex-direction: column;

    &.collapsed {
        width: 68px;
    }

    .mx_SpacePanel_toggleCollapse {
        position: absolute;
        width: 18px;
        height: 18px;
        border-radius: 50%;
        background-color: $tertiary-content;
        top: 19px; /* v-align with avatar */
        right: -8px;

        svg {
            height: inherit;
            width: inherit;
            display: inline-block;
            color: $background;
            /* Slight alignment tweak to center the asset */
            margin-left: 1px;
        }

        &:not(.expanded) {
            opacity: 0;
        }

        &.expanded svg {
            transform: rotate(180deg);
            /* Slight alignment tweak to center the asset */
            margin-left: -1px;
        }
    }

    &:hover .mx_SpacePanel_toggleCollapse,
    .mx_SpacePanel_toggleCollapse:focus-visible {
        opacity: 1;
    }

    /* For enhanced visibility under contrast control. Only there, where a transparent outline is drawn: elsewhere it
       would take the place of the focus ring. */
    @media (forced-colors: active) {
        &:hover .mx_SpacePanel_toggleCollapse:not(:focus-visible) {
            outline: 1px solid transparent;
        }
    }

    ul {
        margin: 0;
        list-style: none;
        padding: 0;
    }

    .mx_SpaceButton_toggleCollapse {
        cursor: pointer;
    }

    .mx_SpaceItem_dragging {
        .mx_SpaceButton_toggleCollapse {
            visibility: hidden;
        }
    }

    .mx_SpaceItem {
        display: inline-flex;
        flex-flow: wrap;

        &.mx_SpaceItem_narrow {
            align-self: baseline;
        }
    }

    .mx_SpaceItem.collapsed {
        & > .mx_SpaceButton > .mx_SpaceButton_toggleCollapse {
            padding: 0 10px;
            margin: 0 -10px;
        }

        & > .mx_SpaceTreeLevel {
            display: none;
        }
    }

    .mx_SpaceItem_new {
        position: relative;
    }

    .mx_SpaceItem:not(.hasSubSpaces) > .mx_SpaceButton {
        margin-left: var(--gutterSize);
        min-width: 40px;
    }

    .mx_SpaceButton {
        border-radius: 8px;
        display: flex;
        align-items: center;
        padding: 4px 4px 4px 0;
        width: 100%;
        /* Override the unlayered cursor: grab; rule from react-beautiful-dnd */
        cursor: default !important;

        .mx_SpaceButton_selectionWrapper {
            position: relative;
            display: flex;
            flex: 1;
            align-items: center;
            border-radius: 12px;
            padding: 4px;
            width: calc(100% - 32px);
            min-width: 0;
        }

        &.mx_SpaceButton_narrow .mx_SpaceButton_selectionWrapper {
            flex: initial;
            width: 32px;
        }

        .mx_SpaceButton_name {
            flex: 1;
            margin-left: 8px;
            white-space: nowrap;
            display: block;
            text-overflow: ellipsis;
            overflow: hidden;
            font: var(--cpd-font-body-md-regular);
        }

        .mx_SpaceButton_toggleCollapse {
            height: 20px;
            width: var(--gutterSize);
            flex-shrink: 0;
            padding: 10px 0;

            svg {
                width: 20px;
                height: inherit;
                display: inline-block;
                color: $tertiary-content;
                /* Re-align with parent */
                margin-left: -3px;
            }
        }

        .mx_SpaceButton_icon {
            /* Calculate height excluding padding to allow svg to inherit. The 32px tile holds a 24px icon, as the
               Threads and Settings buttons below do. */
            width: calc(var(--height-topLevel) - 2 * var(--cpd-space-1x));
            height: calc(var(--height-topLevel) - 2 * var(--cpd-space-1x));
            flex-shrink: 0;
            border-radius: 8px;
            padding: var(--cpd-space-1x);
            background-color: $panel-actions;

            svg {
                width: inherit;
                height: inherit;
                display: block;
                color: $secondary-content;
            }
        }

        /* Hovering a space, or opening its options menu, fills it in the room list's hover gray. Whether the menu is
           open is read from its "…" button: right-clicking a space that has no menu, such as Favourites or the "+",
           also adds mx_SpaceButton_hasMenuOpen, and nothing removes it again. */
        &:hover,
        &:has(.mx_SpaceButton_menuButton[aria-expanded="true"]) {
            .mx_SpaceButton_selectionWrapper {
                background-color: var(--cpd-color-bg-action-tertiary-hovered);
            }
        }

        /* Pressed, it takes the pressed fill, a step past the hover fill; pressing its "…" presses only that */
        &:active:not(:has(.mx_SpaceButton_menuButton:active)) .mx_SpaceButton_selectionWrapper {
            background-color: var(--cpd-color-bg-action-secondary-pressed);
        }

        /* The selected space is a plate in the selection color with its name and icons in white, as the selected room
           is. Home's and the other icons drop their gray tile on it. */
        &.mx_SpaceButton_active {
            .mx_SpaceButton_selectionWrapper {
                background-color: var(--tl-color-bg-selection);
                color: var(--tl-color-on-selection);
                /* For enhanced visibility under contrast control */
                outline: 1px solid transparent;
            }

            &:hover,
            &:has(.mx_SpaceButton_menuButton[aria-expanded="true"]) {
                .mx_SpaceButton_selectionWrapper {
                    background-color: var(--tl-color-bg-selection-hovered);
                }

                .mx_SpacePanel_notificationBadge {
                    color: var(--tl-color-bg-selection-hovered);
                }
            }

            &:active:not(:has(.mx_SpaceButton_menuButton:active)) {
                .mx_SpaceButton_selectionWrapper {
                    background-color: var(--tl-color-bg-selection-pressed);
                }

                .mx_SpacePanel_notificationBadge {
                    color: var(--tl-color-bg-selection-pressed);
                }
            }

            .mx_SpaceButton_icon {
                background-color: transparent;
            }

            :is(.mx_SpaceButton_icon, .mx_SpaceButton_menuButton) svg {
                color: var(--tl-color-on-selection);
            }

            /* Its badge is inverted, as the selected room's badges are: the accent badge would vanish on the accent
               plate. In light themes the panel is as white as the badge, so the ring takes the plate's color, which
               the count is in, and the badge reads as a white pill outlined in it on the tile as where it hangs over
               the panel. Dark themes keep the ring in the panel's color, so it reads as cut out of the tile there. */
            .mx_SpacePanel_notificationBadge {
                background-color: var(--tl-color-on-selection);
                color: var(--tl-color-bg-selection);
                border-color: currentcolor;
            }

            :is(.cpd-theme-dark, .cpd-theme-dark-hc) & .mx_SpacePanel_notificationBadge {
                border-color: var(--cpd-color-bg-canvas-default);
            }
        }

        &.mx_SpaceButton_new .mx_SpaceButton_icon {
            background-color: unset;

            /* The gray of the other icon buttons in the panel, darkening on hover like the Settings button */
            svg {
                color: var(--cpd-color-icon-secondary);
                transition: all 0.2s ease-in-out; /* TODO transition */
            }
        }

        &.mx_SpaceButton_new:hover .mx_SpaceButton_icon svg {
            color: var(--cpd-color-icon-primary);
        }

        &.mx_SpaceButton_newCancel .mx_SpaceButton_icon svg {
            transform: rotate(45deg);
        }

        .mx_SpaceButton_menuButton {
            width: 16px;
            height: 16px;
            padding: var(--cpd-space-0-5x);
            flex-shrink: 0;
            margin-top: auto;
            margin-bottom: auto;
            display: none;
            position: absolute;
            right: 4px;

            svg {
                width: inherit;
                height: inherit;
                display: block;
                color: $primary-content;
            }
        }
    }

    .mx_SpaceTreeLevel {
        display: flex;
        flex-direction: column;
        max-width: 250px;
        min-width: 0;
        flex-grow: 1;

        .mx_SpaceTreeLevel {
            /* Indent subspaces */
            padding-left: 16px;
        }
    }

    .mx_SpaceButton_avatarWrapper {
        position: relative;
        line-height: 0;
    }

    .mx_SpacePanel_badgeContainer {
        /* Create a flexbox to make aligning dot badges easier */
        display: flex;
        align-items: center;
        position: absolute;
        right: -3px;
        top: -3px;

        .mx_SpacePanel_notificationBadge {
            margin: 0 2px; /* centering */
            background-clip: padding-box;
        }

        /* The rings around the badges are cut out of the avatar in the panel's color */
        [data-badge-type="dot"] {
            /* make the smaller dot occupy the same width for centering */
            margin: 0 -1px 0 0;
            border: 3px solid var(--cpd-color-bg-canvas-default);
        }

        /* The room list's counter, 20px at the default font size: with its 2px ring, centered 2px inside the avatar's
           top right corner, as Element's 16px badge was. Longer counts and larger fonts grow it down and to the left:
           on the first space its top already meets the top of the list's scroll area, which clips what is above. */
        [data-badge-type="badge_2char"],
        [data-badge-type="badge_3char"] {
            margin: -7px -7px 0 0;
            border: 2px solid var(--cpd-color-bg-canvas-default);
        }
    }

    .mx_SpaceButton:hover,
    .mx_SpaceButton:focus-within,
    .mx_SpaceButton_hasMenuOpen {
        &:not(.mx_SpaceButton_narrow):not(.mx_SpaceButton_invite) .mx_SpaceButton_menuButton {
            display: block;
        }
    }

    .mx_SpaceItem:not(.mx_SpaceItem_new) {
        .mx_SpaceButton:hover,
        .mx_SpaceButton:focus-within,
        .mx_SpaceButton_hasMenuOpen {
            &:not(.mx_SpaceButton_narrow):not(.mx_SpaceButton_invite) .mx_SpaceButton_name {
                max-width: calc(100% - 56px);
            }
        }
    }

    /* root space buttons are bigger and not indented */
    & > .mx_AutoHideScrollbar {
        flex: 1;
        padding: 0 0 16px 0;
        scrollbar-gutter: stable;

        &.mx_IndicatorScrollbar_topOverflow {
            mask-image: linear-gradient(to bottom, transparent, black 16px);
        }

        &.mx_IndicatorScrollbar_bottomOverflow {
            mask-image: linear-gradient(
                to top,
                transparent,
                rgb(255, 255, 255, 30%) 4px,
                rgb(255, 255, 255, 55%) 8px,
                rgb(255, 255, 255, 75%) 12px,
                black 16px
            );
        }

        &.mx_IndicatorScrollbar_topOverflow.mx_IndicatorScrollbar_bottomOverflow {
            /* This stacks two gradients on top of one another, which lets us
               have a fixed pixel offset from both top and bottom for the colour stops.
               Note the top fade is much smaller because the spaces start close to the top,
               so otherwise a large gradient suddenly appears when you scroll down.
             */
            mask-image:
                linear-gradient(to bottom, transparent, black 16px),
                linear-gradient(
                    to top,
                    transparent,
                    rgb(255, 255, 255, 30%) 4px,
                    rgb(255, 255, 255, 55%) 8px,
                    rgb(255, 255, 255, 75%) 12px,
                    black 16px
                );
            mask-position:
                0% 0%,
                0% 100%;
            mask-size:
                calc(100% - 10px) 50%,
                calc(100% - 10px) 50%;
            mask-repeat: no-repeat;
        }
    }
}

.mx_SpacePanel_contextMenu {
    max-width: 360px;

    .mx_SpacePanel_contextMenu_header {
        /* 16px from the menu's side, as the items' icons are (its 4px inset and their 12px padding), and 12px from its
           top and from the separator below, whose 4px margin this one takes in */
        margin: var(--cpd-space-2x) var(--cpd-space-3x) var(--cpd-space-3x);
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-15px;
        line-height: $font-18px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* The title of the Add group under its separator: a 32px row like the items, in the 13px semibold secondary text
       of Compound's menu titles, on the edge of the items' content */
    .mx_SpacePanel_contextMenu_separatorLabel {
        display: flex;
        align-items: center;
        box-sizing: border-box;
        min-block-size: var(--tl-menu-row-size);
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-body-sm-semibold);
        letter-spacing: var(--cpd-font-letter-spacing-body-sm);
    }
}

.mx_SpacePanel_sharePublicSpace {
    margin: 0;
}

.mx_SpacePanel_Tooltip_KeyboardShortcut {
    kbd {
        font-family: inherit;
        text-transform: capitalize;
    }
}
