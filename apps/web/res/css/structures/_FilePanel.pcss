.mx_FilePanel {
    order: 2;
    flex: 1 1 0;
    overflow-y: auto;
    display: flex;

    .mx_RoomView_messageListWrapper {
        flex-direction: row;
        align-items: center;
        justify-content: center;
    }

    .mx_RoomView_MessageList {
        width: 100%;
        gap: var(--cpd-space-6x);
    }

    /* The card's content edge, the card header's 12px inset, rather than the 18px of the right panel's timelines, which
       _RightPanel.pcss sets later in the cascade */
    .mx_RoomView_messageListWrapper > .mx_RoomView_MessageList {
        padding-inline: var(--cpd-space-3x);
    }

    /* The empty state centers itself on the card, as the threads list's does, without the 30px end margin and the
       80px bottom margin that the room's empty timeline takes */
    .mx_RoomView_messageListWrapper > .mx_RoomView_empty {
        display: contents;
    }

    /* A voice message's player spans the card's content, as the file cards do, rather than the room's 243px */
    .mx_MVoiceMessageBody .mx_VoiceMessagePrimaryContainer {
        max-width: none;
    }
}
