.mx_HomePage {
    display: grid;
    place-items: center;
    width: min(100% - 50px, 960px);
    height: 100%;
    margin: 0 auto;
    container-type: inline-size;
    container-name: homepage;
}

.mx_HomePage_default {
    text-align: center;

    img {
        height: 48px;
    }

    h1 {
        margin-bottom: 4px;
        font-weight: var(--cpd-font-weight-semibold);
        font-size: $font-32px;
        line-height: 1.375;
    }

    /* Compound's heading-sm, as 18px is not on its scale, in the one secondary text color */
    h2 {
        margin-top: 4px;
        font: var(--cpd-font-heading-sm-semibold);
        color: var(--cpd-color-text-secondary);
    }

    .mx_MiniAvatarUploader {
        margin: 0 auto;
    }

    .mx_HomePage_default_buttons {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5px 40px;
        width: 100%;
        margin-top: 80px;
        margin-bottom: 20px;

        .mx_AccessibleButton {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: var(--cpd-space-3x);
            box-sizing: border-box;
            width: 160px;
            min-height: 132px;
            padding: var(--cpd-space-2x) var(--cpd-space-4x);
            border-radius: var(--tl-radius-bubble);
            font-weight: var(--cpd-font-weight-semibold);
            font-size: $font-15px;
            line-height: $font-20px;
            /* The accent fill white sits on, which dark themes take a step deeper than the accent so it stays 4:1 */
            color: var(--tl-color-on-accent);
            background-color: var(--cpd-color-bg-accent-rest);

            @media (hover) {
                &:hover {
                    background-color: var(--cpd-color-bg-accent-hovered);
                }
            }

            &:active {
                background-color: var(--cpd-color-bg-accent-pressed);
            }

            svg {
                display: block;
                width: 100%;
                height: 40px;
                object-fit: contain;
                color: var(--tl-color-on-accent);
            }
        }

        @container homepage (max-width: 559px) {
            grid-template-columns: 1fr;

            .mx_AccessibleButton {
                flex-direction: row;
                width: 100%;
                min-height: 0;

                svg {
                    width: 24px;
                }
            }
        }
    }
}
