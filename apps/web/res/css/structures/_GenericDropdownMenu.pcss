.mx_GenericDropdownMenu_button {
    padding: 3px 4px 3px 8px;
    border-radius: 4px;
    line-height: 1.5;
    user-select: none;
    font-size: $font-12px;
    color: $secondary-content;

    svg {
        width: 18px;
        height: 18px;
        float: right;
    }
}

.mx_GenericDropdownMenu_button:hover,
.mx_GenericDropdownMenu_button[aria-expanded="true"] {
    background: $quinary-content;
}

/* Telement: the shared menu geometry (TELEMENT.md, "Radius and spacing"): 32px rows with 8px highlights, inset 4px
   from the menu's edge, their content 16px in, and a radio or icon 10px before the label */
.mx_ContextualMenu_wrapper.mx_GenericDropdownMenu_wrapper {
    .mx_ContextualMenu {
        position: initial;
        padding: calc(var(--tl-inset-menu) - var(--cpd-border-width-1));
        font: var(--cpd-font-body-md-regular);
        color: var(--cpd-color-text-secondary);
    }

    .mx_GenericDropdownMenu_divider {
        display: block;
        margin-block: var(--tl-menu-separator-spacing);
        /* The divider, a step further in a dark theme's raised menus (_common.pcss) */
        border-top: var(--cpd-border-width-1) solid var(--cpd-color-separator-primary);
    }

    .mx_GenericDropdownMenu_Option {
        display: flex;
        align-items: center;
        gap: var(--tl-menu-icon-gap);
        box-sizing: border-box;
        min-block-size: var(--tl-menu-row-size);
        padding: var(--cpd-space-1x) var(--cpd-space-3x);
        border-radius: var(--tl-radius-row);

        > .mx_GenericDropdownMenu_Option--label {
            display: flex;
            flex-direction: column;
            flex-grow: 1;
            margin: 0;

            span:first-child {
                color: var(--cpd-color-text-primary);
            }
        }

        /* A group's title, in semibold above its options */
        &.mx_GenericDropdownMenu_Option--header > .mx_GenericDropdownMenu_Option--label span:first-child {
            font-weight: var(--cpd-font-weight-semibold);
        }

        &.mx_GenericDropdownMenu_Option--item {
            &:hover,
            &:focus-visible {
                background-color: var(--cpd-color-bg-action-secondary-hovered);
            }

            &:active {
                background-color: var(--cpd-color-bg-action-secondary-pressed);
            }

            /* Inside the highlight, as in the other menus */
            &:focus-visible {
                outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
                outline-offset: calc(-1 * var(--cpd-border-width-2));
            }

            > svg {
                flex-shrink: 0;
                width: 20px;
                height: 20px;
                color: var(--cpd-color-icon-primary);
            }
        }

        .mx_GenericDropdownMenu_Option--selection {
            flex-shrink: 0;
            pointer-events: none;
        }
    }
}
