.mx_NonUrgentToastContainer {
    position: absolute;
    bottom: 30px;
    left: 28px;
    z-index: 101; /* same level as other toasts */

    .mx_NonUrgentToastContainer_toast {
        padding: var(--cpd-space-2x) var(--cpd-space-3x);
        border-radius: var(--tl-radius-bubble);
        width: 320px;
        font-size: $font-13px;
        /* Not 1.5: 19.5px leaves the browser half a pixel of leading to round, which lifts the text off the middle of
           the line the icon is centered on. One line makes a 36px toast. */
        line-height: $font-20px;
        margin-top: 8px;

        /* We don't use variables on the colours because we want it to be the same */
        /* in all themes. */
        background-color: #17191c;
        color: #fff;
    }
}
