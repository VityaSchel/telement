.mx_ViewSource {
    pre {
        font-size: $font-12px;
        padding: 0.5em 1em;
        word-wrap: break-word;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .mx_ViewSource_header {
        border-bottom: 1px solid $quinary-content;
        padding-bottom: var(--cpd-space-3x);
        margin-bottom: var(--cpd-space-3x);
        font-family: monospace;

        .mx_CopyableText {
            word-break: break-all;
        }
    }

    /* Telement: the dialog's title is its only large heading, so the source's is a 13px secondary group label
       (_common.pcss), on the source's edge rather than its text's, as the source isn't on a card */
    .mx_ViewSource_heading {
        --settings-group-inset: 0;

        @mixin settingsGroupLabel;
        margin-top: var(--cpd-space-3x);
    }

    .mx_ViewSource_details {
        margin-top: var(--cpd-space-3x);
    }

    .mx_CopyableText_border {
        box-sizing: border-box;
        width: 100%;
    }

    /* Telement: copy fields have no margins of their own (_CopyableText.pcss), so the source keeps its space here, 8px
       under its group label, in a rule more specific than that one, which comes later in the bundle. The source runs
       over many lines, so its copy button sits 4px from the top and the end, where a one-line field has it, rather
       than in the middle of the block. The source's own margin keeps its text clear of the top */
    .mx_CopyableText.mx_CopyableText_border {
        margin-block: var(--cpd-space-2x) var(--cpd-space-3x);
        align-items: flex-start;
        padding-block-start: calc(var(--cpd-space-1x) - var(--cpd-border-width-1));

        .mx_CopyableText_copyButton {
            margin-block: 0;
        }
    }
}
