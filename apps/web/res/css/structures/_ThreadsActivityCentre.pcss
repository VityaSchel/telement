.mx_ThreadsActivityCentre_container {
    display: flex;
}

.mx_ThreadsActivityCentreButton {
    margin: 18px auto auto auto;

    &.expanded {
        /**
         * override compound default background color when hovered
         * should disappear when the space panel will be migrated to compound
         */
        background-color: transparent !important;

        /* A row like the space buttons' highlight: 40px tall, in the panel's gutter and 4px from its end, with the icon
           centered on the space avatars, 8px from the row's start as from its top and bottom. The focus ring is inside
           the row, so inside the panel. */
        margin-left: var(--gutterSize);
        margin-right: var(--cpd-space-1x);
        width: 100%;
        block-size: var(--cpd-space-10x);
        padding: var(--cpd-space-2x);
        border-radius: var(--tl-radius-row);

        &:focus-visible {
            outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
            outline-offset: calc(-1 * var(--cpd-border-width-2));
        }

        /* Telement: the row is filled as the space rows are when hovered, and with the pressed fill when pressed */
        &:hover {
            background-color: var(--cpd-color-bg-action-tertiary-hovered) !important;
        }

        &:active {
            background-color: var(--cpd-color-bg-action-secondary-pressed) !important;
        }

        /**
         * modify internal css of the compound component
         * dirty but we need to add the `Threads` label into the indicator icon button
         **/
        & > div {
            display: flex;
            align-items: center;

            &::before {
                inline-size: 8px;
                block-size: 8px;
                left: 17px;
            }
        }

        & .mx_ThreadsActivityCentreButton_Icon {
            /* The label on the edge of the space names */
            margin-right: var(--cpd-space-3x);
            /* required to set the icon width when into a flex container */
            width: 24px;
            flex-shrink: 0;
        }

        & .mx_ThreadsActivityCentreButton_Text {
            /* !important override compound  */
            color: $secondary-content !important;
        }
    }

    &:not(.expanded) {
        /* The 40px of the space buttons' selection ring: padding grows the circle around the 24px icon and its dot */
        inline-size: var(--cpd-space-10x);
        block-size: var(--cpd-space-10x);
        padding: var(--cpd-space-2x);

        /* The space buttons' hover gray, and the pressed fill when pressed */
        &:hover {
            /* !important override compound */
            background-color: var(--cpd-color-bg-action-tertiary-hovered) !important;
        }

        &:active {
            background-color: var(--cpd-color-bg-action-secondary-pressed) !important;
        }

        &:hover,
        &:hover .mx_ThreadsActivityCentreButton_Icon {
            fill: $primary-content;
        }
    }

    & .mx_ThreadsActivityCentreButton_Icon {
        fill: $secondary-content;
    }
}

/* Compound styles its Menu/NavBar/MenuItem internals with single-class selectors. The
   `[role="menu"]` qualifier gives our rules a higher specificity so they win without
   `!important`. */
.mx_ThreadsActivityCentre_menu[role="menu"] {
    /* Override compound's default 340px cap */
    max-inline-size: 444px;
    inline-size: 444px;
    /*
     * Awful, brittle hack to remove padding from the menu which is now added on the content child
     * This probably ought to be a parameter to the compound component if we sometimes don't want padding.
     */
    > [role="none"] {
        padding-block: 0;

        --cpd-menu-padding-block-end: 0;
    }

    .mx_ThreadsActivityCentre_tabs {
        /* Override NavBar's default block margin to match the Figma design */
        margin: 0;
        padding: var(--cpd-space-2x) var(--cpd-space-4x) 0;
    }

    .mx_ThreadsActivityCentre_rows {
        overflow-y: auto;
        /* Fixed panel height from the design (~6 rows), so the menu doesn't resize as the
           list changes. Row heights vary with the preview, and 432px isn't on the spacing
           scale, so this stays in px. */
        height: 432px;
        min-height: 432px;
        /* The last row's highlight keeps 4px from the menu's bottom edge, as menu items do. The menu's 4px gap after the
           tabs does the same above the first. */
        padding-block-end: var(--tl-inset-menu);

        .mx_ThreadsActivityCentreThreadRow {
            /* Floor for rows without a message preview, which would otherwise be ~48px */
            min-height: var(--cpd-space-14x);

            /* Override compound's display: grid with a simple left-to-right flex row:
               [avatar] [gap] [text content] [indicator] */
            display: flex;
            align-items: center;
            gap: var(--cpd-space-3x);
            /* Inset rows, as in the other menus: the highlight 4px from the menu's edge, rounded concentrically with its
               corners, and the avatar 12px inside it, on the tabs' 16px content edge. A row focused with the keyboard
               is highlighted as on hover, with the focus ring inside the highlight. A button doesn't stretch to its
               container's width by itself. */
            inline-size: calc(100% - 2 * var(--tl-inset-menu));
            margin-inline: var(--tl-inset-menu);
            padding: var(--cpd-space-3x);
            border-radius: var(--tl-radius-row);

            /* Radix focuses the row under the pointer, which the browser takes for keyboard focus when a key was
               pressed last, so the ring and the highlight wait until the keyboard is in use (what-input) */
            &:focus-visible {
                outline: none;
            }

            :root:not([data-whatintent="mouse"]) &:focus-visible {
                outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
                outline-offset: calc(-1 * var(--cpd-border-width-2));
                background: var(--cpd-color-bg-action-secondary-hovered);
            }

            /* Compound's .icon class adds margin-inline-end; zero it since gap handles spacing */
            & > .mx_DecoratedRoomAvatar {
                margin-inline-end: 0;
                flex-shrink: 0;
            }

            /* Notification decoration (mention icon / counter / activity dot) at the trailing edge */
            & > .mx_ThreadsActivityCentreThreadRow_decoration {
                flex-shrink: 0;
                align-self: center;
            }

            .mx_ThreadsActivityCentreThreadRow_content {
                flex: 1;
                min-width: 0;
                display: flex;
                flex-direction: column;
                gap: var(--cpd-space-0-5x);
                text-align: start;
            }

            .mx_ThreadsActivityCentreThreadRow_header {
                display: flex;
                align-items: center;
                gap: var(--cpd-space-2x);
            }

            /* Font/letter-spacing come from the Compound Text components; only layout + colour here. */
            .mx_ThreadsActivityCentreThreadRow_roomName {
                flex: 1;
                min-width: 0;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .mx_ThreadsActivityCentreThreadRow_preview {
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
                color: var(--cpd-color-text-secondary);
            }

            .mx_ThreadsActivityCentreThreadRow_sender {
                color: var(--cpd-color-text-primary);
            }
        }
    }
}

/* With no threads to list, the list keeps its height and holds an icon and a caption in its middle, as the right panel's
   empty states do: Compound's threads icon in a 56px tile, 16px above the caption, both inside the tabs' 16px edge. */
.mx_ThreadsActivityCentre_emptyState {
    block-size: 100%;
    box-sizing: border-box;
    padding: var(--cpd-space-3x) var(--cpd-space-4x);
    text-align: center;
}

.mx_ThreadsActivityCentre_emptyIcon {
    flex-shrink: 0;
    inline-size: 56px;
    block-size: 56px;
    box-sizing: border-box;
    padding: var(--cpd-space-3x);
    border-radius: var(--tl-radius-row);
    background-color: var(--cpd-color-alpha-gray-300);
    color: var(--cpd-color-icon-secondary);
}

.mx_ThreadsActivityCentre_emptyCaption {
    /* Typography comes from the Compound Text component. A narrower measure keeps the centered caption compact. */
    max-inline-size: 280px;
    color: var(--cpd-color-text-secondary);
}
