.mx_AutocompleteInput {
    position: relative;
}

/* Telement: a text field of the field spec (TELEMENT.md, "Colors, type and components"): 36px with one row of pills, a
   1px border rounded 8px, darker when hovered and in the focus color when focused, and the search icon and text
   12px inside */
.mx_AutocompleteInput_search_icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    margin-inline-start: var(--cpd-space-3x);
    color: var(--cpd-color-icon-secondary);
}

.mx_AutocompleteInput_editor {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--cpd-space-1x) var(--cpd-space-2x);
    box-sizing: border-box;
    min-height: var(--tl-control-size);
    overflow-x: hidden;
    overflow-y: auto;
    border: var(--cpd-border-width-1) solid var(--cpd-color-border-interactive-secondary);
    border-radius: var(--tl-radius-row);
    transition: border-color 0.25s;

    &:hover {
        border-color: var(--cpd-color-border-interactive-hovered);
    }

    > input {
        flex: 1;
        min-width: 40%;
        resize: none;
        /* `!important` is required to bypass global input styles. */
        margin: 0 !important;
        padding: calc((var(--tl-control-size) - 2 * var(--cpd-border-width-1) - 1lh) / 2) var(--cpd-space-3x)
            calc((var(--tl-control-size) - 2 * var(--cpd-border-width-1) - 1lh) / 2) 0 !important;
        border: none !important;
        font: var(--cpd-font-body-md-regular) !important;
        color: var(--cpd-color-text-primary) !important;

        &::placeholder {
            color: var(--cpd-color-text-secondary) !important;
            font-weight: normal !important;
        }
    }
}

.mx_AutocompleteInput_editor--focused,
.mx_AutocompleteInput_editor--focused:hover {
    border-color: var(--cpd-color-border-focused);
}

.mx_AutocompleteInput_editor_selection {
    display: flex;
}

.mx_AutocompleteInput_editor_selection_pill {
    display: flex;
    align-items: center;
    border-radius: 12px;
    padding-left: var(--cpd-space-2x);
    padding-right: var(--cpd-space-2x);
    background-color: $username-variant1-color;
    color: #ffffff;
    font: var(--cpd-font-body-sm-regular);
}

.mx_AutocompleteInput_editor_selection_remove_button svg {
    vertical-align: middle;
}

/* A floating menu 4px under the field (its inline top is the field's height inside the border), holding the dense
   list: 32px rows inset 4px, their text 16px in */
.mx_AutocompleteInput_matches {
    position: absolute;
    left: 0;
    right: 0;
    margin-block-start: calc(2 * var(--cpd-border-width-1) + var(--cpd-space-1x));
    padding: calc(var(--tl-inset-menu) - var(--cpd-border-width-1));
    background-color: var(--cpd-color-bg-canvas-default);
    border: var(--cpd-border-width-1) solid var(--cpd-color-border-interactive-secondary);
    border-radius: var(--tl-radius-menu);
    box-shadow: var(--tl-shadow-floating);
    z-index: 1000;
}

.mx_AutocompleteInput_suggestion {
    display: flex;
    align-items: center;
    gap: var(--tl-menu-icon-gap);
    box-sizing: border-box;
    min-height: var(--tl-menu-row-size);
    padding: var(--cpd-space-1x) var(--cpd-space-3x);
    border-radius: var(--tl-radius-row);
    font: var(--cpd-font-body-md-regular);
    cursor: default;

    > * {
        user-select: none;
    }

    &:hover {
        background-color: var(--cpd-color-bg-action-secondary-hovered);
    }
}

/* A person already added takes the pressed fill, as the row chosen with the arrow keys does in other lists */
.mx_AutocompleteInput_suggestion--selected,
.mx_AutocompleteInput_suggestion--selected:hover {
    background-color: var(--cpd-color-bg-action-secondary-pressed);
}

.mx_AutocompleteInput_suggestion_description {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}
