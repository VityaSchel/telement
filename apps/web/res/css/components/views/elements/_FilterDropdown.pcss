.mx_FilterDropdown {
    /* Under the chip's end, with the rows and highlights of the other dropdowns' menus (_Dropdown.pcss) */
    .mx_Dropdown_menu {
        left: unset;
        box-sizing: border-box;
        /* The descriptions don't wrap (_Dropdown.pcss), so the menu fits the longest beside the radio */
        width: 288px;

        /* Less the inset, the content sits 16px from the menu's edge, as in Telement's other menus */
        .mx_Dropdown_option {
            padding-inline: calc(var(--cpd-space-4x) - var(--tl-inset-menu));
        }
    }

    /* A 36px chip, like Compound's plain buttons */
    .mx_Dropdown_input {
        background-color: transparent;
        border-color: transparent;
        color: $secondary-content;
        border-radius: var(--tl-radius-control);

        /* Also while its open menu has the focus, instead of the other dropdowns' focus border (_Dropdown.pcss) */
        &:focus-within,
        &:hover {
            background-color: $quinary-content;
            border-color: $quinary-content;
        }
    }

    .mx_Dropdown_arrow {
        color: $secondary-content;
    }
}

/* Telement: the shared menu rows, with Compound's radio marking the chosen filter 12px before the label, and the
   description in secondary text under it */
.mx_FilterDropdown_option {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--cpd-space-3x);
    align-items: center;
    width: 100%;
    box-sizing: border-box;
    padding-block: var(--cpd-space-2x);
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-primary);
}

.mx_FilterDropdown_optionSelectedIcon {
    grid-row: 1 / span 2;
    align-self: start;
    /* Centered on the label's line */
    margin-block-start: calc((var(--cpd-font-size-body-md) * var(--cpd-font-line-height-regular) - 20px) / 2);
    pointer-events: none;
}

.mx_FilterDropdown_optionLabel,
.mx_FilterDropdown_optionDescription {
    grid-column: 2;
}

.mx_FilterDropdown_optionDescription {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
    /* Puts a two-line row on the 4px grid: 8 + 22.5 + 2 + 19.5 + 8 = 60 */
    margin-block-start: 2px;
}
