.mx_FilterDropdown {
    /* Under the chip's end, with the rows and highlights of the other dropdowns' menus (_Dropdown.pcss) */
    .mx_Dropdown_menu {
        left: unset;
        box-sizing: border-box;
        /* The descriptions don't wrap (_Dropdown.pcss), so they keep the 212px they had beside the check */
        width: 264px;

        border: 1px solid $quinary-content;

        /* Less the inset, the content sits 16px from the menu's edge, as in Telement's other menus */
        .mx_Dropdown_option {
            padding-inline: calc(var(--cpd-space-4x) - var(--tl-inset-menu));
        }
    }

    /* A 36px chip, like Compound's plain buttons */
    .mx_Dropdown_input {
        background-color: transparent;
        border-color: transparent;
        color: $secondary-content;
        border-radius: var(--tl-radius-control);

        /* Also while its open menu has the focus, instead of the other dropdowns' accent border (_Dropdown.pcss) */
        &:focus-within,
        &:hover {
            background-color: $quinary-content;
            border-color: $quinary-content;
        }
    }

    .mx_Dropdown_arrow {
        color: $secondary-content;
    }
}

.mx_FilterDropdown_option {
    position: relative;
    width: 100%;
    box-sizing: border-box;
    padding: var(--cpd-space-2x) 0 var(--cpd-space-2x) var(--cpd-space-5x);

    font-size: $font-12px;
    /* Rows of one or two lines are 40 and 48px, on the grid */
    line-height: $font-16px;
    color: $primary-content;
}

.mx_FilterDropdown_optionSelectedIcon {
    height: 14px;
    width: 14px;
    position: absolute;
    /* Centered on the label's line */
    top: calc(var(--cpd-space-2x) + (1lh - 14px) / 2);
    left: 0;
}

.mx_FilterDropdown_optionLabel {
    font-weight: var(--cpd-font-weight-semibold);
    display: block;
}

.mx_FilterDropdown_optionDescription {
    color: $secondary-content;
    margin-top: var(--cpd-space-1x);
}
