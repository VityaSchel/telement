/* Telement: drawn as the room list's filters (RoomListPrimaryFilters, Compound's ChatFilter) rather than as underlined
   labels: 28px outlined chips 8px apart, the selected one filled, their capitals in the middle of the chip. The radio
   itself has no size, so its focus ring is drawn around the chip */
.mx_FilterTabGroup {
    /* Reset the browser default <fieldset> styling */
    margin-inline: unset;
    padding-block: unset;
    padding-inline: unset;
    min-inline-size: unset;
    border: none;

    display: flex;
    flex-wrap: wrap;
    gap: var(--cpd-space-2x);

    /* A flex row, so that the radio doesn't put a line of its own above the chip */
    label {
        display: flex;
        cursor: pointer;

        span {
            @mixin filterChip;
        }

        @media (hover) {
            &:hover span {
                border-color: var(--cpd-color-border-interactive-primary);
                background-color: var(--cpd-color-bg-subtle-primary);
            }
        }

        &:active span {
            background-color: var(--tl-color-bg-subtle-pressed);
        }
    }

    input[type="radio"] {
        appearance: none;
        margin: 0;
        padding: 0;

        &:focus-visible + span {
            outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
            outline-offset: var(--cpd-border-width-1);
        }
    }

    /* The selected chip takes the primary button's fills, hovered and pressed too */
    label:has(> input:checked) {
        span {
            border-color: var(--cpd-color-bg-action-primary-rest);
            background-color: var(--cpd-color-bg-action-primary-rest);
            color: var(--cpd-color-text-on-solid-primary);
        }

        @media (hover) {
            &:hover span {
                border-color: var(--cpd-color-bg-action-primary-hovered);
                background-color: var(--cpd-color-bg-action-primary-hovered);
            }
        }

        &:active span {
            border-color: var(--cpd-color-bg-action-primary-pressed);
            background-color: var(--cpd-color-bg-action-primary-pressed);
        }
    }
}
