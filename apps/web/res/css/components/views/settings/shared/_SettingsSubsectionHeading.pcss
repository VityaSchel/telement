.mx_SettingsSubsectionHeading {
    @mixin settingsGroupLabel;
    display: flex;
    flex-direction: row;
    align-items: center;

    gap: var(--cpd-space-2x);
}

/* Telement: the group's label (_common.pcss), whatever heading level the subsection's nesting gives it */
.mx_SettingsSubsectionHeading .mx_SettingsSubsectionHeading_heading {
    flex: 1 1 100%;
    font: inherit;
    letter-spacing: inherit;
    color: inherit;
}
