/* Telement: a group of settings as Telegram draws one, its label above its card and its help below it (_common.pcss) */
.mx_SettingsSubsection {
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
}

.mx_SettingsSubsection_description {
    @mixin settingsGroupHelp;
}

/* Telement: without content of its own, such as the FAQ's, the description is what the card holds, in the size of
   text on other cards */
.mx_SettingsSubsection:not(:has(> .mx_SettingsSubsection_content)) > .mx_SettingsSubsection_description {
    @mixin settingsGroupCard;
    font: var(--cpd-font-body-md-regular);
    letter-spacing: var(--cpd-font-letter-spacing-body-md);
    margin: 0;
}

.mx_SettingsSubsection_text {
    width: 100%;
    box-sizing: inherit;
    color: $secondary-content;
}

.mx_SettingsSubsection_content {
    @mixin settingsGroupCard;
    width: 100%;
    display: grid;
    gap: var(--cpd-space-4x);
    /* setting minwidth 0 makes columns definitely sized fixing horizontal overflow */
    grid-template-columns: minmax(0, 1fr);
    justify-items: flex-start;

    summary {
        color: $accent;
    }
    details[open] {
        summary {
            margin-bottom: var(--cpd-space-2x);
        }
    }

    &.mx_SettingsSubsection_contentStretch {
        justify-items: stretch;
    }

    &.mx_SettingsSubsection_content_newUi {
        gap: var(--cpd-space-6x);
    }

    /* Telement: like every other field, a dropdown spans the card (Telegram's rows span the pane), with its hint under
       it spaced as Compound's form fields. The label floats on the dropdown's border (Dropdown's showLabel) */
    .mx_SettingsSubsection_dropdown {
        justify-self: stretch;
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-1x);

        .mx_Dropdown_input {
            box-sizing: border-box;
            width: 100%;
        }
    }

    /* Telement: so does a copy field with a label, such as the room's ID */
    .mx_CopyableText_field {
        justify-self: stretch;

        > .mx_CopyableText {
            box-sizing: border-box;
            width: 100%;
        }
    }
}
