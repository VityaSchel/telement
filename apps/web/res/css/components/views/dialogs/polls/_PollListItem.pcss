.mx_PollListItem {
    width: 100%;
}

.mx_PollListItem_content {
    width: 100%;
    display: grid;
    justify-content: left;
    align-items: center;
    gap: var(--cpd-space-2x);
    grid-template-columns: auto auto auto;
    grid-template-rows: auto;
    cursor: pointer;

    color: $primary-content;
}

/* Telement: an inline status icon on Compound's 16px icon size, in the secondary icon gray rather than a near-invisible
   quaternary one (TELEMENT.md, "Colors, type and components") */
.mx_PollListItem_icon {
    height: 16px;
    width: 16px;
    color: var(--cpd-color-icon-secondary);
    padding-left: var(--cpd-space-2x);
}

.mx_PollListItem_question {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
