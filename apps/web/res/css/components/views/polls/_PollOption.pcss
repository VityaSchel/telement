.mx_PollOption {
    border: 1px solid $quinary-content;
    border-radius: var(--MBody-border-radius);
    /* With the 1px border and the label's 2px top padding below, the label's line starts 13px from the top and the bar
       ends 13px from the bottom, as far as both are from the sides */
    padding: calc(var(--cpd-space-3x) - 2px) var(--cpd-space-3x) var(--cpd-space-3x);
    background-color: $background;
    cursor: default;

    /* The vote count ends where the bar does. The radio button's own end margin comes later in the cascade. */
    .mx_StyledRadioButton > .mx_StyledRadioButton_content,
    .mx_PollOption_endedOption {
        padding-top: 2px;
        margin-inline-end: 0;
    }

    .mx_StyledRadioButton_spacer {
        display: none;
    }

    /* The radio is centered on the label's first line, below the label's 2px top padding, rather than set on its
       baseline */
    .mx_StyledRadioButton {
        align-items: start;
    }

    /* The 20px radio (_StyledRadioButton.pcss) takes only the label's line, so it doesn't make the option taller where
       the line is shorter than the radio */
    input[type="radio"] + div {
        margin-block: calc(2px + (1lh - 20px) / 2) calc((1lh - 20px) / 2);
    }
}

.mx_PollOption_content {
    display: flex;
    justify-content: space-between;
}

.mx_PollOption_optionVoteCount {
    color: $secondary-content;
    font-size: $font-12px;
    white-space: nowrap;
}

.mx_PollOption_winnerIcon {
    height: 12px;
    width: 12px;
    color: var(--cpd-color-icon-accent-tertiary);
    margin-right: var(--cpd-space-1x);
    vertical-align: middle;
}

.mx_PollOption_checked {
    /* override checked radio button styling to show checkmark instead. Your choice keeps the radio's accent fill
       (_StyledRadioButton.pcss), as in Telegram, with the check white on it. */
    .mx_StyledRadioButton_checked {
        input[type="radio"]:checked + div {
            div {
                background: none;

                svg {
                    color: var(--tl-color-on-accent);
                    width: 12px;
                    height: 12px;
                    margin: -2px;
                    display: block;
                }
            }
        }
    }
}

/* An ended poll's radios are disabled, so the winner's check takes the accent back from the disabled gray */
.mx_PollOption_ended.mx_PollOption_checked {
    .mx_StyledRadioButton_checked {
        input[type="radio"]:checked + div {
            border-color: var(--cpd-color-bg-accent-rest);
            background-color: var(--cpd-color-bg-accent-rest);
        }
    }
}

/* options not actionable in these states */
.mx_PollOption_checked,
.mx_PollOption_ended {
    pointer-events: none;
}

.mx_PollOption_popularityBackground {
    width: 100%;
    height: 8px;
    border-radius: 8px;
    background-color: $system;
    margin-top: var(--cpd-space-2x);

    /* Every option's result is a bar in the accent on the gray track, as in Telegram. Nothing white sits on it, so it
       is a line's accent rather than a fill's: the fill's deeper step in dark themes would barely show on dark high
       contrast's track. */
    .mx_PollOption_popularityAmount {
        width: 0%;
        height: 8px;
        border-radius: 8px;
        background-color: var(--cpd-color-icon-accent-primary);
    }
}
