/* The rooms with a notification level of their own (RoomNotificationExceptionsDialog): a list dialog, 640px with the
   dialog's 24px padding (TELEMENT.md, "Colors, type and components"), its rows on the dialog's content edge */
.mx_RoomNotificationExceptionsDialog {
    width: calc(640px - 2 * var(--cpd-space-6x));
}
