/* Matches the emoji picker's width so switching tabs doesn't resize the drawer. */
.mx_TelementComposerDrawer {
    width: 340px;
}

/*
 * The drawer's corners are concentric with the pills at the top of its content, such as the emoji picker's category
 * tabs, and its tabs at the bottom: the pill's radius plus its inset (see ComposerDrawerView). The menu's corners add
 * the menu's border to them.
 */
.mx_ContextualMenu.mx_TelementComposerDrawer_menu {
    /* Ends on the end of the button that opened it (see ComposerDrawerButton) rather than upstream's 16px inside it */
    right: 0;
    border-radius: calc(var(--tl-control-size) / 2 + var(--cpd-space-2x) + var(--cpd-border-width-1))
        calc(var(--tl-control-size) / 2 + var(--cpd-space-2x) + var(--cpd-border-width-1))
        calc(var(--cpd-space-8x) / 2 + var(--cpd-space-2x) + var(--cpd-border-width-1))
        calc(var(--cpd-space-8x) / 2 + var(--cpd-space-2x) + var(--cpd-border-width-1));
}

.mx_TelementComposerDrawer_stickers {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-4x);
}

.mx_TelementComposerDrawer_stickersDescription {
    color: var(--cpd-color-text-secondary);
}
