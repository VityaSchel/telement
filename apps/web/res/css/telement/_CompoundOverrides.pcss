/*
 * Compound values that Compound has no variable for. Its class names are hashed CSS modules, so these match the
 * start of the class attribute, where Compound puts its own class; CompoundOverrides.test.browser.ts fails when an
 * upgrade renames them.
 */

/* Text buttons drop the underline; Compound's Link keeps it */
[class^="_button_"][data-kind="tertiary"] {
    text-decoration: none;
}

/* Half a line plus the vertical padding: a pill on one line, a rounded rectangle once the label wraps */
[class^="_tooltip_"] {
    border-radius: calc(0.5lh + var(--cpd-space-1-5x));
}

/* No arrow, as in Telegram: shifted along a window edge it hangs off the pill's rounded end. Compound still offsets
   the tooltip by the arrow's 6px, which leaves a 6px gap from the anchor. */
[class^="_tooltip_"] > [class^="_arrow_"] {
    display: none;
}

/*
 * Menus of items, separators and titles only get the geometry of the message menu (_IconizedContextMenu.pcss) and the
 * room menus: the item highlights are inset 4px from the menu's edge and rounded by 8, concentric with its 12px
 * corners, and follow each other as 32px rows with 16px icons and regular text, the label 10px after the icon. What an
 * item holds stays 16px from the menu's edge. Separators span the highlights with 2px above and below. Menus with a
 * layout of their own (the user menu, threads, jump to date, the room menus) style themselves. Compound puts its class
 * after the caller's on menus and items.
 */
:is([class^="_menu_"], [class*=" _menu_"])[role="menu"]
    > [role="none"]:not(:has(> :not([role^="menuitem"], [role="separator"], [class*="_menu-title_"]))) {
    gap: 0;
    padding-block: var(--tl-inset-menu);

    --cpd-menu-padding-block-end: var(--tl-inset-menu);
    --cpd-separator-inset: var(--tl-inset-menu);
    --cpd-separator-spacing: var(--tl-menu-separator-spacing);

    > [role^="menuitem"] {
        inline-size: auto;
        min-block-size: var(--tl-menu-row-size);
        margin-inline: var(--tl-inset-menu);
        padding-block: var(--cpd-space-1x);
        padding-inline: var(--cpd-space-3x);
        border-radius: var(--tl-radius-row);
        /* Compound puts the icon, radio or checkbox and what ends the item in the first of the two rows the label
           spans. Made as tall as the label's first line, that row centers them on it, also when the label wraps; the
           rows stay together in the middle of the item */
        grid-template-rows: minmax(calc(var(--cpd-font-size-body-md) * var(--cpd-font-line-height-regular)), auto) auto;
        align-content: center;

        > svg:first-child {
            inline-size: 16px;
            block-size: 16px;
        }

        > [class*="_icon_"] {
            margin-inline-end: var(--tl-menu-icon-gap);
        }

        > span {
            /* Items without an icon put their label in the first row only */
            grid-row: 1 / -1;
            font: var(--cpd-font-body-md-regular);
            /* Compound makes the label of an item without an icon 24px tall, which would put its line above the
               item's center */
            min-block-size: 0;
        }

        /* The chevron shown on hover, cropped to its width like Compound's and as tall as the icons. The crop leaves
           one of its 24 units after the stroke: pulled out by it, the chevron ends 16px from the menu's edge */
        > [class*="_nav-hint_"] {
            inline-size: auto;
            block-size: 16px;
            margin-inline-end: calc(-16px / 24);
        }

        /* An item focused with the keyboard is highlighted as on hover, with the focus ring inside the highlight, so
           that it keeps clear of the menu's edge as far as the highlight does */
        &:focus-visible {
            outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
            outline-offset: calc(-1 * var(--cpd-border-width-2));
        }

        &[data-kind="primary"]:focus-visible {
            background: var(--cpd-color-bg-action-secondary-hovered);
        }

        &[data-kind="critical"]:focus-visible {
            background: var(--cpd-color-bg-critical-subtle);
        }
    }

    /* A title reads like a separator's label: 12px from the menu's top, its text where the items' content starts */
    > [class*="_menu-title_"] {
        margin: 0 var(--tl-inset-menu) var(--tl-menu-separator-spacing);
        padding: var(--cpd-space-2x) var(--cpd-space-3x) calc(var(--cpd-space-2x) - var(--cpd-border-width-1));
    }
}

/* Every Compound menu is a floating surface with the floating shadow, like the app's menus (_common.pcss), and its
   title's line a separator */
:is([class^="_menu_"], [class*=" _menu_"])[role="menu"] {
    @mixin floatingSurface;
    box-shadow: var(--tl-shadow-floating);

    [class*="_menu-title_"] {
        border-block-end-color: var(--cpd-color-separator-primary);
    }
}

/*
 * What Compound's checkbox, radio and toggle draw on their accent fill (the check, the dot, the knob) is white in every
 * theme (telement/tokens.css), as in Telegram; Compound draws it in the page's color, near-black in dark themes.
 */
input + [class^="_ui_"] {
    --cpd-color-icon-on-solid-primary: var(--tl-color-on-accent);
}

/*
 * One field spec for legacy and Compound text fields (TELEMENT.md, "Colors, type and components"; _Field.pcss): 36px
 * with the text 12px inside a 1px border, darker when hovered, in the focus color (the accent) when focused, without
 * Compound's hover shadow or 2px ring.
 */
:is(input, textarea)[class*="_control_"] {
    padding: calc((var(--tl-control-size) - 2 * var(--cpd-border-width-1) - 1lh) / 2) var(--cpd-space-3x);
    border-color: var(--cpd-color-border-interactive-secondary);
    font: var(--cpd-font-body-md-regular);

    &:hover,
    &:active {
        border-color: var(--cpd-color-border-interactive-hovered);
        box-shadow: none;
    }

    &:focus {
        outline: none;
        border-color: var(--cpd-color-border-focused);
    }

    /* Compound's own states, which the border color above would otherwise hide */
    &[data-invalid] {
        border-color: var(--cpd-color-border-critical-primary);
    }

    &:disabled {
        border-color: var(--cpd-color-border-disabled);
    }

    &[readonly] {
        border-color: var(--cpd-color-bg-subtle-secondary);
    }
}

/* Compound's search field is the filled pill of every search field (SearchFieldView), with its focus ring */
[class*="_search_"]:has(> input[type="search"]) {
    border-color: transparent;
    background-color: var(--cpd-color-bg-subtle-secondary);

    &:hover,
    &:active,
    &:focus-within {
        border-color: transparent;
    }

    &:focus-within {
        outline: var(--cpd-border-width-2) solid var(--cpd-color-border-focused);
        outline-offset: calc(-1 * var(--cpd-border-width-2));
    }
}

/* The password field's reveal button, a 28px icon button with a 20px icon, centered in the 36px field */
input[class*="_control_"] + button[class*="_action_"] {
    inset-block: calc((var(--tl-control-size) - var(--cpd-space-7x)) / 2);
    inset-inline-end: calc((var(--tl-control-size) - var(--cpd-space-7x)) / 2);

    > svg {
        inline-size: var(--cpd-space-5x);
        block-size: var(--cpd-space-5x);
    }
}

/* The label floats on the middle of the control's top border, its text where the control's starts */
[class*="_field_"]:has(> label[class*="_label_"]):has(input[class*="_control_"], textarea[class*="_control_"]) {
    position: relative;

    > label[class*="_label_"] {
        position: absolute;
        z-index: 1;
        inset-block-start: calc(var(--cpd-border-width-1) / 2);
        inset-inline-start: calc(var(--cpd-space-3x) - var(--cpd-space-0-5x));
        max-inline-size: calc(100% - 2 * var(--cpd-space-3x));
        padding-inline: var(--cpd-space-0-5x);
        transform: translateY(-50%);
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        font: var(--cpd-font-body-xs-regular);
        color: var(--cpd-color-text-secondary);
        background-color: var(--cpd-color-bg-canvas-default);
    }

    /* The focus color of the border it sits on, a step deeper than the accent in light themes, where the accent is
       under 4.5:1 on white (telement/tokens.css) */
    &:focus-within > label[class*="_label_"] {
        color: var(--cpd-color-border-focused);
    }

    > label[class*="_label_"][data-invalid] {
        color: var(--cpd-color-text-critical-primary);
    }
}

/*
 * Letter avatars are Telegram's: a gradient from its avatar palette with white initials, in both themes, so they stand
 * out on hovered and selected rows as well as on the page. Compound's six colors take the Telegram gradient of the
 * nearest hue (Telegram for macOS's day palette: lime to green, cyan, fuchsia to pink, purple to violet, pink to red,
 * orange). The border Compound draws for high contrast mode would be a solid ring around the gradient.
 */
[class*="_avatar-imageless_"] {
    --cpd-avatar-color: #ffffff;

    background: linear-gradient(var(--tl-avatar-top), var(--tl-avatar-bottom));
    border-color: transparent;

    &[data-color="1"] {
        --tl-avatar-top: #a0de7e;
        --tl-avatar-bottom: #54cb68;
    }

    &[data-color="2"] {
        --tl-avatar-top: #53edd6;
        --tl-avatar-bottom: #28c9b7;
    }

    &[data-color="3"] {
        --tl-avatar-top: #e0a2f3;
        --tl-avatar-bottom: #d669ed;
    }

    &[data-color="4"] {
        --tl-avatar-top: #82b1ff;
        --tl-avatar-bottom: #665fff;
    }

    &[data-color="5"] {
        --tl-avatar-top: #ff885e;
        --tl-avatar-bottom: #ff516a;
    }

    &[data-color="6"] {
        --tl-avatar-top: #ffcd6a;
        --tl-avatar-bottom: #ffa85c;
    }
}

/*
 * Like Telegram, menu items and the right panel's action lists show no chevron when hovered; only a submenu's trigger
 * (aria-haspopup) keeps one.
 */
:where([class^="_item_"], [class*=" _item_"]):not([aria-haspopup]) > [class*="_nav-hint_"] {
    display: none;
}

/*
 * Compound's Button is 48px tall at its default size lg, which callers get whenever they pass no size. Controls are
 * 36px, so lg takes the md geometry: the same padding, height and 20px icon. :where() leaves the app's own rules for a
 * button ahead of this one, as they are ahead of Compound's.
 */
:where([class^="_button_"][data-size="lg"]) {
    padding-block: var(--cpd-space-1x);
    padding-inline: var(--cpd-space-5x);
    min-block-size: var(--tl-control-size);
}

:where([class^="_button_"][data-size="lg"][class*=" _has-icon_"]:not([class*=" _icon-only_"])) {
    padding-inline-start: var(--cpd-space-4x);
}

:where([class^="_button_"][data-size="lg"][class*=" _icon-only_"]) {
    padding-inline: var(--cpd-space-1x);
    block-size: var(--tl-control-size);
    inline-size: var(--tl-control-size);
}

:where([class^="_button_"][data-size="lg"][class*=" _icon-only_"] > svg) {
    inline-size: 20px;
    block-size: 20px;
}
