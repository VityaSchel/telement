/* Rows of a settings card one under another, without the browser's list spacing (ValueRowList) */
.mx_NotificationTargets {
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
}
