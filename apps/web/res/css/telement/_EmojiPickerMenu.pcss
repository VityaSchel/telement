/*
 * A menu holding the emoji picker. Its top corners are concentric with the picker's search field, like the picker's own
 * (see EmojiPicker.module.css), plus the menu's border.
 */
.mx_ContextualMenu.mx_TelementEmojiPickerMenu {
    border-top-left-radius: calc(var(--cpd-space-9x) / 2 + var(--cpd-space-2x) + var(--cpd-border-width-1));
    border-top-right-radius: calc(var(--cpd-space-9x) / 2 + var(--cpd-space-2x) + var(--cpd-border-width-1));
}
