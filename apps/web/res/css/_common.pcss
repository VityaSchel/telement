@import "./_font-sizes.pcss";
@import "./_animations.pcss";

/* Formatted text's quote line, drawn like the reply quote's (_ReplyChain.pcss): on its own, so both ends round, and as
   a border, which forced colors keep. github-markdown-css draws its own line as a left border. */
@define-mixin quoteLine {
    position: relative;
    border-left: none;
    padding: 0 var(--cpd-space-3x);

    &::before {
        content: "";
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        inline-size: 0;
        border-inline-start: 2px solid $blockquote-bar-color;
        border-radius: var(--tl-radius-control);
    }
}

/* A menu, picker, dropdown or dialog: one gray step lighter than the page in dark themes (telement/tokens.css). What it
   holds in the page's colors, such as a menu item at rest or a field's floated label, takes its color, and the hover,
   pressed, subtle and disabled fills and the separators inside it move one step further. Menus and pickers also take
   the floating shadow (--tl-shadow-floating). Dropdowns and dialogs clip to their corners, which would cut it off; a
   dialog has its Glass frame instead. */
@define-mixin floatingSurface {
    background-color: var(--tl-color-bg-floating);

    --cpd-color-bg-canvas-default: var(--tl-color-bg-floating);
    --cpd-color-bg-canvas-disabled: var(--tl-color-bg-floating-disabled);
    --cpd-color-bg-action-secondary-rest: var(--tl-color-bg-floating);
    --cpd-color-bg-action-secondary-hovered: var(--tl-color-bg-floating-hovered);
    --cpd-color-bg-action-secondary-pressed: var(--tl-color-bg-floating-pressed);
    --cpd-color-bg-action-tertiary-rest: var(--tl-color-bg-floating);
    --cpd-color-bg-action-tertiary-hovered: var(--tl-color-bg-floating-subtle-secondary);
    --cpd-color-bg-action-tertiary-selected: var(--tl-color-bg-floating-subtle-primary);
    --cpd-color-bg-subtle-secondary: var(--tl-color-bg-floating-subtle-secondary);
    --cpd-color-bg-subtle-primary: var(--tl-color-bg-floating-subtle-primary);
    --tl-color-bg-subtle-pressed: var(--tl-color-bg-floating-subtle-pressed);
    --cpd-color-separator-primary: var(--tl-color-separator-floating);
}

/* The selected one of a set of choices drawn as cards (a theme, a message layout, an image size) is ringed in the
   accent, as Telegram rings the selected theme. The 2px ring is drawn over the card's own 1px edge and follows its
   corners, so selecting a card doesn't move what it holds. */
@define-mixin selectedChoiceRing {
    outline: 2px solid var(--cpd-color-border-accent-primary);
    outline-offset: -2px;
}

/* Such a card is a button all over: it takes the rows' translucent hover and pressed fills over its own, and the keyboard
   focus is ringed around it, 1px outside it as around other buttons, rather than around its radio alone. The card's own
   outline is the selected choice's, so the ring is a pseudo-element's. */
@define-mixin choiceCard {
    position: relative;

    &:has(input:focus-visible)::after {
        content: "";
        position: absolute;
        inset: -1px;
        border-radius: inherit;
        outline: var(--cpd-border-width-2) solid var(--choice-card-focus-color, var(--cpd-color-border-focused));
        outline-offset: 1px;
        pointer-events: none;
    }

    input:focus-visible + * {
        outline: none;
    }

    @media (hover) {
        &:hover:not(:has(input:disabled)) {
            background-image: linear-gradient(
                var(--cpd-color-bg-action-secondary-hovered),
                var(--cpd-color-bg-action-secondary-hovered)
            );
        }
    }

    &:active:not(:has(input:disabled)) {
        background-image: linear-gradient(
            var(--cpd-color-bg-action-secondary-pressed),
            var(--cpd-color-bg-action-secondary-pressed)
        );
    }
}

/* A small switcher's chip, as the room list's filters are drawn (RoomListPrimaryFilters, Compound's ChatFilter): a 28px
   outlined pill with its capitals in its middle */
@define-mixin filterChip {
    display: block;
    box-sizing: border-box;
    block-size: var(--cpd-space-7x);
    padding: calc((var(--cpd-space-7x) - 2 * var(--cpd-border-width-1) - 1cap) / 2) var(--cpd-space-2x) 0;
    border: var(--cpd-border-width-1) solid var(--cpd-color-border-interactive-secondary);
    border-radius: var(--tl-radius-control);
    font: var(--cpd-font-body-sm-medium);
    line-height: 1cap;
    text-box: trim-both cap alphabetic;
    color: var(--cpd-color-text-primary);
}

/* Settings are grouped as in Telegram's settings: each group's rows sit on a 12px card on the tab's gray pane, under a
   13px secondary label and over 13px secondary help, both on the card's content edge, 16px in. The dialog title is the
   only large heading. A label or help inside a card, such as a fieldset's in a subsection's card, sits on that card's
   content edge instead (--settings-group-inset). */
@define-mixin settingsGroupLabel {
    font: var(--cpd-font-body-sm-regular);
    letter-spacing: var(--cpd-font-letter-spacing-body-sm);
    color: var(--cpd-color-text-secondary);
    margin: 0 0 var(--cpd-space-2x);
    padding: 0 var(--settings-group-inset, var(--cpd-space-4x));
}

@define-mixin settingsGroupCard {
    /* What the card holds in the dialog's own color, such as a field, takes the card's (telement/tokens.css) */
    --cpd-color-bg-canvas-default: var(--tl-color-bg-settings-card);
    --settings-group-inset: 0;
    background-color: var(--tl-color-bg-settings-card);
    border-radius: var(--tl-radius-bubble);
    padding: var(--cpd-space-3x) var(--cpd-space-4x);
    box-sizing: border-box;
    /* Visible in high contrast themes, and in forced colors, which drop the fill */
    outline: 1px solid var(--tl-color-border-settings-card);
    outline-offset: -1px;

    /* A row at the card's top or bottom (ValueRowView, ActionRowView), in a form or not, has its hover fill 4px from
       the card's edge there, as it has at the card's sides and as a menu's rows have, concentric with the 12px corners */
    &:has(> [data-settings-row]:first-child, > form:first-child > [data-settings-row]:first-child) {
        padding-block-start: var(--tl-inset-menu);
    }

    &:has(> [data-settings-row]:last-child, > form:last-child > [data-settings-row]:last-child) {
        padding-block-end: var(--tl-inset-menu);
    }

    /* A field at the card's top, such as the phone number, sits 16px under the card's edge, as far as fields one under
       another are apart (_Field.pcss), so that the label floating on its border is as far inside the card as the card's
       other content. Only as specific as the card, so that a fieldset inside a card keeps no padding */
    &:where(
        :has(
            > :is(.mx_Field, .mx_CopyableText_field):first-child,
            > form:first-child > .mx_Field:first-child,
            > form:first-child > div:first-child > .mx_Field:first-child
        )
    ) {
        padding-block-start: var(--cpd-space-4x);
    }
}

@define-mixin settingsGroupHelp {
    font: var(--cpd-font-body-sm-regular);
    letter-spacing: var(--cpd-font-letter-spacing-body-sm);
    color: var(--cpd-color-text-secondary);
    margin: var(--cpd-space-2x) 0 0;
    padding: 0 var(--settings-group-inset, var(--cpd-space-4x));
}

/* The profile at the top of a settings card (the account's, a room's or a space's), as Telegram's edit pages lay it out:
   the photo at the card's start and the fields beside it, 16px apart, both 16px under the card's edge, as far as the
   photo is from its start. In a narrow dialog the fields wrap under the photo. */
@define-mixin settingsProfile {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--cpd-space-4x);
    margin-block-start: calc(var(--cpd-space-4x) - var(--cpd-space-3x));

    > :last-child {
        flex: 1 1 240px;
        min-inline-size: 0;
    }
}

:root {
    --container-border-width: 8px;
    --container-gap-width: 8px; /* only even numbers should be used because otherwise we get 0.5px margin values. */
    --transition-short: 0.1s;
    --transition-standard: 0.3s;
    --buttons-dialog-gap-column: var(--cpd-space-2x);
    --MBody-border-radius: 8px;
    --EventTileBubble_margin-block: 10px;
    --MessageTimestamp-width: 46px; /* 8 + 30 (avatar) + 8 */
    --MediaPreview-width: 478px; /* keep in sync with PREVIEW_WIDTH_PX in src/utils/UrlPreviewFetcher.ts */

    /* Expected z-indexes for dialogs:
        4000 - Default wrapper index
        4009 - Static dialog background
        4010 - Static dialog itself
        4011 - Standard dialog background
        4012 - Standard dialog itself

       These are set up such that the static dialog always appears
       underneath the standard dialogs.
     */
    --dialog-zIndex-wrapper-default: 4000;
    --dialog-zIndex-static-background: 4009;
    --dialog-zIndex-static: calc(var(--dialog-zIndex-static-background) + 1); /* 4010 */
    --dialog-zIndex-standard-background: calc(var(--dialog-zIndex-static) + 1); /* 4011 */
    --dialog-zIndex-standard: calc(var(--dialog-zIndex-standard-background) + 1); /* 4012 */
}

#matrixchat {
    /* This is required to ensure Compound tooltips correctly draw where they should with z-index: auto */
    contain: strict;
}
#mx_ContextualMenu_Container,
#mx_PersistedElement_container,
#mx_Dialog_Container,
#mx_Dialog_StaticContainer {
    /* This is required to ensure Compound tooltips correctly draw where they should with z-index: auto */
    isolation: isolate;
}

/**
 * We need to increase the specificity of the selector to override the
 * custom property set by the design tokens package
 */
[class^="cpd-theme"][class^="cpd-theme"] {
    /**
     * The design tokens package currently does not expose the fallback fonts
     * We want to keep on re-using `$font-family` to not break custom themes
     * and because we can to use `Twemoji` to display emoji rather than using
     * system ones
     */
    --cpd-font-family-sans: $font-family;
}

@media (prefers-reduced-motion) {
    :root {
        --transition-short: 0;
        --transition-standard: 0;
    }
}

html {
    /* hack to stop overscroll bounce on OSX and iOS.
       N.B. Breaks things when we have legitimate horizontal overscroll */
    height: 100%;
    overflow: hidden;
    /* Stop similar overscroll bounce in Firefox Nightly for macOS */
    overscroll-behavior: none;
}

body {
    /* !important because compound overrides these font settings for body */
    font: var(--cpd-font-body-md-regular) !important;
    letter-spacing: var(--cpd-font-letter-spacing-body-md) !important;
    /**
     * We want to apply Inter Dynamic metrics (https://rsms.me/inter/dynmetrics/)
     * We need to tweak the `letter-spacing` property and doing so, disables by
     * default the optional ligatures
     * `font-feature-settings` allows us to override this behaviour and have the
     * correct ligatures and the proper dynamic metric spacing.
     */
    font-feature-settings:
        "kern" 1,
        "liga" 1,
        "calt" 1 !important;

    background-color: $background;
    color: $primary-content;
    border: 0px;
    margin: 0px;

    /* needed to match the designs correctly on macOS */
    /* see https://github.com/vector-im/element-web/issues/11425 */
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

pre,
code {
    font-family: $monospace-font-family;
    font-size: 100% !important;
    /* Telement: code is drawn as typed, without the body's contextual alternates (telement/tokens.css) */
    font-feature-settings: var(--tl-font-feature-settings-identifier);
}

.error,
.warning,
.text-error,
.text-warning {
    color: $alert;
}

.text-success {
    color: $accent;
}

.text-muted {
    color: $muted-fg-color;
}

.text-primary {
    color: $primary-content;
}

.text-secondary {
    color: $secondary-content;
}

.mx_Verified {
    color: $e2e-verified-color;
}

.mx_Untrusted {
    color: $e2e-warning-color;
}

b {
    /* On Firefox, the default weight for `<b>` is `bolder` which results in no bold */
    /* effect since we only have specific weights of our fonts available. */
    font-weight: bold;
}

/* Keep the legacy link colour without overriding Compound anchors or shared timestamp styling. */
a:where(:not([data-kind]):not(.mx_MessageTimestamp)):hover,
a:where(:not([data-kind]):not(.mx_MessageTimestamp)):link,
a:where(:not([data-kind]):not(.mx_MessageTimestamp)):visited {
    color: $accent-alt;
}

:not(.mx_no_textinput):not(.mx_textinput):not(.mx_Field) > input[type="text"],
:not(.mx_no_textinput):not(.mx_textinput):not(.mx_Field) > input[type="search"] {
    padding: 9px;
    font: var(--cpd-font-body-md-semibold);
    font-weight: var(--cpd-font-weight-semibold);
    min-width: 0;
}

/* dont search UI as not all browsers support it, */
/* we implement it ourselves where needed instead */
input[type="search"]::-webkit-search-decoration,
input[type="search"]::-webkit-search-cancel-button,
input[type="search"]::-webkit-search-results-button,
input[type="search"]::-webkit-search-results-decoration {
    display: none;
}

/* Override Firefox's UA style so we get a consistent look across browsers */
input::placeholder,
textarea::placeholder {
    opacity: initial;
}

input[type="text"],
textarea {
    background-color: transparent;
    color: $primary-content;
}

/* Required by Firefox */
textarea {
    color: $primary-content;
}

input[type="text"]:focus,
textarea:focus {
    outline: none;
    box-shadow: none;
}

/* This is used to hide the standard outline added by browsers for */
/* accessible (focusable) components. Not intended for buttons, but */
/* should be used on things like focusable containers where the outline */
/* is usually not helping anyone. */
*:focus:not(:focus-visible) {
    outline: none;
}

summary {
    cursor: pointer;
}

/* .mx_textinput is a container for a text input */
/* + some other controls like buttons, ... */
/* it has the appearance of a text box so the controls */
/* appear to be part of the input */

.mx_Dialog,
.mx_MatrixChat_wrapper {
    .mx_textinput > input[type="text"],
    .mx_textinput > input[type="search"] {
        border: none;
        flex: 1;
        color: $primary-content;
    }

    :not(.mx_textinput):not(.mx_Field):not(.mx_no_textinput) > input[type="text"],
    :not(.mx_textinput):not(.mx_Field):not(.mx_no_textinput) > input[type="search"],
    .mx_textinput {
        display: block;
        box-sizing: border-box;
        background-color: transparent;
        color: $input-darker-fg-color;
        border-radius: 4px;
        border: 1px solid $secondary-hairline-color;
        /* these things should probably not be defined globally */
        margin: 9px;
    }

    .mx_textinput {
        display: flex;
        align-items: center;
    }

    :not(.mx_textinput):not(.mx_Field):not(.mx_no_textinput) > input[type="text"]::placeholder,
    :not(.mx_textinput):not(.mx_Field):not(.mx_no_textinput) > input[type="search"]::placeholder,
    .mx_textinput input::placeholder {
        color: $input-placeholder;
    }
}

/* Prevent ugly dotted highlight around selected elements in Firefox */
::-moz-focus-inner {
    border: 0;
}

/* These are magic constants which are excluded from tinting, to let themes */
/* (which only have CSS) tell the app what their non-tinted */
/* colourscheme is by inspecting the stylesheet DOM. */
/* They are not used for layout!! */
#mx_theme_accentColor {
    color: $accent;
}

#mx_theme_secondaryAccentColor {
    color: $secondary-accent-color;
}

.mx_Dialog_wrapper {
    position: fixed;
    z-index: var(--dialog-zIndex-wrapper-default);
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;
}

.mx_Dialog_border {
    z-index: var(--dialog-zIndex-standard);
    position: relative;
    width: 100%;
    max-width: fit-content;
    box-sizing: border-box;
    max-height: calc(100% - var(--cpd-space-6x));
    display: flex;
    flex-direction: column;

    .mx_Dialog_lightbox & {
        /* The lightbox isn't so much of a dialog as a fullscreen overlay. We
        don't want the glass border. */
        display: contents;
    }
}

/*
 * Concentric corners (TELEMENT.md, "Radius and spacing"): the body's radius is the close button's radius plus the
 * close button's inset, and Compound's Glass frame adds its padding. Only Modal's frame: CompleteSecurity also puts
 * .mx_Dialog_border on a Glass, around a body with its own radius.
 */
.mx_Dialog_wrapper > .mx_Dialog_border {
    /* .mx_Dialog_cancelButton, from customisedCancelButton's width and padding */
    --dialog-close-button-size: calc(20px + 2 * var(--cpd-space-1x));
    /* .mx_Dialog_title's line in Compound's heading-sm: as tall as the close button, so the two are centered on one
       line, and taller when a larger font needs it. Settings dialogs place their tabs under it (_SettingsDialog.pcss) */
    --dialog-title-line-height: max(
        var(--dialog-close-button-size),
        var(--cpd-font-line-height-tight) * var(--cpd-font-size-heading-sm)
    );

    border-radius: calc(var(--dialog-close-button-size) / 2 + var(--cpd-space-4x) + var(--cpd-space-3x));
    /* Compound's frame in light themes. A dark dialog's body is raised a step (floatingSurface), so its frame is too,
       or the two would be the same gray and the body's edge would disappear */
    background-color: var(--tl-color-bg-floating-frame);
}

.mx_Dialog {
    @mixin floatingSurface;
    /* Telement: the one primary text color for bodies, labels, radios and checkboxes, rather than the legacy gray
       ($light-fg-color), which is no Compound token. Descriptions and help set the one secondary color themselves */
    color: var(--cpd-color-text-primary);
    font-size: $font-15px;
    position: relative;
    /* Telement's dialog anatomy (TELEMENT.md, "Colors, type and components"): everything on a 24px edge, with the
       title's line starting where the close button does, 16px from the top */
    padding: var(--cpd-space-4x) var(--cpd-space-6x) var(--cpd-space-6x);
    box-sizing: border-box;
    overflow-y: auto;
    border-radius: calc(var(--dialog-close-button-size) / 2 + var(--cpd-space-4x));
    /* Always-on scrollbars ignore border-radius and would run over the corners and Glass's frame */
    clip-path: border-box;

    .mx_Dialog_staticWrapper & {
        z-index: var(--dialog-zIndex-static);
        contain: content;
    }

    .mx_Dialog_lightbox & {
        border-radius: 0px;
        background-color: transparent;
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
        pointer-events: none;
        padding: 0;
    }

    /* Styles copied/inspired by GroupLayout, ReplyTile, and EventTile variants. */
    .markdown-body {
        font: var(--cpd-font-body-md-regular) !important;
        letter-spacing: var(--cpd-font-letter-spacing-body-md);
        font-family: inherit !important;
        white-space: normal !important;
        line-height: inherit !important;
        background-color: inherit;
        color: inherit; /* inherit the colour from the dark or light theme by default (but not for code blocks) */

        pre,
        code {
            font-family: $monospace-font-family !important;
            background-color: $codeblock-background-color;
        }

        /* this selector wrongly applies to code blocks too but we will unset it in the next one */
        code {
            white-space: pre-wrap; /* don't collapse spaces in inline code blocks */
        }

        pre {
            /* have to use overlay rather than auto otherwise Linux and Windows */
            /* Chrome gets very confused about vertical spacing: */
            /* https://github.com/vector-im/vector-web/issues/754 */
            overflow-x: overlay;
            overflow-y: visible;

            &::-webkit-scrollbar-corner {
                background: transparent;
            }

            code {
                white-space: pre; /* we want code blocks to be scrollable and not wrap */

                > * {
                    display: inline;
                }
            }
        }

        h1,
        h2,
        h3,
        h4,
        h5,
        h6 {
            font-family: inherit !important;
            color: inherit;
        }

        /* Make h1 and h2 the same size as h3. */
        h1,
        h2 {
            font-size: 1.5em;
            border-bottom: none !important; /* override GFM */
        }

        a {
            color: $accent-alt;
        }

        blockquote {
            @mixin quoteLine;
            color: $secondary-content;
        }
    }
}

/* Telement: a dialog is as wide as its kind (TELEMENT.md, "Colors, type and components"): 400 for alerts and
   confirmations, 480 for forms, 640 for lists, each with the dialog's 24px padding on both sides. A form is the
   default, so that a dialog nobody sized isn't a 752px strip around a line or two */
.mx_Dialog_fixedWidth {
    width: calc(480px - 2 * var(--cpd-space-6x));
    max-width: 100%;
}

/* Telement: alerts and confirmations, so that a sentence or two wraps under the title rather than stretching the
   dialog into a strip around one long line */
:is(.mx_ErrorDialog, .mx_QuestionDialog, .mx_TextInputDialog, .mx_ConfirmUserActionDialog).mx_Dialog_fixedWidth {
    width: calc(400px - 2 * var(--cpd-space-6x));
}

/* Telement: lists, and also developer tools (a QuestionDialog by its class), a widget's own dialog and the screen
   sharing picker, which hold neither a form nor a list but show as much as a list does */
:is(
    .mx_ViewSource,
    .mx_PollHistoryDialog,
    .mx_MessageEditHistoryDialog,
    .mx_ModalWidgetDialog,
    .mx_desktopCapturerSourcePicker
).mx_Dialog_fixedWidth,
.mx_DevtoolsDialog_wrapper .mx_Dialog_fixedWidth.mx_QuestionDialog {
    width: calc(640px - 2 * var(--cpd-space-6x));
}

/* Telement: the search dialog stays as it is */
.mx_SpotlightDialog.mx_Dialog_fixedWidth {
    width: 60vw;
    max-width: 704px;
}

.mx_Dialog_background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: $dialog-backdrop-color;
    z-index: var(--dialog-zIndex-standard-background);

    &.mx_Dialog_staticBackground {
        z-index: var(--dialog-zIndex-static-background);
    }

    .mx_Dialog_wrapperWithStaticUnder & {
        /* Roughly half of what it would normally be - we don't want to black out */
        /* the app, just make it clear that the dialogs are stacked. */
        opacity: 0.4;
    }

    .mx_Dialog_lightbox & {
        opacity: $lightbox-background-bg-opacity;
        background-color: $lightbox-background-bg-color;
        animation-name: mx_Dialog_lightbox_background_keyframes;
        animation-duration: 300ms;
    }
}

.mx_Dialog_titleImage {
    vertical-align: sub;
    width: 25px;
    height: 25px;
    margin-left: -2px;
    margin-right: 4px;
    margin-bottom: 2px;
}

.mx_Dialog_title {
    color: $dialog-title-fg-color;
    display: inline-block;
    width: 100%;
    box-sizing: border-box;
    letter-spacing: var(--cpd-font-letter-spacing-heading-sm);

    &.danger {
        color: $alert;
    }
}

.mx_Dialog_header {
    position: relative;
    padding: 0;
    /* Keep the title 8px clear of the close button, which sits 16px from the end, inside the dialog's 24px padding */
    padding-inline-end: calc(
        var(--dialog-close-button-size) + var(--cpd-space-4x) + var(--cpd-space-2x) - var(--cpd-space-6x)
    );
    margin-bottom: var(--cpd-space-2x);

    /* Compound's heading-sm (20px semibold) over the larger heading BaseDialog asks for */
    > .mx_Dialog_title {
        font: var(--cpd-font-heading-sm-semibold);
        line-height: var(--dialog-title-line-height);
    }

    &.mx_Dialog_headerWithButton > .mx_Dialog_title {
        text-align: center;
    }
}

@define-mixin customisedCancelButton {
    width: 20px;
    height: 20px;
    padding: var(--cpd-space-1x);
    border-radius: 14px;
    background-color: var(--cpd-color-bg-subtle-secondary);

    &:hover {
        background-color: var(--cpd-color-bg-subtle-primary);
    }

    svg {
        width: inherit;
        height: inherit;
        vertical-align: top;
        color: var(--cpd-color-icon-secondary);
    }
}

.mx_Dialog_cancelButton {
    @mixin customisedCancelButton;
    border-radius: var(--tl-radius-control);
    position: absolute;
    top: var(--cpd-space-4x);
    right: var(--cpd-space-4x);
}

.mx_Dialog_content {
    /* 16px under the title, and the footer's 24px above the buttons */
    margin: var(--cpd-space-4x) 0 var(--cpd-space-6x);
    font: var(--cpd-font-body-md-regular);
    color: $primary-content;
    word-wrap: break-word;
}

/* Telement: the shared dialog footer (DialogFooterView), which lays out its own buttons. Its labels are 24px under the
   content, whether or not .mx_Dialog_content, whose bottom margin this one meets, comes first */
.mx_Dialog_buttons {
    margin-top: var(--cpd-space-6x);
}

@define-mixin mx_DialogButton {
    /* align images in buttons (eg spinners) */
    vertical-align: middle;
    border: 0px;
    border-radius: var(--tl-radius-control);
    font: var(--cpd-font-body-md-semibold);
    color: $button-fg-color;
    background-color: var(--cpd-color-bg-action-primary-rest);
    width: auto;
    /* Compound's md button */
    min-block-size: var(--tl-control-size);
    box-sizing: border-box;
    padding: var(--cpd-space-1x) var(--cpd-space-5x);
    cursor: pointer;
    display: inline-block;
    transition-duration: 0.1s;
    transition-property: color, background-color, border-color;

    &:not(:focus-visible) {
        outline: none;
    }
}

/* XXX: Our button styles are a mess; this is opt-in styling for legacy raw <button>s and
 * <input type="submit">s in dialogs. Search `mx_LegacyDialogButton` in the JSX for the elements
 * still relying on it.
 * Keep the `.mx_Dialog`/`.mx_Dialog_buttons` ancestor + `button`/`input[type="submit"]` type
 * selector alongside the marker class: they preserve the specificity of the old selectors, which
 * some per-dialog CSS overrides (e.g. width tweaks) rely on losing to.
 */
.mx_Dialog button.mx_LegacyDialogButton,
.mx_Dialog input.mx_LegacyDialogButton[type="submit"] {
    @mixin mx_DialogButton;
    margin-left: 0px;
    margin-right: var(--buttons-dialog-gap-column);
    margin-bottom: 5px;

    /* flip colours for the secondary ones */
    font-weight: var(--cpd-font-weight-semibold);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    padding-block: calc(var(--cpd-space-1x) - var(--cpd-border-width-1));
    padding-inline: calc(var(--cpd-space-5x) - var(--cpd-border-width-1));
    color: var(--cpd-color-text-primary);
    background-color: transparent;
    font-family: inherit;
}

.mx_Dialog button.mx_LegacyDialogButton:last-child {
    margin-right: 0px;
}

/* Telement: a primary legacy button is filled. Dialog footers are DialogFooterView's text buttons, so no button is filled
   for being in one; .danger/.warning override the colours below via a same-specificity, later-in-source rule */
.mx_Dialog button.mx_LegacyDialogButton.mx_Dialog_primary,
.mx_Dialog input.mx_LegacyDialogButton[type="submit"].mx_Dialog_primary {
    color: var(--cpd-color-text-on-solid-primary);
    background-color: var(--cpd-color-bg-action-primary-rest);
    border-color: var(--cpd-color-bg-action-primary-rest);
}

.mx_Dialog button.mx_LegacyDialogButton.danger,
.mx_Dialog input.mx_LegacyDialogButton[type="submit"].danger {
    background-color: var(--cpd-color-bg-critical-primary);
    border: solid 1px var(--cpd-color-bg-critical-primary);
    color: var(--cpd-color-text-on-solid-primary);
}

.mx_Dialog button.mx_LegacyDialogButton.warning,
.mx_Dialog input.mx_LegacyDialogButton[type="submit"].warning {
    border: solid 1px var(--cpd-color-border-critical-subtle);
    color: var(--cpd-color-text-critical-primary);
    /* An outline, as Compound's red outline button is */
    background-color: transparent;
}

/* Telement: Compound Button's disabled look, as every other button has (_AccessibleButton.pcss), for buttons and submit
   inputs alike: an outline button keeps a gray outline on the subtle fill, and a filled one, red ones included, takes
   the gray fill. Both write their label in the disabled text color */
.mx_Dialog :is(button, input[type="submit"]).mx_LegacyDialogButton:disabled {
    cursor: not-allowed;
    color: var(--cpd-color-text-disabled);
    background-color: var(--cpd-color-bg-subtle-secondary);
    border-color: var(--cpd-color-border-interactive-secondary);
}

.mx_Dialog :is(button, input[type="submit"]).mx_LegacyDialogButton:is(.mx_Dialog_primary, .danger):disabled {
    background-color: var(--cpd-color-bg-subtle-primary);
    border-color: var(--cpd-color-bg-subtle-primary);
}

/* Compound Button's hover and pressed colors: secondary on outline buttons, primary or critical on filled ones */
@media (hover) {
    .mx_Dialog :is(button, input[type="submit"]).mx_LegacyDialogButton:not(:disabled):hover {
        border-color: var(--cpd-color-border-interactive-hovered);
        background-color: var(--cpd-color-bg-subtle-secondary);
    }

    .mx_Dialog :is(button, input[type="submit"]).mx_LegacyDialogButton.mx_Dialog_primary:not(:disabled):hover {
        border-color: var(--cpd-color-bg-action-primary-hovered);
        background-color: var(--cpd-color-bg-action-primary-hovered);
    }

    .mx_Dialog :is(button, input[type="submit"]).mx_LegacyDialogButton.danger:not(:disabled):hover {
        border-color: var(--cpd-color-bg-critical-hovered);
        background-color: var(--cpd-color-bg-critical-hovered);
    }

    .mx_Dialog :is(button, input[type="submit"]).mx_LegacyDialogButton.warning:not(:disabled):hover {
        border-color: var(--cpd-color-border-critical-hovered);
        background-color: var(--cpd-color-bg-critical-subtle);
    }
}

.mx_Dialog :is(button, input[type="submit"]).mx_LegacyDialogButton:not(:disabled):active {
    border-color: var(--cpd-color-border-interactive-hovered);
    background-color: var(--cpd-color-bg-subtle-primary);
}

.mx_Dialog :is(button, input[type="submit"]).mx_LegacyDialogButton.mx_Dialog_primary:not(:disabled):active {
    border-color: var(--cpd-color-bg-action-primary-pressed);
    background-color: var(--cpd-color-bg-action-primary-pressed);
}

.mx_Dialog :is(button, input[type="submit"]).mx_LegacyDialogButton.danger:not(:disabled):active {
    border-color: var(--cpd-color-red-1100);
    background-color: var(--cpd-color-red-1100);
}

.mx_Dialog :is(button, input[type="submit"]).mx_LegacyDialogButton.warning:not(:disabled):active {
    border-color: var(--cpd-color-border-critical-hovered);
    background-color: var(--cpd-color-bg-critical-subtle-hovered);
}

/* Spinner Dialog overide */
.mx_Dialog_wrapper.mx_Dialog_spinner {
    /* This is not a real dialog, so we shouldn't show a glass border */
    .mx_Dialog_border {
        display: contents;
    }

    .mx_Dialog {
        inline-size: auto;
        block-size: auto;
        border-radius: 8px;
        padding: 8px;
        box-shadow: none;

        /* Don't show scroll-bars on spinner dialogs */
        overflow-x: hidden;
        overflow-y: hidden;
    }
}

/* TODO: Review mx_GeneralButton usage to see if it can use a different class */
/* These classes were brought in from the old UserSettings and are included here to avoid */
/* breaking the app. */
/* Ref: https://github.com/vector-im/element-web/issues/8420 */
.mx_GeneralButton {
    @mixin mx_DialogButton;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin: auto;
}

@media (hover) {
    .mx_GeneralButton:hover {
        background-color: var(--cpd-color-bg-action-primary-hovered);
    }
}

.mx_GeneralButton:active {
    background-color: var(--cpd-color-bg-action-primary-pressed);
}

.mx_TextInputDialog_label {
    text-align: left;
    padding-bottom: 12px;
}

.mx_button_row {
    margin-top: 69px;
}

/* username colors */
/* used by SenderProfile & RoomPreviewBar */
.mx_Username_color1 {
    color: $username-variant1-color;
}

.mx_Username_color2 {
    color: $username-variant2-color;
}

.mx_Username_color3 {
    color: $username-variant3-color;
}

.mx_Username_color4 {
    color: $username-variant4-color;
}

.mx_Username_color5 {
    color: $username-variant5-color;
}

.mx_Username_color6 {
    color: $username-variant6-color;
}

.mx_AppWarning,
.mx_AppPermission {
    text-align: center;
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
}

@define-mixin ProgressBarColour $colour {
    color: $colour;
    &::-moz-progress-bar {
        background-color: $colour;
    }
    &::-webkit-progress-value {
        background-color: $colour;
    }
}

@define-mixin ProgressBarBgColour $colour {
    background-color: $colour;
    &::-webkit-progress-bar {
        background-color: $colour;
    }
}

@define-mixin ProgressBarBorderRadius $radius {
    border-radius: $radius;
    &::-moz-progress-bar {
        border-radius: $radius;
    }
    &::-webkit-progress-bar,
    &::-webkit-progress-value {
        border-radius: $radius;
    }
}

@define-mixin unreal-focus {
    outline-width: 2px;
    outline-style: solid;
    outline-color: Highlight;

    /* WebKit gets its native focus styles. */
    @media (-webkit-min-device-pixel-ratio: 0) {
        outline-color: -webkit-focus-ring-color;
        outline-style: auto;
    }
}

@define-mixin LegacyCallButton {
    box-sizing: border-box;
    font-weight: var(--cpd-font-weight-semibold);
    height: $font-24px;
    line-height: $font-24px;
    margin-right: 0;

    display: flex;
    align-items: center;

    svg {
        width: 16px;
        height: 16px;
        display: inline-block;
        color: $button-fg-color;
        margin-right: 8px;
        vertical-align: middle;
    }
}

@define-mixin ThreadRepliesAmount {
    color: $secondary-content;
    font-weight: var(--cpd-font-weight-semibold);
    white-space: nowrap;
    position: relative;
    padding: 0 var(--cpd-space-3x) 0 var(--cpd-space-2x);
}

@define-mixin ThreadSummaryIcon {
    display: inline-block;
    height: 18px;
    width: 18px;
    flex-shrink: 0;
    color: $icon-button-color;
}

@define-mixin composerButton $border-radius, $hover-color, $hover-bg {
    position: relative;
    cursor: pointer;
    border-radius: $border-radius;

    svg {
        color: $icon-button-color;
    }

    &:hover {
        background-color: $hover-bg;

        svg {
            color: $hover-color;
        }
    }

    /* Telement: a step past the hover fill when pressed, as Compound's icon buttons are (_CompoundOverrides.pcss) */
    &:active {
        background-color: var(--tl-color-bg-subtle-pressed);
    }
}

.mx_lineClamp {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: var(--mx-line-clamp, 1);
    overflow: hidden;
}

/* Layout compatibility hook for timestamp placement in existing app/web timeline surfaces. */
.mx_MessageTimestamp {
    display: block;
}

.mx_MessageTimestamp_lateIcon {
    position: absolute;
    inset-block-start: var(--cpd-space-1x);
    inset-inline-end: 100%;
    color: var(--cpd-color-text-secondary);
}
