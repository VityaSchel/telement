exports[`<FilterDropdown /> > renders dropdown options in menu 1`] = `
<ul
  class="mx_Dropdown_menu"
  id="test_listbox"
  role="listbox"
>
  <li
    aria-selected="true"
    class="mx_Dropdown_option mx_Dropdown_option_highlight"
    id="test__one"
    role="option"
    tabindex="-1"
  >
    <div
      class="mx_FilterDropdown_option"
      data-testid="filter-option-one"
    >
      <div
        class="_container mx_FilterDropdown_optionSelectedIcon"
      >
        <input
          aria-hidden="true"
          checked=""
          class="_input"
          tabindex="-1"
          type="radio"
        />
        <div
          class="_ui"
        />
      </div>
      <span
        class="mx_FilterDropdown_optionLabel"
      >
        Option one
      </span>
    </div>
  </li>
  <li
    aria-selected="false"
    class="mx_Dropdown_option"
    id="test__two"
    role="option"
    tabindex="-1"
  >
    <div
      class="mx_FilterDropdown_option"
      data-testid="filter-option-two"
    >
      <div
        class="_container mx_FilterDropdown_optionSelectedIcon"
      >
        <input
          aria-hidden="true"
          class="_input"
          tabindex="-1"
          type="radio"
        />
        <div
          class="_ui"
        />
      </div>
      <span
        class="mx_FilterDropdown_optionLabel"
      >
        Option two
      </span>
      <span
        class="mx_FilterDropdown_optionDescription"
      >
        with description
      </span>
    </div>
  </li>
</ul>
`;

