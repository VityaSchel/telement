exports[`<SidebarUserSettingsTab /> > renders sidebar settings with guest spa url 1`] = `
<div>
  <div
    class="mx_SettingsTab"
  >
    <div
      class="mx_SettingsTab_sections"
    >
      <div
        class="mx_SettingsSection"
      >
        <div
          class="mx_SettingsSection_subSections"
        >
          <form
            class="_root"
          >
            <div
              class="mx_SettingsSubsection"
            >
              <div
                class="mx_SettingsSubsectionHeading"
              >
                <h2
                  class="mx_Heading_h4 mx_SettingsSubsectionHeading_heading"
                >
                  Spaces to show
                </h2>
              </div>
              <div
                class="mx_SettingsSubsection_content"
              >
                <div
                  class="_inline-field mx_SidebarUserSettingsTab_toggle"
                >
                  <div
                    class="_inline-field-control"
                  >
                    <div
                      class="_container"
                    >
                      <input
                        aria-describedby="react-use-id-1"
                        checked=""
                        class="_input"
                        disabled=""
                        id="react-use-id-2"
                        role="switch"
                        type="checkbox"
                      />
                      <div
                        class="_ui"
                      />
                    </div>
                  </div>
                  <div
                    class="_inline-field-body"
                  >
                    <label
                      class="_label"
                      for="react-use-id-2"
                    >
                      <svg
                        class="mx_SidebarUserSettingsTab_icon"
                        fill="currentColor"
                        height="1em"
                        viewBox="0 0 24 24"
                        width="1em"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="m12.971 3.54 7 3.889A2 2 0 0 1 21 9.177V19a2 2 0 0 1-2 2h-4v-9H9v9H5a2 2 0 0 1-2-2V9.177a2 2 0 0 1 1.029-1.748l7-3.89a2 2 0 0 1 1.942 0"
                        />
                      </svg>
                      Home
                    </label>
                    <span
                      class="_message _help-message"
                      id="react-use-id-1"
                    >
                      Home is useful for getting an overview of everything.
                    </span>
                  </div>
                </div>
                <div
                  class="_inline-field mx_SidebarUserSettingsTab_toggle mx_SidebarUserSettingsTab_homeAllRoomsToggle"
                >
                  <div
                    class="_inline-field-control"
                  >
                    <div
                      class="_container"
                    >
                      <input
                        aria-describedby="react-use-id-3"
                        class="_input"
                        data-testid="mx_SidebarUserSettingsTab_homeAllRoomsToggle"
                        id="react-use-id-4"
                        role="switch"
                        type="checkbox"
                      />
                      <div
                        class="_ui"
                      />
                    </div>
                  </div>
                  <div
                    class="_inline-field-body"
                  >
                    <label
                      class="_label"
                      for="react-use-id-4"
                    >
                      Show all rooms
                    </label>
                    <span
                      class="_message _help-message"
                      id="react-use-id-3"
                    >
                      Show all your rooms in Home, even if they're in a space.
                    </span>
                  </div>
                </div>
                <div
                  class="_inline-field mx_SidebarUserSettingsTab_toggle"
                >
                  <div
                    class="_inline-field-control"
                  >
                    <div
                      class="_container"
                    >
                      <input
                        aria-describedby="react-use-id-5"
                        class="_input"
                        id="react-use-id-6"
                        role="switch"
                        type="checkbox"
                      />
                      <div
                        class="_ui"
                      />
                    </div>
                  </div>
                  <div
                    class="_inline-field-body"
                  >
                    <label
                      class="_label"
                      for="react-use-id-6"
                    >
                      Rooms outside of a space
                    </label>
                    <span
                      class="_message _help-message"
                      id="react-use-id-5"
                    >
                      Group all your rooms that aren't part of a space in one place.
                    </span>
                  </div>
                </div>
                <div
                  class="_inline-field mx_SidebarUserSettingsTab_toggle"
                >
                  <div
                    class="_inline-field-control"
                  >
                    <div
                      class="_container"
                    >
                      <input
                        aria-describedby="react-use-id-7"
                        class="_input"
                        id="react-use-id-8"
                        role="switch"
                        type="checkbox"
                      />
                      <div
                        class="_ui"
                      />
                    </div>
                  </div>
                  <div
                    class="_inline-field-body"
                  >
                    <label
                      class="_label"
                      for="react-use-id-8"
                    >
                      <svg
                        class="mx_SidebarUserSettingsTab_icon"
                        fill="currentColor"
                        height="1em"
                        viewBox="0 0 24 24"
                        width="1em"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          d="M6 4h10a2 2 0 0 1 2 2v4.286l3.35-2.871a1 1 0 0 1 1.65.76v7.65a1 1 0 0 1-1.65.76L18 13.715V18a2 2 0 0 1-2 2H6a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4"
                        />
                      </svg>
                      Video rooms and conferences
                    </label>
                    <span
                      class="_message _help-message"
                      id="react-use-id-7"
                    >
                      Group all private video rooms and conferences. In conferences you can invite people outside of matrix.
                    </span>
                  </div>
                </div>
              </div>
              <div
                class="mx_SettingsSubsection_description"
              >
                <div
                  class="mx_SettingsSubsection_text"
                >
                  Spaces are ways to group rooms and people. Alongside the spaces you're in, you can use some pre-built ones too.
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
`;

