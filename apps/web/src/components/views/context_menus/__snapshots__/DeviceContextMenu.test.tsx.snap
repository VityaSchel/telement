            tabindex="0"
          >
            <div
              class="_container mx_IconizedContextMenu_selection"
            >
              <input
                aria-hidden="true"
                class="_input"
                tabindex="-1"
                type="radio"
              />
              <div
                class="_ui"
              />
            </div>
            <span
              class="mx_IconizedContextMenu_label"
            >
              Camera 1
            </span>
          </div>
          <div
            aria-checked="true"
            aria-label="Camera 2"
            class="mx_AccessibleButton mx_IconizedContextMenu_item mx_IconizedContextMenu_active"
            role="menuitemradio"
            tabindex="-1"
          >
            <div
              class="_container mx_IconizedContextMenu_selection"
            >
              <input
                aria-hidden="true"
