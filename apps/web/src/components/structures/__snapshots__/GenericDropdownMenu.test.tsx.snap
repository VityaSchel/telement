// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`GenericDropdownMenu > should check the radio of the selected option 1`] = `
<div
  class="mx_ContextualMenu mx_ContextualMenu_right"
  role="menu"
>
  <div
    aria-checked="true"
    class="mx_AccessibleButton mx_GenericDropdownMenu_Option mx_GenericDropdownMenu_Option--item"
    role="menuitemradio"
    tabindex="0"
  >
    <div
      class="_container mx_GenericDropdownMenu_Option--selection"
    >
      <input
        aria-hidden="true"
        checked=""
        class="_input"
        tabindex="-1"
        type="radio"
      />
      <div
        class="_ui"
      />
    </div>
    <div
      class="mx_GenericDropdownMenu_Option--label"
    >
      <span>
        Selected
      </span>
      <span>
        This item is selected
      </span>
    </div>
  </div>
  <div
    aria-checked="false"
    class="mx_AccessibleButton mx_GenericDropdownMenu_Option mx_GenericDropdownMenu_Option--item"
    role="menuitemradio"
    tabindex="-1"
  >
    <div
      class="_container mx_GenericDropdownMenu_Option--selection"
    >
      <input
        aria-hidden="true"
        class="_input"
        tabindex="-1"
        type="radio"
      />
      <div
        class="_ui"
      />
    </div>
    <div
      class="mx_GenericDropdownMenu_Option--label"
    >
      <span>
        Not selected
      </span>
    </div>
  </div>
</div>
`;
